new file mode 100644
index 00000000..8ea80f1d
--- /dev/null
+++ b/metal/mxmetalbuffer.h
@@ -0,0 +1,59 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef MX_METAL_BUFFER_H
+#define MX_METAL_BUFFER_H
+#include "mxbudget.h"
+#include <limits>
+// Attach the reservation to the actual MTLBuffer lifetime, including command
+// buffer retains. No accounting by pointers, estimates of LUT sizes, or RSS.
+extern "C" bool mx_metal_track_buffer(void* buffer, std::size_t bytes) noexcept;
+namespace mx::metal {
+// Explicit native-test seam: thread-local, inert unless a probe arms it.
+inline thread_local bool (*bufferFaultForTesting)(const char* site) = nullptr;
+inline bool commandFault(const char* site) {
+  return bufferFaultForTesting && bufferFaultForTesting(site);
+}
+inline MTL::CommandBuffer* preparationCommand(MTL::CommandQueue* queue, const char* site) {
+  return commandFault(site) ? nullptr : queue->commandBuffer();
+}
+inline MTL::ComputeCommandEncoder* preparationEncoder(MTL::CommandBuffer* command, const char* site) {
+  return commandFault(site) ? nullptr : command->computeCommandEncoder();
+}
+inline MTL::BlitCommandEncoder* transferEncoder(MTL::CommandBuffer* command, const char* site) {
+  return commandFault(site) ? nullptr : command->blitCommandEncoder();
+}
+inline bool completedPreparation(MTL::CommandBuffer* command, const char* site) {
+  // Drain the real command even when the test requests a failed completion.
+  command->waitUntilCompleted();
+  const bool completed = command->status() == MTL::CommandBufferStatusCompleted;
+  const bool failed = commandFault(site);
+  return completed && !failed;
+}
+class EncoderScope {
+ public:
+  explicit EncoderScope(MTL::ComputeCommandEncoder* encoder) : encoder_(encoder) {}
+  ~EncoderScope() { end(); }
+  EncoderScope(const EncoderScope&) = delete;
+  EncoderScope& operator=(const EncoderScope&) = delete;
+  void end() { if(encoder_){encoder_->endEncoding();encoder_=nullptr;} }
+ private:
+  MTL::ComputeCommandEncoder* encoder_;
+};
+inline MTL::Buffer* newBuffer(MTL::Device* device, NS::UInteger n, MTL::ResourceOptions options, const char* site="buffer") {
+  // Accounting units are requested lengths rounded to 16 KiB. This is not
+  // a measured bound on allocatedSize or physical/driver allocation.
+  if(bufferFaultForTesting && bufferFaultForTesting(site))return nullptr;
+  if(n>std::numeric_limits<size_t>::max()-16383)return nullptr;
+  const size_t charged=(size_t(n)+16383)&~size_t(16383);
+  if(!reserveBytes(charged))return nullptr;
+  auto* b=device->newBuffer(n,options);
+  if(!b){releaseBytes(charged);return nullptr;}
+  if(!mx_metal_track_buffer(b,charged)){b->release();releaseBytes(charged);return nullptr;}
+  return b;
+}
+inline MTL::Buffer* newBuffer(MTL::Device* device, const void* data, NS::UInteger n, MTL::ResourceOptions options) {
+  auto* b=newBuffer(device,n,options);
+  if(b && n)std::memcpy(b->contents(),data,n);
+  return b;
+}
+}
+#endif
