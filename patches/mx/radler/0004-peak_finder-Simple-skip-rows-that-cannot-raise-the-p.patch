         peakMax = std::fabs(value);
       }
-      ++value;
       ++index;
     }
   }
@@ -51,47 +93,30 @@ aocommon::OptionalNumber<float> Simple(const float* image, size_t width,
   } else {
     x = peakIndex % width;
     y = peakIndex / width;
-    return aocommon::OptionalNumber<float>(image[x + y * width]);
+    return aocommon::OptionalNumber<T>(image[x + y * width]);
   }
 }
 
