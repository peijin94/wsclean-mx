+size_t SubMinorLoop::subtractComponentAndFindPeak(
+    size_t x, size_t y, const float* component_values,
+    const std::vector<Image>& twice_convolved_psfs, Image& scratch,
+    float& max_value) {
+  // Below this many pixels per chunk, the thread synchronization costs more
+  // than it saves. Chunks are scheduled dynamically, so that faster cores take
+  // more of them.
+  constexpr size_t kMinChunkSize = 8192;
+  constexpr size_t kChunksPerThread = 4;
+  ImageSet& residual = _subMinorModel.Residual();
+  const size_t n = _subMinorModel.size();
+  const size_t n_threads = schaapcommon::ThreadPool::GetInstance().NThreads();
+  const size_t n_chunks =
+      n_threads == 1 ? 1
+                     : std::clamp<size_t>(n / kMinChunkSize, 1,
+                                          n_threads * kChunksPerThread);
+  // When the integrated image is a copy of one residual image, the peak is
+  // searched per chunk directly in that image, which avoids a serial pass.
+  const size_t copy_index = residual.LinearIntegratedCopyIndex();
+  const bool search_in_chunks = copy_index != residual.Size();
+  const float* rms_factor = _subMinorModel.RmsFactorImage().Empty()
+                                ? nullptr
+                                : _subMinorModel.RmsFactorImage().Data();
+  const auto peak_value = [&](size_t px) {
+    const float* image = residual.Data(copy_index);
+    return rms_factor ? image[px] * rms_factor[px] : image[px];
+  };
+
+  std::vector<ChunkPeak> peaks(n_chunks);
+
+  const auto subtract_chunk = [&](size_t chunk) {
+    const size_t start = n * chunk / n_chunks;
+    const size_t end = n * (chunk + 1) / n_chunks;
+    for (size_t img_index = 0; img_index != residual.Size(); ++img_index) {
+      SubtractPsf(residual.Data(img_index),
+                  twice_convolved_psfs[residual.PsfIndex(img_index)].Data(),
+                  component_values[img_index], _subMinorModel.Positions(),
+                  start, end, x, y, _width, _height);
+    }
+    if (search_in_chunks) {
+      // Same selection as GetMaxComponent(): the first pixel with the largest
+      // (absolute) value. Chunks are merged in order with the same rule.
+      ChunkPeak& peak = peaks[chunk];
+      peak.index = start;
+      peak.value = -std::numeric_limits<float>::infinity();
+      if (chunk == 0) {
+        peak.value = _allowNegativeComponents ? std::fabs(peak_value(start))
+                                              : peak_value(start);
+      }
+      const float* image = residual.Data(copy_index);
+      if (_allowNegativeComponents) {
+        if (rms_factor)
+          FindChunkPeak<true, true>(image, rms_factor, start, end, peak);
+        else
+          FindChunkPeak<true, false>(image, rms_factor, start, end, peak);
+      } else {
+        if (rms_factor)
+          FindChunkPeak<false, true>(image, rms_factor, start, end, peak);
+        else
+          FindChunkPeak<false, false>(image, rms_factor, start, end, peak);
+      }
+    }
+  };
+  if (n_chunks == 1) {
+    subtract_chunk(0);
+  } else {
+    schaapcommon::DynamicFor<size_t> loop;
+    loop.Run(0, n_chunks, subtract_chunk);
+  }
+
+  if (!search_in_chunks) {
+    return _subMinorModel.GetMaxComponent(scratch, max_value,
+                                          _allowNegativeComponents);
+  }
+  size_t max_component = peaks[0].index;
+  float max = peaks[0].value;
+  for (size_t chunk = 1; chunk != n_chunks; ++chunk) {
+    if (peaks[chunk].value > max) {
+      max_component = peaks[chunk].index;
+      max = peaks[chunk].value;
+    }
+  }
+  max_value = peak_value(max_component);
+  return max_component;
+}
