-  float t = precise::divide(2.0f * x, support);
-  return precise::exp(beta * (precise::sqrt(1.0f - t * t) - 1.0f));
+// The same kernel through the precise math namespace: Apple GPUs evaluate the
+// default exp/pow under fast math, so this variant exists to attribute a
+// residual kernel difference to fast math rather than to the accumulation.
+inline float es_kernel_ducc0_precise(float x, float support, float beta, float e0) {
+  const float v = precise::divide(2.0f * x, support);
+  const float tmp = 1.0f - v * v;
+  if (tmp < 0.0f) return 0.0f;
+  return precise::exp(beta * (precise::pow(tmp, e0) - 1.0f));
 }
 
