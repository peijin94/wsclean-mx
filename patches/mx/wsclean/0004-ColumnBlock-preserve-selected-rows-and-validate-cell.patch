index 755352d5..5df98555 100644
--- a/msproviders/columnblock.h
+++ b/msproviders/columnblock.h
@@ -5,6 +5,7 @@
 #include <cstddef>
 
 #include <casacore/casa/Arrays/Array.h>
+#include <casacore/casa/Exceptions/Error.h>
 #include <casacore/ms/MeasurementSets/MeasurementSet.h>
 #include <casacore/tables/Tables/ArrayColumn.h>
 #include <casacore/tables/Tables/RefRows.h>
@@ -26,20 +27,48 @@ template <typename T>
 class ColumnBlock {
  public:
   void Load(const casacore::ArrayColumn<T>& column, size_t first, size_t last) {
+    Reset();
     column.getColumnCells(casacore::RefRows(first, last), cells_, true);
     cell_size_ = cells_.nelements() / (last - first + 1);
     loaded_ = true;
   }
-  void Reset() { loaded_ = false; }
+  /**
+   * Read the requested physical row, trying a bulk read first. An excluded row
+   * can be undefined or have a different shape, making the bulk read fail.
+   * Remember that failure until Reset(), and let errors in requested rows
+   * propagate from the row-wise read.
+   */
+  const T* ReadCell(const casacore::ArrayColumn<T>& column, size_t first, size_t last, size_t row) {
+    if (!loaded_ && !read_rows_) {
+      try {
+        Load(column, first, last);
+      } catch (const casacore::AipsError&) {
+        read_rows_ = true;
+      }
+    }
+    if (read_rows_) {
+      column.get(row, cells_, true);
+      cell_size_ = cells_.nelements();
+      return cells_.data();
+    }
+    return Cell(row - first);
+  }
+  void Reset() {
+    loaded_ = false;
+    read_rows_ = false;
+  }
   bool Loaded() const { return loaded_; }
   const T* Cell(size_t index) const { return cells_.data() + index * cell_size_; }
   size_t CellSize() const { return cell_size_; }
-  casacore::IPosition CellShape() const { return cells_.shape().getFirst(cells_.ndim() - 1); }
+  casacore::IPosition CellShape() const {
+    return read_rows_ ? cells_.shape() : cells_.shape().getFirst(cells_.ndim() - 1);
+  }
 
  private:
   casacore::Array<T> cells_;
   size_t cell_size_ = 0;
   bool loaded_ = false;
+  bool read_rows_ = false;
 };
 
