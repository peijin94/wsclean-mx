+// Process-wide cache of compiled compute pipelines, keyed by
+// "<support>/<kernel>". gridAccumulate is called once per w-plane (dozens of
+// times per inversion) with identical shaders; recompiling the MSL source and
+// creating a pipeline per call costs milliseconds each time. Pipelines are
+// immutable and thread-safe to share; the mutex only guards the map.
+// The grid scratch buffer is cached the same way (same size every plane).
+struct MetalCache {
+  std::mutex mutex;
+  std::map<std::string, id<MTLComputePipelineState>> pipelines;
+  id<MTLBuffer> grid_buffer = nil;
+};
+MetalCache& metalCache() {
+  static MetalCache cache;
+  return cache;
+}
