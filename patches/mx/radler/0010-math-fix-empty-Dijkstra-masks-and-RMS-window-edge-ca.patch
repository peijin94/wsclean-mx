+BOOST_AUTO_TEST_CASE(get_bounding_mask_even_padding_at_edge) {
+  // Padding may end exactly at the image edge. It must not move an origin
+  // at zero to size_t(-1), nor clear any originally selected pixel.
+  for (const auto dimensions : {std::pair<size_t, size_t>{10, 8}, {2, 2}}) {
+    const size_t width = dimensions.first, height = dimensions.second;
+    DijkstraSplitter splitter(width, height);
+    aocommon::UVector<bool> vertical(width * height, false);
+    aocommon::UVector<bool> horizontal(width * height, true);
+    aocommon::UVector<bool> output(width * height, true);
+    for (size_t y = 0; y + 1 < height; ++y)
+      for (size_t x = 0; x + 1 < width; ++x)
+        vertical[y * width + x] = true;
+    size_t x, y, subwidth, subheight;
+    splitter.GetBoundingMask(vertical.data(), 0, width, horizontal.data(),
+                             output.data(), x, y, subwidth, subheight);
+    BOOST_REQUIRE_EQUAL(x, 0u);
+    BOOST_REQUIRE_EQUAL(y, 0u);
+    BOOST_REQUIRE_EQUAL(subwidth, width);
+    BOOST_REQUIRE_EQUAL(subheight, height);
+    for (size_t i = 0; i < output.size(); ++i)
+      BOOST_CHECK_EQUAL(output[i], vertical[i]);
+  }
+}
+
+BOOST_AUTO_TEST_CASE(get_bounding_mask_random_intersections) {
+  std::mt19937 random(41);
+  for (size_t trial = 0; trial != 500; ++trial) {
+    const size_t width = 1 + random() % 17, height = 1 + random() % 13;
+    const size_t left = random() % (width + 1);
+    const size_t strip = random() % (width - left + 1);
+    aocommon::UVector<bool> vertical(strip * height);
+    aocommon::UVector<bool> horizontal(width * height);
+    aocommon::UVector<bool> expected(width * height, false);
+    aocommon::UVector<bool> output(width * height, true);
+    for (size_t i = 0; i < vertical.size(); ++i)
+      vertical[i] = random() % 3 == 0;
+    for (size_t i = 0; i < horizontal.size(); ++i)
+      horizontal[i] = random() % 2 == 0;
+    size_t selected = 0;
+    for (size_t y = 0; y < height; ++y)
+      for (size_t x = 0; x < strip; ++x) {
+        const size_t i = y * width + left + x;
+        expected[i] = vertical[y * strip + x] && horizontal[i];
+        if (expected[i]) ++selected;
+      }
+    size_t x, y, subwidth, subheight;
+    DijkstraSplitter(width, height).GetBoundingMask(
+        vertical.data(), left, strip, horizontal.data(), output.data(), x, y,
+        subwidth, subheight);
+    BOOST_REQUIRE_LE(x, width);
+    BOOST_REQUIRE_LE(y, height);
+    BOOST_REQUIRE_LE(subwidth, width - x);
+    BOOST_REQUIRE_LE(subheight, height - y);
+    if (selected == 0) {
+      BOOST_CHECK_EQUAL(subwidth, 0u);
+      BOOST_CHECK_EQUAL(subheight, 0u);
+    } else {
+      if (width % 2 == 0) BOOST_CHECK_EQUAL(subwidth % 2, 0u);
+      if (height % 2 == 0) BOOST_CHECK_EQUAL(subheight % 2, 0u);
+      size_t found = 0;
+      for (size_t yy = y; yy < y + subheight; ++yy)
+        for (size_t xx = x; xx < x + subwidth; ++xx) {
+          const size_t i = yy * width + xx;
+          BOOST_CHECK_EQUAL(output[i], expected[i]);
+          if (output[i]) ++found;
+        }
+      BOOST_CHECK_EQUAL(found, selected);
+    }
+  }
+}
+
+BOOST_AUTO_TEST_CASE(get_bounding_mask_empty) {
+  const size_t width = 10, height = 8;
+  DijkstraSplitter splitter(width, height);
+  aocommon::UVector<bool> vertical(width * height, false);
+  aocommon::UVector<bool> horizontal(width * height, true);
+  aocommon::UVector<bool> output(width * height, true);
+  size_t x, y, subwidth, subheight;
+  // A zero-width strip has no intersection and must not touch the output.
+  splitter.GetBoundingMask(vertical.data(), 0, 0, horizontal.data(),
+                           output.data(), x, y, subwidth, subheight);
+  BOOST_CHECK_EQUAL(subwidth, 0u);
+  BOOST_CHECK_EQUAL(subheight, 0u);
+  BOOST_CHECK_LE(x, width);
+  BOOST_CHECK_LE(y, height);
+  for (bool value : output) BOOST_CHECK(value);
+  splitter.GetBoundingMask(vertical.data(), 0, width, horizontal.data(),
+                           output.data(), x, y, subwidth, subheight);
+  BOOST_CHECK_EQUAL(subwidth, 0u);
+  BOOST_CHECK_EQUAL(subheight, 0u);
+  BOOST_CHECK_LE(x, width);
+  BOOST_CHECK_LE(y, height);
+  for (bool value : output) BOOST_CHECK(!value);
+  DijkstraSplitter empty(0, 0);
+  empty.GetBoundingMask(nullptr, 0, 0, nullptr, nullptr, x, y, subwidth,
+                        subheight);
+  BOOST_CHECK_EQUAL(subwidth, 0u);
+  BOOST_CHECK_EQUAL(subheight, 0u);
+}
