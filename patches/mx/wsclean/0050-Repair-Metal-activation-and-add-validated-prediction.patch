+    pending[s]=std::async(std::launch::async,[this,s]{
+      vfmav<std::complex<float>> v(planes[s].data(),{nu,nv});
+      c2c(v,v,{0,1},FORWARD,1.f,2);
+    });
+    return true;
+  }
+  bool wait(size_t s,size_t pl) noexcept override {
+    if(pl!=next_wait++) std::abort(); // Increasing consumption is required.
+    ++waits;
+    if(pending[s].valid()) {pending[s].get(); --outstanding;}
+    if(mode==2 && pl==2) {std::fill(planes[s].begin(),planes[s].end(),std::complex<float>(-91,27)); failed[s]=true; ++failures;}
+    return !failed[s];
+  }
+};
+bool active=false;
+#endif
+
+bool stride_gate() {
+  constexpr size_t n=512;
+  auto padded=vmav<std::complex<float>,2>::build_noncritical({n,n});
+  vmav<std::complex<float>,2> expected({n,n});
+  for(size_t i=0;i<n;++i) for(size_t j=0;j<n;++j)
+    padded(i,j)=expected(i,j)={float(std::sin(i*.13+j*.27)),float(std::cos(i*.19-j*.11))};
+  vfmav<std::complex<float>> e(expected);c2c(e,e,{0,1},FORWARD,1.f,2);
+  // A compact external vmav is the replacement contract, independent of the
+  // padded CPU allocator. Populate it directly, without a grid copy.
+  std::vector<std::complex<float>> storage(n*n);
+  vmav<std::complex<float>,2> shared(storage.data(),{n,n});
+  for(size_t i=0;i<n;++i) for(size_t j=0;j<n;++j)
+    shared(i,j)={float(std::sin(i*.13+j*.27)),float(std::cos(i*.19-j*.11))};
+  vfmav<std::complex<float>> g(shared);c2c(g,g,{0,1},FORWARD,1.f,2);
+  double err=0,den=0;
+  for(size_t i=0;i<n;++i) for(size_t j=0;j<n;++j) {err+=std::norm(shared(i,j)-expected(i,j));den+=std::norm(expected(i,j));}
+  double rel=std::sqrt(err/den);
+  std::printf("external-plane stride gate: legacy_stride=%td shared_stride=%td rel_rms=%.9g\n",padded.stride(0),shared.stride(0),rel);
+  return padded.stride(0)!=ptrdiff_t(n) && shared.stride(0)==ptrdiff_t(n) && rel<=rel_limit;
+}
+
+template<typename T> std::vector<std::complex<T>> predict(size_t nx,size_t ny,size_t threads,bool shifted,bool wgrid) {
+  constexpr size_t nr=81;
+  vmav<double,2> uvw({nr,3});
+  vmav<size_t,1> ids({nr}),nf({2});nf(0)=2;nf(1)=3;
+  vmav<double,1> freq({5});
+  for(size_t c=0;c<5;++c)freq(c)=1.1e8+1.7e7*c;
+  size_t nvis=0;
+  for(size_t r=0;r<nr;++r) {
+    ids(r)=r%2;nvis+=nf(ids(r));
+    uvw(r,0)=170*std::sin(.31*r);uvw(r,1)=130*std::cos(.27*r);
+    uvw(r,2)=(r%2?-1:1)*(50.+35.*r); // Both signs, multiple w planes.
+  }
+  vmav<T,2> dirty({nx,ny});
+  mav_apply([](T& x){x=0;},1,dirty);
+  dirty(nx/2,ny/2)=1;dirty(nx/3,ny/4)=T(.27);dirty(3*nx/4,2*ny/3)=T(-.19);
+  for(size_t i=0;i<nx;++i)for(size_t j=0;j<ny;++j)
+    dirty(i,j)+=T(.003*std::sin(i*.17+j*.11)*std::exp(-std::pow((double(i)-nx*.4)/19,2)-std::pow((double(j)-ny*.6)/17,2)));
+  vmav<T,1> weights({nvis});vmav<uint8_t,1> mask({nvis});
+  for(size_t k=0;k<nvis;++k){weights(k)=T(.7+.02*(k%19));mask(k)=k%17?1:0;}
+  std::vector<std::complex<T>> result(nvis,std::complex<T>(71,-13));
+  vmav<std::complex<T>,1> out(result.data(),{nvis});
+  const double pixel_x=.0008*std::min(1.0,252.0/nx), pixel_y=.0011*std::min(1.0,252.0/ny);
+  dirty2ms_bda<T,T,T,T>(uvw,ids,nf,freq,dirty,weights,mask,pixel_x,pixel_y,1e-5,wgrid,threads,out,0,
+    false,false,false,true,2.,2.,shifted?.013:0.,shifted?-.009:0.,true);
+  return result;
+}
+
+#if defined(PREDICTION_REAL_GPU)
+void enable(bool on) {if(on) unsetenv("MX_METAL_NO_PREDICT");else setenv("MX_METAL_NO_PREDICT","1",1);}
+#elif defined(PREDICTION_CPU_ONLY)
+void enable(bool) {}
+#else
+void enable(bool on) {active=on;}
+#endif
+
+template<typename T> bool differential(size_t nx,size_t ny,size_t threads,bool shifted,bool wgrid,int failure_mode) {
+  enable(false);auto ref=predict<T>(nx,ny,threads,shifted,wgrid);
+#if !defined(PREDICTION_REAL_GPU) && !defined(PREDICTION_CPU_ONLY)
+  mode=failure_mode;size_t before=submits, failbefore=failures;
+#endif
+  enable(true);auto got=predict<T>(nx,ny,threads,shifted,wgrid);
+  double err=0,den=0,maxerr=0,peak=0;
+  for(size_t i=0;i<got.size();++i){err+=std::norm(got[i]-ref[i]);den+=std::norm(ref[i]);maxerr=std::max(maxerr,double(std::abs(got[i]-ref[i])));peak=std::max(peak,double(std::abs(ref[i])));}
+  double rel=std::sqrt(err/den), mp=maxerr/peak;
+  bool ok=std::isfinite(rel)&&rel<=rel_limit&&mp<=peak_limit;
+#if !defined(PREDICTION_REAL_GPU) && !defined(PREDICTION_CPU_ONLY)
+  bool supported=std::is_same<T,float>::value&&wgrid&&mode!=3;
+  ok &= supported ? submits>before : submits==before;
+  if(supported&&(mode==1||mode==2)) ok &= failures>failbefore;
+#endif
+  std::printf("%s %zux%zu threads=%zu shift=%d wgrid=%d mode=%d rel_rms=%.9g max/peak=%.9g %s\n",
+    std::is_same<T,float>::value?"float":"double",nx,ny,threads,shifted,wgrid,failure_mode,rel,mp,ok?"PASS":"FAIL");
+  return ok;
+}
+}
+#if !defined(PREDICTION_REAL_GPU) && !defined(PREDICTION_CPU_ONLY)
+extern "C" detail_gridder::PredictionSession* mx_prediction_create(size_t nu,size_t nv,bool is_float) noexcept {
+  if(!active||!is_float||mode==3)return nullptr;
+  return new Mock(nu,nv);
+}
+#endif
+int main(int argc, char** argv) {
+  setvbuf(stdout,nullptr,_IONBF,0);
+  std::printf("Predeclared gates: rel_rms <= %.9g, max/peak <= %.9g\n",rel_limit,peak_limit);
+#if defined(PREDICTION_REAL_GPU)
+  if(mx_prediction_create(64,96,true)) return 2; // Registration is required.
+  mx_predict_register();
+  if(mx_prediction_create(8193,64,true) || mx_prediction_create(64,96,false))return 2;
+  std::unique_ptr<detail_gridder::PredictionSession> preflight(mx_prediction_create(64,96,true));
+  bool gpu_available=bool(preflight);
+  if(!gpu_available)std::fprintf(stderr,"GPU preflight unavailable; running production CPU fallback checks only\n");
+  preflight.reset();
+#endif
+  if(argc>1) {
+    const size_t nx=std::stoul(argv[1]), ny=argc>2?std::stoul(argv[2]):nx;
+    const bool large_ok=differential<float>(nx,ny,8,true,true,0);
+#if defined(PREDICTION_REAL_GPU)
+    if(!gpu_available && large_ok)return 77;
+#endif
+    return large_ok?0:1;
+  }
+  bool ok=stride_gate();
+  for(size_t threads:{size_t(1),size_t(3),size_t(6)})
+    for(bool shifted:{false,true}) {
+      ok &= differential<float>(252,252,threads,shifted,true,0);
+      ok &= differential<float>(192,252,threads,shifted,true,0);
+    }
+  ok &= differential<double>(128,96,3,true,true,0);
+  ok &= differential<float>(128,96,3,true,false,0);
+#if !defined(PREDICTION_REAL_GPU) && !defined(PREDICTION_CPU_ONLY)
+  for(int m:{1,2,3})ok &= differential<float>(192,128,3,true,true,m);
+  std::printf("mock proof sessions=%zu submits=%zu waits=%zu failures=%zu live=%zu max_sessions=%zu\n",sessions,submits,waits,failures,live,maxlive);
+  ok &= live==0 && maxlive==1 && submits==waits && saw_padded_shape && max_outstanding==2 && outstanding==0;
+  // Cancellation/unwinding must safely drain two submitted planes without
+  // consuming either. Mock destructors wait before freeing shared storage.
+  mode=0;
+  { Mock abandoned(64,96); abandoned.submit(0,0); abandoned.submit(1,1); }
+  ok &= live==0 && outstanding==0;
+  std::printf("in-flight cleanup live=%zu outstanding=%zu max_unconsumed=%zu padded_prediction_shape=%d %s\n",live,outstanding,max_outstanding,saw_padded_shape,ok?"PASS":"FAIL");
+#endif
+#if defined(PREDICTION_REAL_GPU)
+  if(!gpu_available && ok) {
+    std::fprintf(stderr,"Production fallback PASS; GPU numerical validation SKIPPED (no device), exit 77\n");
+    return 77;
+  }
+#endif
+  return ok?0:1;
+}
