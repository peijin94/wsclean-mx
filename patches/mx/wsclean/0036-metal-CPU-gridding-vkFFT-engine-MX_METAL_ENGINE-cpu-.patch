+// Numerical gate for the vkFFT wrapper: the GPU inverse transform must match
+// ducc0's c2c(BACKWARD) on the same data, unnormalised, to float32 rounding.
+//
+//   ./mx-vkfft-probe           1024^2
+//   ./mx-vkfft-probe 3968      4k path grid size
+#include <algorithm>
+#include <cmath>
+#include <complex>
+#include <cstdio>
+#include <cstdlib>
+#include <random>
+#include <vector>
+
+#include "ducc0/fft/fft.h"
+#include "ducc0/fft/fftnd_impl.h"
+#include "ducc0/infra/mav.h"
+
+#include "metal/mxvkfft.h"
+
+int main(int argc, char** argv) {
+  const std::size_t n = argc > 1 ? std::stoul(argv[1]) : 1024;
+  const int nthreads = argc > 2 ? std::stoi(argv[2]) : 8;
+
+  mx::vk::Fft fft;
+  if (!fft.init(n)) {
+    std::printf("vkfft init failed: %s\n", fft.error());
+    return 1;
+  }
+
+  // Same data on both sides: fill the shared MTLBuffer, copy it for the CPU.
+  float* gpu = fft.data();
+  std::vector<std::complex<float>> host(n * n), host_fft;
+  std::mt19937 rng(7);
+  for (auto& v : host) {
+    v = {static_cast<float>(rng() % 1000) / 1000.0f - 0.5f,
+         static_cast<float>(rng() % 1000) / 1000.0f - 0.5f};
+  }
+  std::memcpy(gpu, host.data(), 2 * n * n * sizeof(float));
+  host_fft = host;
+
+  // CPU reference: exactly what bandedFFT does, without band limiting.
+  {
+    ducc0::vfmav<std::complex<float>> inout(host_fft.data(), {n, n});
+    ducc0::detail_fft::c2c(inout, inout, {0}, false, 1.0f, nthreads);
+    ducc0::detail_fft::c2c(inout, inout, {1}, false, 1.0f, nthreads);
+  }
+
+  if (!fft.submit() || !fft.wait()) {
+    std::printf("vkfft transform failed: %s\n", fft.error());
+    return 1;
+  }
+  gpu = fft.data();
+
+  double num = 0.0, den = 0.0, maxabs = 0.0, maxdiff = 0.0;
+  for (std::size_t i = 0; i < n * n; ++i) {
+    const std::complex<float> a(gpu[2 * i], gpu[2 * i + 1]);
+    const std::complex<float> b = host_fft[i];
+    num += std::norm(a - b);
+    den += std::norm(b);
+    maxabs = std::max<double>(maxabs, std::abs(b));
+    maxdiff = std::max<double>(maxdiff, std::abs(a - b));
+  }
+  const double rel = std::sqrt(num / (den + 1e-30));
+  std::printf("n=%zu threads=%d rel_rms=%.3e max_abs=%.4g max_diff=%.4g %s\n", n, nthreads, rel,
+              maxabs, maxdiff, rel < 5e-6 ? "PASS" : "FAIL");
+  return rel < 5e-6 ? 0 : 1;
+}
