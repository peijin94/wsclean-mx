+      const int channels = num_channels(spw);
+      const int correlations = num_correlations(polarization);
+      if (channels <= 0 || correlations <= 0)
+        throw std::runtime_error("Selected DATA_DESC_ID must have positive NUM_CHAN and NUM_CORR");
+      const casacore::IPosition expected_shape(2, correlations, channels);
+      if (!data_column.isDefined(row_index) ||
