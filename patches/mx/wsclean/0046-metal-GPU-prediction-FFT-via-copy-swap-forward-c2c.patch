diff --git a/metal/mxpredict.cpp b/metal/mxpredict.cpp
new file mode 100644
index 00000000..fef4891d
--- /dev/null
+++ b/metal/mxpredict.cpp
@@ -0,0 +1,41 @@
+// GPU prediction FFT: synchronous copy-swap around the proven forward c2c.
+#include "metal/mxpredict.h"
+
+#include <complex>
+#include <cstddef>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+
+#include "ducc0/wgridder/wgridder_impl.h"
+
+#include "metal/mxvkfft.h"
+
+extern "C" void mx_predict_register() {
+  ducc0::detail_gridder::SetPredictFftHook(&mx_predict_fft);
+}
+
+extern "C" int mx_predict_fft(std::complex<float>* grid, std::size_t n) {
+  if (std::getenv("MX_METAL_NO_PREDICT") != nullptr) return 0;
+  if (grid == nullptr || n == 0 || n > 8192) return 0;
+
+  thread_local std::unique_ptr<mx::vk::Fft> plan;
+  thread_local std::size_t planned_n = 0;
+  if (plan == nullptr || planned_n != n) {
+    plan = std::make_unique<mx::vk::Fft>();
+    if (!plan->init(n)) {
+      plan.reset();
+      planned_n = 0;
+      return 0;
+    }
+    planned_n = n;
+  }
+  mx::vk::Fft& fft = *plan;
+  float* buf = fft.data();
+  if (buf == nullptr) return 0;
+  const std::size_t bytes = 2 * n * n * sizeof(float);
+  std::memcpy(buf, grid, bytes);
+  if (!fft.submitForward() || !fft.wait()) return 0;
+  std::memcpy(grid, buf, bytes);
+  return 1;
+}
diff --git a/metal/mxpredict.h b/metal/mxpredict.h
new file mode 100644
index 00000000..0e1b667b
--- /dev/null
+++ b/metal/mxpredict.h
@@ -0,0 +1,26 @@
+// GPU forward FFT for prediction (dirty2grid): copy-swap wrapper.
+//
+// ducc0's dirty2grid_c_wscreen owns its grid (vmav, not shared), so this
+// hook copies the n x n complex plane into the shared vkFFT buffer, runs
+// the proven forward c2c (5.9e-07 at 3072), and copies back. Two copies of
+// ~75 MB per plane at 3k is the cost this design pays; the pipelined
+// shared-buffer version (chunked plane loop) is the follow-up if this ties.
+#ifndef MX_MXPREDICT_H
+#define MX_MXPREDICT_H
+
+#include <complex>
+#include <cstddef>
+
+extern "C" {
+
+// In-place forward FFT on the square n x n complex grid. Returns 1 when
+// the GPU path ran, 0 to fall back to ducc0's band-limited bands.
+int mx_predict_fft(std::complex<float>* grid, std::size_t n);
+
+// Registers mx_predict_fft with ducc0's dirty2grid hook. Called once at
+// startup when -mgpu is given; keeps ducc0 includes out of main.cpp.
+void mx_predict_register();
+
+}  // extern "C"
+
+#endif  // MX_MXPREDICT_H
