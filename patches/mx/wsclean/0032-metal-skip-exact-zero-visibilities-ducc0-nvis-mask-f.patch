+  // ducc0 counts only visibilities with norm(ms)*wgt*mask != 0 (its nvis):
+  // flagged and zero-weight visibilities are excluded from the cost model
+  // AND from gridding. Our ms arrives weighted, so exact zeros are exactly
+  // ducc0's excluded set. Using all rows*channels (incl. ~37% zeros on LWA)
+  // biases kernel selection and grids 1.6x dead taps.
+  std::size_t nvis_nonzero = 0;
+  {
+    const std::complex<float>* msp = input.ms;
+    const std::size_t n = input.n_rows * input.n_channels;
+    for (std::size_t k = 0; k < n; ++k) {
+      const std::complex<float>& v = msp[k];
+      if (v.real() != 0.0f || v.imag() != 0.0f) ++nvis_nonzero;
+    }
+  }
+  const std::size_t index = chooseKernel(candidates, image_size, nvis_nonzero, input.n_threads,
                                          w_gridding, nm1min, nm1max, w_range, ofactor, out.nu);
   out.kernel = ducc0::selectKernel(index);
   if (!out.kernel) return false;
