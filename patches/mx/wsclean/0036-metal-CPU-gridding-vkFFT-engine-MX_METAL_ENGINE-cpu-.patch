+
+	uint64_t used_registers = 1;
+	switch (strideType) {
+	case 0: case 5: case 6: case 110: case 120: case 130: case 140: case 142: case 144:
+		used_registers = (uint64_t)ceil(sc->fftDim / (double)sc->localSize[0]);
