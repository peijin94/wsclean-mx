+					}
+					if (raderContainer[i].registers_per_thread_per_radix[j] > raderContainer[i].registers_per_thread) {
+						raderContainer[i].registers_per_thread = raderContainer[i].registers_per_thread_per_radix[j];
+					}
+				}
+			}
+		}
+	}
