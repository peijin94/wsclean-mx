       if (wsclean.GetSettings().useGpu) {
         radler::algorithms::SetPeakScanHook(&mx_peak_find);
-        // Multiscale convolution's c2r (26-49% of deconvolution): Hermitian
-        // expansion + vkFFT c2c, falls back to ducc0 per call on failure.
-        schaapcommon::math::SetConvolveC2RHook(&mx_convolve_c2r);
+        // Multiscale convolution c2r: measured overhead per scale at 3k
+        // (GPU 12ms + expansion vs CPU 7ms; batched 13-24ms/plane -- worse),
+        // so opt-in only (MX_METAL_CONVOLVE=1) pending true-C2R batching.
+        // The hook code stays as validated infrastructure.
+        if (std::getenv("MX_METAL_CONVOLVE") != nullptr) {
+          schaapcommon::math::SetConvolveC2RHook(&mx_convolve_c2r);
+        }
         // Prediction forward FFT: full GPU transform instead of ducc0's
         // band-limited bands, copy-swap per plane with CPU fallback.
         mx_predict_register();
