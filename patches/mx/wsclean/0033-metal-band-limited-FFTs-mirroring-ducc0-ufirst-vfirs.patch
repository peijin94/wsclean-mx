-// Roll the centred Metal grid to ducc0's DC-at-0 frame.
+// Merge an occupancy bitset into maximal contiguous [begin,end) ranges.
+std::vector<std::pair<std::size_t, std::size_t>> mergeRanges(
+    const std::vector<unsigned char>& occ) {
+  std::vector<std::pair<std::size_t, std::size_t>> ranges;
+  for (std::size_t i = 0; i < occ.size();) {
+    if (!occ[i]) {
+      ++i;
+      continue;
+    }
+    std::size_t j = i + 1;
+    while (j < occ.size() && occ[j]) ++j;
+    ranges.emplace_back(i, j);
+    i = j;
+  }
+  return ranges;
+}
+
+// Band-limited 2-D FFT mirroring ducc0's grid2dirty_c_overwrite_wscreen_add:
+// FFT axis 0 over occupied-column ranges (or axis 1 over occupied-row
+// ranges), then the other axis over the dirty rows/cols only. Skipped lines
+// are zeros (grid zero-filled, taps only in occupied lines), so this is
+// bit-exact vs the full FFT. ducc0's ufirst/vfirst cost model picks the
+// cheaper order per plane. Our grid is centered (no roll): dirty rows/cols
+// are [0,half)+[grid-half,grid), which is exactly what extract reads.
+void bandedFFT(std::complex<float>* G, std::size_t grid, std::size_t W2, std::size_t H2,
+               const std::vector<unsigned char>& occ_rows,
+               const std::vector<unsigned char>& occ_cols, std::size_t nthreads) {
+  const auto rows = mergeRanges(occ_rows);
+  const auto cols = mergeRanges(occ_cols);
+  std::size_t nrow = 0, ncol = 0;
+  for (const auto& r : rows) nrow += r.second - r.first;
+  for (const auto& r : cols) ncol += r.second - r.first;
+  const double lg = std::log(static_cast<double>(grid));
+  const double cost_u =
+      static_cast<double>(W2) * lg * grid + static_cast<double>(ncol) * lg * grid;
+  const double cost_v =
+      static_cast<double>(H2) * lg * grid + static_cast<double>(nrow) * lg * grid;
+  if (std::getenv("MX_METAL_DEBUG_OCCUPANCY") != nullptr) {
+    std::string rs = "rows:";
+    for (std::size_t k = 0; k < std::min<std::size_t>(rows.size(), 6); ++k)
+      rs += " [" + std::to_string(rows[k].first) + "," + std::to_string(rows[k].second) + ")";
+    std::string cs = " cols:";
+    for (std::size_t k = 0; k < std::min<std::size_t>(cols.size(), 6); ++k)
+      cs += " [" + std::to_string(cols[k].first) + "," + std::to_string(cols[k].second) + ")";
+    std::fprintf(stderr, "[mx-metal] bandedFFT grid=%zu W2=%zu nrow=%zu ncol=%zu %s%s%s\n", grid, W2,
+                 nrow, ncol, (cost_u < cost_v) ? "ufirst" : "vfirst", rs.c_str(), cs.c_str());
+  }
+  ducc0::vfmav<std::complex<float>> inout(G, {grid, grid});
+  const std::size_t halfW = W2 / 2, halfH = H2 / 2;
+  if (std::getenv("MX_METAL_DEBUG_FULLFFT") != nullptr) {
+    ducc0::detail_fft::c2c(inout, inout, {0}, false, 1.0f, nthreads);
+    ducc0::detail_fft::c2c(inout, inout, {1}, false, 1.0f, nthreads);
+    return;
+  }
+  if (cost_u < cost_v) {
+    for (const auto& r : cols) {
+      auto sub = inout.subarray({{},{r.first, r.second}});
+      ducc0::detail_fft::c2c(sub, sub, {0}, false, 1.0f, nthreads);
+    }
+    {
+      auto sub = inout.subarray({{0, halfW},{}});
+      ducc0::detail_fft::c2c(sub, sub, {1}, false, 1.0f, nthreads);
+    }
+    {
+      auto sub = inout.subarray({{grid - halfW, grid},{}});
+      ducc0::detail_fft::c2c(sub, sub, {1}, false, 1.0f, nthreads);
+    }
+  } else {
+    for (const auto& r : rows) {
+      auto sub = inout.subarray({{r.first, r.second},{}});
+      ducc0::detail_fft::c2c(sub, sub, {1}, false, 1.0f, nthreads);
+    }
+    {
+      auto sub = inout.subarray({{}, {0, halfH}});
+      ducc0::detail_fft::c2c(sub, sub, {0}, false, 1.0f, nthreads);
+    }
+    {
+      auto sub = inout.subarray({{}, {grid - halfH, grid}});
+      ducc0::detail_fft::c2c(sub, sub, {0}, false, 1.0f, nthreads);
+    }
+  }
+}
