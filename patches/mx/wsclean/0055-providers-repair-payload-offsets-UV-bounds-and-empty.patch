 #include <complex>
 #include <memory>
+#include <stdexcept>
 #include <string>
 
 #include <aocommon/vectorset.h>
@@ -60,8 +61,23 @@ class MsRowProviderBase {
 
   virtual void OutputStatistics() const = 0;
 
-  double StartTime() const { return columns_.epoch_as_time(begin_row_).getValue().get(); }
-  double EndTime() const { return columns_.epoch_as_time(end_row_ - 1).getValue().get(); }
+  /**
+   * Epochs of the first and last rows in the selected interval, in days.
+   * An empty row range has no epoch: throw std::runtime_error rather than
+   * return the epoch of an unselected row or a fabricated observation time.
+   * @{
+   */
+  double StartTime() const {
+    if (begin_row_ == end_row_)
+      throw std::runtime_error("Cannot determine start time for an empty row range");
+    return columns_.epoch_as_time(begin_row_).getValue().get();
+  }
+  double EndTime() const {
+    if (begin_row_ == end_row_)
+      throw std::runtime_error("Cannot determine end time for an empty row range");
+    return columns_.epoch_as_time(end_row_ - 1).getValue().get();
+  }
+  /** @} */
 
   size_t BeginRow() const { return begin_row_; }
   size_t EndRow() const { return end_row_; }
