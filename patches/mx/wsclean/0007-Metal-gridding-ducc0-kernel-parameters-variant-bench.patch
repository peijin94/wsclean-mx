+CheckResult checkGrid(const std::vector<float>& candidate,
+                      const std::vector<double>& reference) {
+  CheckResult result;
+  double max_abs_reference = 0.0, sum_square_difference = 0.0, sum_square_reference = 0.0;
+  for (std::size_t i = 0; i < candidate.size(); ++i) {
+    const double a = candidate[i];
+    const double b = reference[i];
+    const double difference = std::fabs(a - b);
+    result.max_abs_difference = std::max(result.max_abs_difference, difference);
+    max_abs_reference = std::max(max_abs_reference, std::fabs(b));
+    sum_square_difference += difference * difference;
+    sum_square_reference += b * b;
+    if (b == 0.0 && a != 0.0) ++result.mismatched_zero;
+    if (b != 0.0 && a == 0.0) ++result.missed_significant;
+  }
+  const double rms_difference = std::sqrt(sum_square_difference / candidate.size());
+  const double rms_reference = std::sqrt(sum_square_reference / candidate.size());
+  result.relative_max = result.max_abs_difference / std::max(max_abs_reference, 1e-30);
+  result.relative_rms = rms_difference / std::max(rms_reference, 1e-30);
+  // Predeclared acceptance: float32 accumulation noise against a float64 twin.
+  constexpr double kTolerance = 1.0e-5;
+  result.passed = result.relative_max <= kTolerance && result.relative_rms <= kTolerance &&
+                  result.mismatched_zero == 0 && result.missed_significant == 0;
+  return result;
+}
