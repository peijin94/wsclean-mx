+BOOST_AUTO_TEST_CASE(fallback_cell_shape_and_reset) {
+  SelectionFixture fixture;
+  casacore::ArrayColumn<casacore::Complex> column(fixture.ms, "CORRECTED_DATA");
+  const casacore::IPosition small(2, 1, 3);
+  const casacore::IPosition large(2, 1, 5);
+  column.put(2, casacore::Array<casacore::Complex>(large, casacore::Complex(42.0f, -2.0f)));
+  ColumnBlock<casacore::Complex> block;
+  const casacore::Complex* values = block.ReadCell(column, 0, 2, 0);
+  BOOST_CHECK(!block.Loaded());
+  BOOST_CHECK_EQUAL(block.CellSize(), 3);
+  BOOST_CHECK(block.CellShape().isEqual(small));
+  BOOST_CHECK_EQUAL(values[0], DataValue(0, 0));
+  values = block.ReadCell(column, 0, 2, 2);
+  BOOST_CHECK_EQUAL(block.CellSize(), 5);
+  BOOST_CHECK(block.CellShape().isEqual(large));
+  for (size_t i = 0; i != 5; ++i) BOOST_CHECK_EQUAL(values[i], casacore::Complex(42.0f, -2.0f));
+  values = block.ReadCell(column, 0, 2, 0);
+  BOOST_CHECK_EQUAL(block.CellSize(), 3);
+  BOOST_CHECK(block.CellShape().isEqual(small));
+  BOOST_CHECK_EQUAL(values[2], DataValue(0, 2));
+
+  // Repair the whole block. Fallback must persist until Reset(), after which
+  // the same block must return to the bulk path. Load()/Cell() remain usable.
+  const casacore::Array<casacore::Complex> repaired(small, casacore::Complex(17.0f, 3.0f));
+  column.put(1, repaired);
+  column.put(2, repaired);
+  values = block.ReadCell(column, 0, 2, 2);
+  BOOST_CHECK(!block.Loaded());
+  BOOST_CHECK_EQUAL(values[0], repaired.data()[0]);
+  block.Reset();
+  BOOST_CHECK(!block.Loaded());
+  values = block.ReadCell(column, 0, 2, 1);
+  BOOST_REQUIRE(block.Loaded());
+  BOOST_CHECK(block.CellShape().isEqual(small));
+  BOOST_CHECK_EQUAL(values[0], repaired.data()[0]);
+  block.Reset();
+  block.Load(column, 0, 2);
+  BOOST_CHECK(block.Loaded());
+  BOOST_CHECK_EQUAL(block.Cell(2)[2], repaired.data()[2]);
+}
