+++ b/external/ducc0/infra/threading.cc
@@ -695,30 +695,54 @@ void Distribution::thread_map(std::function<void(Scheduler &)> f)
 #else  // sequential submission
 
   latch counter(nthreads_-1);
-  for (size_t i=1; i<nthreads_; ++i)
+  size_t i=1;
+  try
     {
-    pool->submit(
-      [this, &f, i, &counter, &ex, &ex_mut, pool] {
-      try
-        {
-        ScopedUseThreadPool guard(*pool);
-        MyScheduler sched(*this, i);
-        f(sched);
-        }
-      catch (...)
-        {
-        LockGuard lock(ex_mut);
-        ex = std::current_exception();
-        }
+    for (; i<nthreads_; ++i)
+      {
+      pool->submit(
+        [this, &f, i, &counter, &ex, &ex_mut, pool] {
+        try
+          {
+          ScopedUseThreadPool guard(*pool);
+          MyScheduler sched(*this, i);
+          f(sched);
+          }
+        catch (...)
+          {
+          LockGuard lock(ex_mut);
+          ex = std::current_exception();
+          }
+        counter.count_down();
+        });
+      }
+    }
+  catch (...)
+    {
+    // Callback construction or submit can fail before accepting job i. Remove
+    // all unaccepted jobs from the latch, then keep the callback/distribution
+    // alive until every accepted worker has finished. A pool must not accept
+    // a job and then throw. Preserve the submission exception even if a worker
+    // also throws while draining.
+    for (; i<nthreads_; ++i)
       counter.count_down();
-      });
+    counter.wait();
+    throw;
+    }
+  try
+    {
+    // do remaining work directly on this thread
+    ScopedValueChanger<bool> changer(in_parallel_region, true);
+    MyScheduler sched(*this, 0);
+    f(sched);
+    }
+  catch (...)
+    {
+    // The distribution and callback are shared with submitted workers. Keep
+    // both alive until counter.wait(), including when the caller throws.
+    LockGuard lock(ex_mut);
+    ex = std::current_exception();
     }
-  {
-  // do remaining work directly on this thread
-  ScopedValueChanger<bool> changer(in_parallel_region, true);
