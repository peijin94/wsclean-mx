+    if (!(RowMax(row + xiStart, xiEnd - xiStart, allow_negative_components,
+                 peakMax) > peakMax))
+      continue;
     size_t index = yi * width + xiStart;
     for (size_t xi = xiStart; xi != xiEnd; ++xi) {
-      float value = image[index];
+      T value = image[index];
       if (allow_negative_components) value = std::fabs(value);
