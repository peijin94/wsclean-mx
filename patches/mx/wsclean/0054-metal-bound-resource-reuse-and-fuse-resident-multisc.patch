@@ -0,0 +1,23 @@
+// Scheduling state used by the PRODUCTION prediction session (no FFT mock math).
+#include "mxpredictioncompletion.h"
+#include <cstdio>
+#include <initializer_list>
+#include <stdexcept>
+#define CHECK(x) do{if(!(x)){std::fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x);return 1;}}while(0)
+int main(){
+ for(bool serial:{false,true})for(bool submit_ok:{false,true})for(bool wait_ok:{false,true}){
+  mx::metal::PredictionCompletion pending;int waits=0;
+  auto wait=[&]()noexcept{++waits;return wait_ok;};
+  pending.submitted(submit_ok,serial,wait);
+  CHECK(waits==(submit_ok&&serial?1:0));
+  CHECK(pending.finish(wait)==(submit_ok&&wait_ok));
+  CHECK(waits==1);
+  CHECK(!pending.finish(wait));CHECK(waits==1);
+ }
+ for(bool serial:{false,true}){
+  mx::metal::PredictionCompletion pending;int waits=0;
+  auto throwing=[&]()->bool{++waits;throw std::runtime_error("wait failure");};
+  pending.submitted(true,serial,throwing);CHECK(!pending.finish(throwing));CHECK(waits==1);
+ }
+ std::puts("PASS serial/overlapped completion: wait once, latch failures, preserve later result accounting");
+}
