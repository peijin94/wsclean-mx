index 00000000..26eb5493
--- /dev/null
+++ b/metal/vkfft_r2c_probe.cpp
@@ -0,0 +1,150 @@
+// Probe for vkFFT R2C/C2R (real transforms) on Metal.
+// Validates the C2R inverse path that schaapcommon's MultiplyAndInverse needs:
+// complex half-spectrum (h x (w/2+1)) -> real image (h x w), unnormalised,
+// matching ducc0::c2r_mut(..., {0,1}, false, 1.0f).
+//
+//   ./mx-vkfft-r2c-probe         1024
+//   ./mx-vkfft-r2c-probe 3072 8   3k production size
+#define NS_PRIVATE_IMPLEMENTATION
+#define MTL_PRIVATE_IMPLEMENTATION
+#define CA_PRIVATE_IMPLEMENTATION
+#include <iostream>  // vkFFT 1.2.31 uses std::cout in its error path
+
+#include "thirdparty/metal-cpp/Foundation/Foundation.hpp"
+#include "thirdparty/metal-cpp/Metal/Metal.hpp"
+#include "thirdparty/metal-cpp/QuartzCore/QuartzCore.hpp"
+
+#define VKFFT_BACKEND 5
+#include "thirdparty/vkFFT.h"
+
+#include <algorithm>
+#include <cmath>
+#include <complex>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <random>
+#include <vector>
+
+#include "ducc0/fft/fft.h"
+#include "ducc0/fft/fftnd_impl.h"
+#include "ducc0/infra/mav.h"
+
+static int run_c2r(std::size_t w, std::size_t h, int nthreads) {
+  const std::size_t cw = w / 2 + 1;
+  const std::size_t nComplex = h * cw;
+  const std::size_t nReal = h * w;
+
+  MTL::Device* device = MTL::CreateSystemDefaultDevice();
+  if (!device) {
+    std::printf("no Metal device\n");
+    return 1;
+  }
+  MTL::CommandQueue* queue = device->newCommandQueue();
+  if (!queue) {
+    std::printf("no Metal queue\n");
+    return 1;
+  }
+  const std::size_t complexBytes = nComplex * sizeof(std::complex<float>);
+  const std::size_t realBytes = nReal * sizeof(float);
+  MTL::Buffer* cbuf = device->newBuffer(complexBytes, MTL::ResourceStorageModeShared);
+  MTL::Buffer* rbuf = device->newBuffer(realBytes, MTL::ResourceStorageModeShared);
+  if (!cbuf || !rbuf) {
+    std::printf("no shared buffers\n");
+    return 1;
+  }
+
+  // Fill the half-spectrum with random data; keep a copy for the CPU.
+  std::mt19937 rng(7);
+  std::vector<std::complex<float>> host(nComplex);
+  for (auto& v : host) {
+    v = {static_cast<float>(rng() % 1000) / 1000.0f - 0.5f,
+         static_cast<float>(rng() % 1000) / 1000.0f - 0.5f};
+  }
+  std::memcpy(cbuf->contents(), host.data(), complexBytes);
+  std::memset(rbuf->contents(), 0, realBytes);
+
+  // CPU reference: exactly what MultiplyAndInverse does after the multiply.
+  std::vector<std::complex<float>> host_mut = host;
+  std::vector<float> ref(nReal, 0.0f);
+  {
+    ducc0::vfmav<std::complex<float>> in(host_mut.data(), {h, cw});
+    ducc0::vfmav<float> out(ref.data(), {h, w});
+    ducc0::c2r_mut(in, out, {0, 1}, false, 1.0f, nthreads);
+  }
+
+  // GPU plan: C2R inverse-only, out-of-place complex -> real.
+  VkFFTApplication app = {};
+  VkFFTConfiguration config = {};
+  config.device = device;
+  config.queue = queue;
+  config.FFTdim = 2;
+  config.size[0] = w;
+  config.size[1] = h;
+  config.performR2C = 1;
+  config.makeInversePlanOnly = 1;
+  config.normalize = 0;
+  config.isInputFormatted = 1;
+  MTL::Buffer* bufPtr = rbuf;    // output (real)
+  MTL::Buffer* inPtr = cbuf;     // input (complex)
+  uint64_t bufSize = realBytes;
+  uint64_t inSize = complexBytes;
+  config.buffer = &bufPtr;
+  config.bufferSize = &bufSize;
+  config.inputBuffer = &inPtr;
+  config.inputBufferSize = &inSize;
+
+  VkFFTResult res = initializeVkFFT(&app, config);
+  if (res != VKFFT_SUCCESS) {
+    std::printf("w=%zu h=%zu init failed: %d\n", w, h, (int)res);
+    return 1;
+  }
+
+  MTL::CommandBuffer* cb = queue->commandBuffer();
+  cb->retain();
+  MTL::ComputeCommandEncoder* enc = cb->computeCommandEncoder();
+  enc->retain();
+  VkFFTLaunchParams launch = {};
+  launch.commandBuffer = cb;
+  launch.commandEncoder = enc;
+  MTL::Buffer* b = rbuf;
+  MTL::Buffer* ib = cbuf;
+  launch.buffer = &b;
+  launch.inputBuffer = &ib;
+  res = VkFFTAppend(&app, +1, &launch);  // +1 = inverse (C2R)
+  enc->endEncoding();
+  enc->release();
+  if (res != VKFFT_SUCCESS) {
+    std::printf("w=%zu h=%zu append failed: %d\n", w, h, (int)res);
+    return 1;
+  }
+  cb->commit();
+  cb->waitUntilCompleted();
+  const bool ok = cb->status() == MTL::CommandBufferStatusCompleted;
+  cb->release();
+  if (!ok) {
+    std::printf("w=%zu h=%zu GPU execution failed\n", w, h);
+    return 1;
+  }
+
+  const float* gpu = static_cast<const float*>(rbuf->contents());
+  double num = 0.0, den = 0.0, maxdiff = 0.0, maxabs = 0.0;
+  for (std::size_t i = 0; i < nReal; ++i) {
+    const double a = gpu[i], b = ref[i];
+    num += (a - b) * (a - b);
+    den += b * b;
+    maxdiff = std::max(maxdiff, std::fabs(a - b));
+    maxabs = std::max(maxabs, std::fabs(b));
+  }
+  const double rel = std::sqrt(num / (den + 1e-30));
+  std::printf("c2r w=%zu h=%zu rel_rms=%.3e max_abs=%.4g max_diff=%.4g %s\n", w, h, rel,
+              maxabs, maxdiff, rel < 5e-6 ? "PASS" : "FAIL");
+  return rel < 5e-6 ? 0 : 1;
+}
+
+int main(int argc, char** argv) {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  const std::size_t n = argc > 1 ? std::stoul(argv[1]) : 1024;
+  const int nthreads = argc > 2 ? std::stoi(argv[2]) : 8;
+  return run_c2r(n, n, nthreads);
+}
