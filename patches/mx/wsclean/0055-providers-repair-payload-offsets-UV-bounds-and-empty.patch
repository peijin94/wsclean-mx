--- a/msproviders/msreaders/reorderedmsreader.h
+++ b/msproviders/msreaders/reorderedmsreader.h
@@ -41,11 +41,12 @@ class ReorderedMsReader final : public MSReader {
 
   size_t current_input_row_ = 0;
   size_t current_value_position_ = 0;
+  // Payload reads are optional and independent. Track the next value in each
+  // stream so sequential reads need no seek, while skipped rows can be caught up.
+  size_t data_value_position_ = 0;
+  size_t weight_value_position_ = 0;
   MSProvider::MetaData metadata_;
 
-  // Chunkoffset counts the amount of data rows we are ahead or behind.
-  // Positive values mean we are lagging, whereas negative values mean we are
-  //  ahead of the current time step.
   bool has_data_ = false;
   bool has_weights_ = false;
 
diff --git a/msproviders/operations.cpp b/msproviders/operations.cpp
index fcfd1b56..73b85da7 100644
--- a/msproviders/operations.cpp
+++ b/msproviders/operations.cpp
@@ -1,4 +1,5 @@
 #include "operations.h"
+#include "rowproviders/msrowproviderbase.h"
 
 #include <aocommon/logger.h>
 
@@ -35,7 +36,9 @@ void GetRowRange(casacore::MeasurementSet& ms, const MSSelection& selection, siz
                  size_t& endRow) {
   startRow = 0;
   endRow = ms.nrow();
-  if (selection.HasInterval()) {
+  if (selection.HasInterval() && endRow != 0) {
+    startRow = endRow;
+    if (selection.IntervalStart() >= selection.IntervalEnd()) return;
     Logger::Info << "Determining first and last row index... ";
     Logger::Info.Flush();
     casacore::ScalarColumn<double> timeColumn(
@@ -43,15 +46,18 @@ void GetRowRange(casacore::MeasurementSet& ms, const MSSelection& selection, siz
     double time = timeColumn(0);
     size_t timestepIndex = 0;
     for (size_t row = 0; row != ms.nrow(); ++row) {
-      if (time != timeColumn(row)) {
+      const double nextTime = timeColumn(row);
+      if (time != nextTime) {
+        if (nextTime < time) ThrowTimeOrderException();
         ++timestepIndex;
-        if (timestepIndex == selection.IntervalStart()) startRow = row;
-        if (timestepIndex == selection.IntervalEnd()) {
-          endRow = row;
-          break;
-        }
-        time = timeColumn(row);
+        time = nextTime;
       }
+      if (timestepIndex == selection.IntervalEnd()) {
+        endRow = row;
+        break;
+      }
+      if (timestepIndex == selection.IntervalStart() && startRow == ms.nrow())
+        startRow = row;
     }
     Logger::Info << "DONE (" << startRow << '-' << endRow << ")\n";
   }
