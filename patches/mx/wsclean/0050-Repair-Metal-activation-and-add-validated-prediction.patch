+class Mock final : public detail_gridder::PredictionSession {
+  size_t nu,nv,next_wait=0;
+  std::vector<std::complex<float>> planes[2];
+  std::future<void> pending[2];
+  bool failed[2]{};
+ public:
+  Mock(size_t u,size_t v):nu(u),nv(v) {
+    for(auto& p:planes) p.resize(nu*nv);
+    saw_padded_shape |= (nv%512==0);
+    ++sessions; ++live; maxlive=std::max(maxlive,live);
+  }
+  ~Mock() override { for(auto& f:pending) if(f.valid()) {f.wait(); --outstanding;} --live; }
+  std::complex<float>* data(size_t s) noexcept override {return planes[s].data();}
+  bool submit(size_t s,size_t pl) noexcept override {
+    ++submits;
+    if(pending[s].valid()) std::abort(); // Never overwrite an in-flight plane.
+    failed[s]=(mode==1 && pl==1);
+    if(failed[s]) {std::fill(planes[s].begin(),planes[s].end(),std::complex<float>(123,-37)); ++failures; return false;}
