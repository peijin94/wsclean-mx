diff --git a/metal/mxprofile.h b/metal/mxprofile.h
new file mode 100644
index 00000000..93871c53
--- /dev/null
+++ b/metal/mxprofile.h
@@ -0,0 +1,67 @@
+// Opt-in trace only: no synchronization, scheduling or numerical changes.
+#ifndef MX_METAL_PROFILE_H
+#define MX_METAL_PROFILE_H
+#include <mach/mach_time.h>
+#include <unistd.h>
+#include <atomic>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace mx::profile {
+inline bool enabled() noexcept {
+  static const bool value=[] { const char* v=std::getenv("MX_METAL_PROFILE");
+    return v && std::strcmp(v,"1")==0; }();
+  return value;
+}
+inline double now() noexcept {
+  static const double scale=[] { mach_timebase_info_data_t t{};
+    mach_timebase_info(&t); return double(t.numer)/double(t.denom)*1e-9; }();
+  return double(mach_absolute_time())*scale;
+}
+inline uint64_t nextId() noexcept {
+  static std::atomic<uint64_t> sequence{0};
+  return enabled()?++sequence:0;
+}
+// id is process nonce + monotonic object ID. command_id joins encode/wait/GPU;
+// buffer_id identifies the plan's shared buffer, never a raw pointer.
+// bytes is event-specific allocated/copied/touched storage, NOT bandwidth.
+struct Context {
+  uint64_t id=0, command=0, buffer=0, parent=0;
+  size_t w=0,h=0,batch=0,bytes=0,copied_bytes=0,filled_bytes=0;
+  long long plane=-1,slot=-1;
+  int direction=0;
+};
+inline void emit(const char* stage,const Context& c,double start,double end,bool ok=true) noexcept {
+  if(!c.id) return;
+  static const uint64_t nonce=mach_absolute_time();
+  char indices[96]{};
+  if(c.plane>=0 && c.slot>=0) std::snprintf(indices,sizeof(indices),",\"plane\":%lld,\"slot\":%lld",c.plane,c.slot);
+  else if(c.plane>=0) std::snprintf(indices,sizeof(indices),",\"plane\":%lld",c.plane);
+  else if(c.slot>=0) std::snprintf(indices,sizeof(indices),",\"slot\":%lld",c.slot);
+  char byte_detail[128]{};
+  if(c.copied_bytes || c.filled_bytes)
+    std::snprintf(byte_detail,sizeof(byte_detail),",\"copied_bytes\":%zu,\"filled_bytes\":%zu",c.copied_bytes,c.filled_bytes);
+  // One stdio call keeps concurrent records intact; preserve overlapping spans.
+  std::fprintf(stderr,"MX_PROFILE {\"type\":\"span\",\"stage\":\"%s\",\"id\":\"%d-%llu-%llu\",\"command_id\":%llu,\"buffer_id\":%llu,\"parent_id\":%llu,\"w\":%zu,\"h\":%zu,\"batch\":%zu,\"bytes\":%zu%s%s,\"direction\":%d,\"start\":%.9f,\"end\":%.9f,\"ok\":%s}\n",
+    stage,int(getpid()),(unsigned long long)nonce,(unsigned long long)c.id,
+    (unsigned long long)c.command,(unsigned long long)c.buffer,(unsigned long long)c.parent,
+    c.w,c.h,c.batch,c.bytes,indices,byte_detail,c.direction,start,end,ok?"true":"false");
+}
+class Span {
+ public:
+  Span(const char* stage,Context context) noexcept:stage_(stage),context_(context),start_(context.id?now():0) {}
+  ~Span(){finish();}
+  Span(const Span&)=delete;
+  Span& operator=(const Span&)=delete;
+  void bytes(size_t value) noexcept { context_.bytes=value; }
+  void finish() noexcept { if(start_){const double end=now();emit(stage_,context_,start_,end,ok);start_=0;} }
+  bool ok=true;
+ private:
+  const char* stage_;
+  Context context_;
+  double start_;
+};
+} // namespace mx::profile
+#endif
