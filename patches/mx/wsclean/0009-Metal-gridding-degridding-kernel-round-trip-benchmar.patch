diff --git a/metal/mxshaders.h b/metal/mxshaders.h
index 1e0fd680..d5dcc49d 100644
--- a/metal/mxshaders.h
+++ b/metal/mxshaders.h
@@ -602,6 +602,52 @@ kernel void grid_accumulate_poly_hoisted(device const float* visibilities,
   }
 }
 
+// Degridding: grid -> visibilities, the adjoint of the gridding accumulation.
+// Each thread owns one visibility and sums its 6x6 neighbourhood of the grid,
+// so no atomics are needed and there is no tile structure to pay for. The
+// kernel weights are ducc0's polynomial, read from the grid buffer as plain
+// floats (the gridding kernel published them through atomics; the merge is
+// complete by the time this runs).
+kernel void grid_degrid_poly(device const float* visibilities_in,  // u, v
+                             device float* visibilities_out,       // re, im
+                             device const float* grid,             // 2 * G * G
+                             constant float* coefficients,
+                             constant uint& degree,
+                             constant uint& grid_size,
+                             constant int& centre,
+                             constant uint& support,
+                             constant uint& count,
+                             uint index [[thread_position_in_grid]]) {
+  if (index >= count) return;
+  const float u = visibilities_in[4 * index + 0];
+  const float v = visibilities_in[4 * index + 1];
+  const float rounded_u = round(u);
+  const float rounded_v = round(v);
+  const int i0 = int(rounded_u) + centre;
+  const int j0 = int(rounded_v) + centre;
+  const float fx = u - rounded_u;
+  const float fy = v - rounded_v;
+  const int half_support = int(support) / 2;
+
+  float2 value = float2(0.0f, 0.0f);
+  for (int jy = -half_support; jy < half_support; ++jy) {
+    const int cy = j0 + jy;
+    if (cy < 0 || cy >= int(grid_size)) continue;
+    const float wy = poly_sample(fy - float(jy), coefficients, degree, support);
+    if (wy == 0.0f) continue;
+    for (int jx = -half_support; jx < half_support; ++jx) {
+      const int cx = i0 + jx;
+      if (cx < 0 || cx >= int(grid_size)) continue;
+      const float weight = poly_sample(fx - float(jx), coefficients, degree, support) * wy;
+      const uint cell = 2 * (uint(cy) * grid_size + uint(cx));
+      value.x += weight * grid[cell];
+      value.y += weight * grid[cell + 1];
+    }
+  }
+  visibilities_out[2 * index + 0] = value.x;
+  visibilities_out[2 * index + 1] = value.y;
+}
+
 )MSL";
 
 }  // namespace mx::metal
