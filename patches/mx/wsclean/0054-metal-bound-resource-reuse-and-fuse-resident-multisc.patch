diff --git a/metal/mxpredictioncompletion.h b/metal/mxpredictioncompletion.h
new file mode 100644
index 00000000..589c82df
--- /dev/null
+++ b/metal/mxpredictioncompletion.h
@@ -0,0 +1,24 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef MX_PREDICTION_COMPLETION_H
+#define MX_PREDICTION_COMPLETION_H
+namespace mx::metal {
+// SERIAL waits at submission but exposes its latched outcome only at the usual
+// ordered consume/wait point. Failed early waits must never turn into successes
+// merely because a later Fft::wait() has no outstanding command buffer.
+class PredictionCompletion {
+ public:
+  template<class Wait> void submitted(bool ok,bool serial,Wait wait) noexcept {
+    pending_=true;submit_ok_=ok;serial_=ok&&serial;result_=serial_?drain(wait):false;
+  }
+  template<class Wait> bool finish(Wait wait) noexcept {
+    if(!pending_)return false;
+    pending_=false;const bool ok=serial_?result_:drain(wait);return submit_ok_&&ok;
+  }
+ private:
+  template<class Wait> static bool drain(Wait wait) noexcept {
+    try {return wait();} catch(...) {return false;}
+  }
+  bool pending_=false,submit_ok_=false,serial_=false,result_=false;
+};
+}
+#endif
diff --git a/metal/mxresidentpeak.h b/metal/mxresidentpeak.h
new file mode 100644
index 00000000..4f20c2aa
--- /dev/null
+++ b/metal/mxresidentpeak.h
@@ -0,0 +1,38 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Integer IEEE binary32 weighting avoids Metal's optional denormal flushing.
+// Reduction compares positive magnitude bits, preserving NaN/inf and strict
+// FLT_MIN behavior even on devices whose float arithmetic flushes subnormals.
+#include "mxbinary32.h"
+static const char* kResidentPeakSource=R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+struct Peak { uint score, bits, index, pad; };
+struct Params { uint w,h,pitch,xb,yb,tiles,negative,weighted,masked; };
+)MSL" MX_BINARY32_STRING R"MSL(
+bool better(Peak a,Peak b){return a.score>b.score || (a.score==b.score && a.index<b.index);}
+kernel void resident_peak(device const uint* images [[buffer(0)]],
+    device const uchar* masks [[buffer(1)]],device const uint* weights [[buffer(2)]],
+    device Peak* partial [[buffer(3)]],constant Params& p [[buffer(4)]],
+    uint group [[threadgroup_position_in_grid]],uint tid [[thread_position_in_threadgroup]]) {
+  Peak best={0x00800000u,0u,0xffffffffu,0u};
+  uint iw=p.w-2*p.xb,count=iw*(p.h-2*p.yb);
+  uint begin=group*4096,end=begin+min(4096u,count-begin);
+  for(uint i=begin+tid;i<end;i+=256){
+    uint row=i/iw+p.yb,col=i%iw+p.xb,index=row*p.w+col;
+    if(p.masked && !masks[index])continue;
+    uint bits=images[row*p.pitch+col];
+    if(p.weighted)bits=multiply_bits(bits,weights[index]);
+    uint score=bits&0x7fffffffu;
+    if(score>0x00800000u && score<=0x7f800000u && (p.negative || !(bits&0x80000000u))){
+      Peak candidate={score,bits,index,0u};if(better(candidate,best))best=candidate;
+    }
+  }
+  threadgroup Peak local[256];local[tid]=best;
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+  for(uint stride=128;stride;stride>>=1){
+    if(tid<stride && better(local[tid+stride],local[tid]))local[tid]=local[tid+stride];
+    threadgroup_barrier(mem_flags::mem_threadgroup);
+  }
+  if(!tid)partial[group]=local[0];
+}
+)MSL";
