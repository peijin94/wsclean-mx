+// Batched gridding: encode one grid per input into a single command buffer
+// and wait once, instead of paying a command-buffer round trip per plane.
+// The w-layer inversion grids dozens of planes per image; the per-plane wait
+// latency (~1 ms, mostly scheduling, not execution) dominates the host wall
+// time. Each plane still gets its own grid buffer (concurrent dispatches must
+// not share outputs); all grids are copied out after the single wait.
+// Numerically identical to calling gridAccumulate per input (same kernels,
+// same inputs, same order-independent atomics).
+std::vector<GridAccumResult> gridAccumulateBatched(const std::vector<GridAccumInput>& inputs) {
+  @autoreleasepool {
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    if (device == nil) fail("no Metal device is available");
+    if (inputs.empty()) return {};
+    const auto host_begin = std::chrono::steady_clock::now();
+
+    struct PlaneJob {
+      GridAccumInput input;
+      TileBuckets buckets;
+      std::size_t tiles_per_row = 0;
+      std::size_t tiles = 0;
+      std::vector<float> packed;
+      std::vector<unsigned> work_items;
+      bool split = false;
+      id<MTLComputePipelineState> pipeline = nil;
+      id<MTLBuffer> grid_buffer = nil;
+      id<MTLBuffer> visibility_buffer = nil;
+      id<MTLBuffer> start_buffer = nil;
+      id<MTLBuffer> item_buffer = nil;
+      id<MTLBuffer> work_buffer = nil;
+      std::size_t grid_bytes = 0;
+      std::size_t g = 0;
+    };
+    std::vector<PlaneJob> jobs;
+    jobs.reserve(inputs.size());
+    for (const auto& in : inputs) {
+      PlaneJob job;
+      job.input = in;
+      const std::size_t g = in.grid_size;
+      if (g == 0 || g % 32 != 0) fail("grid size must be a positive multiple of 32");
+      job.g = g;
+      const char* kernel_name = "grid_accumulate";
+      if (in.variant == Variant::kHoisted) kernel_name = "grid_accumulate_hoisted";
+      if (in.variant == Variant::kPacked) kernel_name = "grid_accumulate_hoisted_packed";
+      if (in.variant == Variant::kCostProbe) kernel_name = "grid_accumulate_cost_probe";
+      if (in.variant == Variant::kPoly) kernel_name = "grid_accumulate_poly";
+      if (in.variant == Variant::kPolyHoisted) kernel_name = "grid_accumulate_poly_hoisted";
+      if (in.variant == Variant::kPolyColumns) kernel_name = "grid_accumulate_poly_columns";
+      job.split = in.split_target > 0 && in.variant == Variant::kPolyHoisted;
+      if (job.split) kernel_name = "grid_accumulate_poly_hoisted_split";
+      if ((in.variant == Variant::kHoisted || in.variant == Variant::kPacked) &&
+          in.support != 6) {
+        fail("the hoisted variants are specialized for support 6");
+      }
+      if ((in.variant == Variant::kPoly || in.variant == Variant::kPolyHoisted ||
+           in.variant == Variant::kPolyColumns) &&
+          in.kernel_coefficients.empty()) {
+        fail("Variant::kPoly needs kernel_coefficients (see bench/metal/ducc0_kernel_tool.cpp)");
+      }
+      job.buckets = bucketVisibilities(in);
+      if (in.variant == Variant::kPacked) job.packed = packBuckets(in, job.buckets);
+      job.tiles_per_row = job.buckets.tiles_per_row;
+      job.tiles = job.tiles_per_row * job.tiles_per_row;
+      if (job.split) {
+        const std::size_t target = std::max<std::size_t>(1, in.split_target);
+        for (std::size_t t = 0; t + 1 < job.buckets.start.size(); ++t) {
+          const std::size_t b = job.buckets.start[t], e = job.buckets.start[t + 1];
+          if (b == e) continue;
+          for (std::size_t s = b; s < e; s += target) {
+            job.work_items.push_back(static_cast<unsigned>(t));
+            job.work_items.push_back(static_cast<unsigned>(s));
+            job.work_items.push_back(static_cast<unsigned>(std::min(e, s + target)));
+          }
+        }
+      }
+      {
+        const std::string key =
+            std::to_string(in.support) + "/" + std::string(kernel_name);
+        std::lock_guard<std::mutex> lock(metalCache().mutex);
+        auto it = metalCache().pipelines.find(key);
+        if (it != metalCache().pipelines.end()) {
+          job.pipeline = it->second;
+        } else {
+          NSError* error = nil;
+          const std::string metal_source = mslSource(in.support);
+          id<MTLLibrary> library =
+              [device newLibraryWithSource:[NSString stringWithUTF8String:metal_source.c_str()]
+                                   options:nil
+                                     error:&error];
+          if (library == nil)
+            fail("kernel compilation failed: " + nsString([error localizedDescription]));
+          id<MTLFunction> function =
+              [library newFunctionWithName:[NSString stringWithUTF8String:kernel_name]];
+          if (function == nil)
+            fail(std::string("kernel function '") + kernel_name + "' is missing");
+          job.pipeline = [device newComputePipelineStateWithFunction:function error:&error];
+          if (job.pipeline == nil)
+            fail("pipeline creation failed: " + nsString([error localizedDescription]));
+          metalCache().pipelines[key] = job.pipeline;
+        }
+      }
+      job.grid_bytes = 2 * g * g * sizeof(float);
+      job.grid_buffer = [device newBufferWithLength:job.grid_bytes
+                                            options:MTLResourceStorageModeShared];
+      std::memset([job.grid_buffer contents], 0, job.grid_bytes);
+      if (in.variant == Variant::kPacked) {
+        if (!job.packed.empty()) {
+          job.visibility_buffer = [device newBufferWithBytes:job.packed.data()
+                                                       length:job.packed.size() * sizeof(float)
+                                                      options:MTLResourceStorageModeShared];
+        }
+      } else if (!in.visibilities.empty()) {
+        job.visibility_buffer = [device newBufferWithBytes:in.visibilities.data()
+                                                    length:in.visibilities.size() * sizeof(float)
+                                                   options:MTLResourceStorageModeShared];
+      }
+      if (job.split && !job.work_items.empty()) {
+        job.work_buffer = [device newBufferWithBytes:job.work_items.data()
+                                              length:job.work_items.size() * sizeof(unsigned)
+                                             options:MTLResourceStorageModeShared];
+      }
+      job.start_buffer = [device newBufferWithBytes:job.buckets.start.data()
+                                             length:job.buckets.start.size() * sizeof(unsigned)
+                                            options:MTLResourceStorageModeShared];
+      if (!job.buckets.items.empty()) {
+        job.item_buffer = [device newBufferWithBytes:job.buckets.items.data()
+                                              length:job.buckets.items.size() * sizeof(unsigned)
+                                             options:MTLResourceStorageModeShared];
+      }
+      jobs.push_back(job);
+    }
+
+    id<MTLCommandQueue> queue = [device newCommandQueue];
+    id<MTLCommandBuffer> command_buffer = [queue commandBuffer];
+    for (auto& job : jobs) {
+      const auto& in = job.input;
+      id<MTLComputeCommandEncoder> encoder = [command_buffer computeCommandEncoder];
+      [encoder setComputePipelineState:job.pipeline];
+      const unsigned grid_size = static_cast<unsigned>(job.g);
+      const int centre = static_cast<int>(job.g) / 2;
+      const unsigned tiles_row = static_cast<unsigned>(job.tiles_per_row);
+      const unsigned support = static_cast<unsigned>(in.support);
+      const float beta = in.beta;
+      const float e0 = in.e0;
+      if (in.variant == Variant::kPoly || in.variant == Variant::kPolyHoisted ||
+          in.variant == Variant::kPolyColumns) {
+        [encoder setBuffer:job.visibility_buffer offset:0 atIndex:0];
+        if (job.split && job.work_buffer != nil) {
+          [encoder setBuffer:job.work_buffer offset:0 atIndex:1];
+        } else {
+          [encoder setBuffer:job.start_buffer offset:0 atIndex:1];
+        }
+        [encoder setBuffer:job.item_buffer offset:0 atIndex:2];
+        [encoder setBuffer:job.grid_buffer offset:0 atIndex:3];
+        const unsigned degree = static_cast<unsigned>(in.kernel_degree);
+        [encoder setBytes:in.kernel_coefficients.data()
+                   length:in.kernel_coefficients.size() * sizeof(float)
+                  atIndex:4];
+        [encoder setBytes:&degree length:sizeof(degree) atIndex:5];
+        [encoder setBytes:&grid_size length:sizeof(grid_size) atIndex:6];
+        [encoder setBytes:&centre length:sizeof(centre) atIndex:7];
+        [encoder setBytes:&tiles_row length:sizeof(tiles_row) atIndex:8];
+        [encoder setBytes:&support length:sizeof(support) atIndex:9];
+        const unsigned group_threads = static_cast<unsigned>(in.threads_per_group);
+        [encoder setBytes:&group_threads length:sizeof(group_threads) atIndex:10];
+      } else if (in.variant == Variant::kPacked) {
+        [encoder setBuffer:job.visibility_buffer offset:0 atIndex:0];
+        [encoder setBuffer:job.start_buffer offset:0 atIndex:1];
+        [encoder setBuffer:job.grid_buffer offset:0 atIndex:2];
+        [encoder setBytes:&grid_size length:sizeof(grid_size) atIndex:3];
+        [encoder setBytes:&centre length:sizeof(centre) atIndex:4];
+        [encoder setBytes:&tiles_row length:sizeof(tiles_row) atIndex:5];
+        [encoder setBytes:&beta length:sizeof(beta) atIndex:6];
+        [encoder setBytes:&e0 length:sizeof(e0) atIndex:7];
+      } else {
+        [encoder setBuffer:job.visibility_buffer offset:0 atIndex:0];
+        if (job.split && job.work_buffer != nil) {
+          [encoder setBuffer:job.work_buffer offset:0 atIndex:1];
+        } else {
+          [encoder setBuffer:job.start_buffer offset:0 atIndex:1];
+        }
+        [encoder setBuffer:job.item_buffer offset:0 atIndex:2];
+        [encoder setBuffer:job.grid_buffer offset:0 atIndex:3];
+        [encoder setBytes:&grid_size length:sizeof(grid_size) atIndex:4];
+        [encoder setBytes:&centre length:sizeof(centre) atIndex:5];
+        [encoder setBytes:&tiles_row length:sizeof(tiles_row) atIndex:6];
+        [encoder setBytes:&support length:sizeof(support) atIndex:7];
+        [encoder setBytes:&beta length:sizeof(beta) atIndex:8];
+        [encoder setBytes:&e0 length:sizeof(e0) atIndex:9];
+      }
+      if (in.variant == Variant::kPolyColumns) {
+        [encoder dispatchThreadgroups:MTLSizeMake(job.tiles_per_row, job.tiles_per_row, 1)
+                threadsPerThreadgroup:MTLSizeMake(32, 32, 1)];
+      } else if (job.split && !job.work_items.empty()) {
+        const std::size_t items = job.work_items.size() / 3;
+        [encoder dispatchThreadgroups:MTLSizeMake(items, 1, 1)
+                threadsPerThreadgroup:MTLSizeMake(16, in.threads_per_group / 16, 1)];
+      } else if (in.variant == Variant::kPoly || in.variant == Variant::kPolyHoisted) {
+        if (in.threads_per_group < 16 || in.threads_per_group % 16 != 0 ||
+            in.threads_per_group > 1024) {
+          fail("threads_per_group must be a multiple of 16 in [16, 1024]");
+        }
+        [encoder dispatchThreadgroups:MTLSizeMake(job.tiles_per_row, job.tiles_per_row, 1)
+                threadsPerThreadgroup:MTLSizeMake(16, in.threads_per_group / 16, 1)];
+      } else {
+        [encoder dispatchThreadgroups:MTLSizeMake(job.tiles_per_row, job.tiles_per_row, 1)
+                threadsPerThreadgroup:MTLSizeMake(16, 16, 1)];
+      }
+      [encoder endEncoding];
+    }
+
+    const auto begin = std::chrono::steady_clock::now();
+    [command_buffer commit];
+    [command_buffer waitUntilCompleted];
+    const auto end = std::chrono::steady_clock::now();
+    if ([command_buffer status] != MTLCommandBufferStatusCompleted) {
+      fail("command buffer failed: " + nsString([[command_buffer error] localizedDescription]));
+    }
+    const double gpu_seconds =
+        [command_buffer GPUEndTime] - [command_buffer GPUStartTime];
+
+    std::vector<GridAccumResult> results;
+    results.reserve(jobs.size());
+    for (auto& job : jobs) {
+      GridAccumResult result;
+      result.grid.resize(2 * job.g * job.g);
+      std::memcpy(result.grid.data(), [job.grid_buffer contents], job.grid_bytes);
+      result.gpu_seconds = gpu_seconds / static_cast<double>(jobs.size());
+      result.wall_seconds = std::chrono::duration<double>(end - begin).count();
+      result.host_seconds = std::chrono::duration<double>(begin - host_begin).count();
+      result.visibilities = job.input.visibilities.size() / 4;
+      result.tiles = job.tiles;
+      result.bucket_items = job.buckets.items.size();
+      results.push_back(std::move(result));
+    }
+    return results;
+  }
+}
+
