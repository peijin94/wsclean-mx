+// Native Metal retain + allocatedSize observations through the real allocator.
+#include "thirdparty/metal-cpp/Foundation/Foundation.hpp"
+#include "thirdparty/metal-cpp/Metal/Metal.hpp"
+#include <cstring>
+#include "mxmetalbuffer.h"
+#include <cstdio>
+#define CHECK(x) do{if(!(x)){std::fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x);return 1;}}while(0)
+int main(){
+  auto* device=MTL::CreateSystemDefaultDevice();
+  if(!device){std::fputs("UNAVAILABLE: native Metal device required\n",stderr);return 77;}
+  auto* queue=device->newCommandQueue();CHECK(queue);
+  const auto baseline=mx::metal::budgetStats().used;
+  for(auto options:{MTL::ResourceStorageModeShared,MTL::ResourceStorageModePrivate})
+    for(size_t n:{size_t(1),size_t(16383),size_t(16384),size_t(16385),size_t(65537)}){
+      auto* pool=NS::AutoreleasePool::alloc()->init();
+      auto* buffer=mx::metal::newBuffer(device,n,options);CHECK(buffer);
+      const size_t charge=(n+16383)&~size_t(16383);
+      std::printf("mode=%lu requested=%zu rounded_charge=%zu allocatedSize=%lu\n",(unsigned long)options,n,charge,(unsigned long)buffer->allocatedSize());
+      CHECK(mx::metal::budgetStats().used==baseline+charge);
+      buffer->release();pool->release();
+      CHECK(mx::metal::budgetStats().used==baseline);
+    }
+  // allocatedSize above is an observation, not a universal physical cap.
+  // Test command retention separately with a legal whole-buffer fill: Apple
+  // requires both the fill offset and length to be multiples of four bytes.
+  for(auto options:{MTL::ResourceStorageModeShared,MTL::ResourceStorageModePrivate}){
+      constexpr size_t n=16384,charge=16384;
+      auto* pool=NS::AutoreleasePool::alloc()->init();
+      auto* buffer=mx::metal::newBuffer(device,n,options);CHECK(buffer);
+      CHECK(mx::metal::budgetStats().used==baseline+charge);
+      auto* event=device->newSharedEvent();CHECK(event);
+      auto* command=queue->commandBuffer();CHECK(command);command->retain();
+      command->encodeWait(event,1);
+      auto* blit=command->blitCommandEncoder();CHECK(blit);
+      blit->fillBuffer(buffer,NS::Range(0,n),0);blit->endEncoding();
+      command->commit();buffer->release();buffer=nullptr;
+      // Drain autoreleased encoders/command references before observing the
+      // reservation; retain only our explicit command owner across the wait.
+      pool->release();
+      // The unsignaled GPU wait prevents completion. Only the real command
+      // retains the buffer now; a host-owner accounting token would fail here.
+      const auto retained_charge=mx::metal::budgetStats().used;
+      event->setSignaledValue(1);command->waitUntilCompleted();
+      CHECK(retained_charge==baseline+charge);
+      CHECK(command->status()==MTL::CommandBufferStatusCompleted);
+      command->release();event->release();
+      CHECK(mx::metal::budgetStats().used==baseline);
+      std::printf("retention mode=%lu legal_fill_bytes=%zu baseline_restored=1\n",(unsigned long)options,n);
+    }
+  queue->release();device->release();
+  std::puts("PASS actual Metal command retains reservation through host release and completion; allocatedSize observations above");
+  return 0;
+}
