--- /dev/null
+++ b/metal/mxbinary32.h
@@ -0,0 +1,37 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// One implementation compiled by BOTH Metal and the CPU arithmetic regression.
+#ifndef MX_BINARY32_H
+#define MX_BINARY32_H
+#define MX_BINARY32_FUNCTIONS \
+ulong rounded_shift(ulong p,int shift) { \
+  if(shift<=0)return p<<uint(-shift); \
+  if(shift>=64)return 0; \
+  ulong q=p>>uint(shift),mask=(1ul<<uint(shift))-1ul; \
+  ulong rem=p&mask,halfway=1ul<<uint(shift-1); \
+  return q+ulong(rem>halfway || (rem==halfway && (q&1ul))); \
+} \
+uint multiply_bits(uint a,uint b) { \
+  uint sign=(a^b)&0x80000000u,aa=a&0x7fffffffu,bb=b&0x7fffffffu; \
+  if(aa>0x7f800000u || bb>0x7f800000u)return 0x7fc00000u; \
+  if(aa==0x7f800000u || bb==0x7f800000u) { \
+    if(!aa || !bb)return 0x7fc00000u; \
+    return sign|0x7f800000u; \
+  } \
+  if(!aa || !bb)return sign; \
+  int ae=int(aa>>23),be=int(bb>>23); \
+  ulong sa=ulong((aa&0x7fffffu)|(ae?0x800000u:0u)); \
+  ulong sb=ulong((bb&0x7fffffu)|(be?0x800000u:0u)); \
+  int power=(ae?ae:1)+(be?be:1)-254-46; \
+  ulong p=sa*sb; \
+  int top=63-int(clz(p)),exponent=power+top; \
+  if(exponent>127)return sign|0x7f800000u; \
+  if(exponent < -126)return sign|uint(rounded_shift(p,-149-power)); \
+  ulong sig=rounded_shift(p,top-23); \
+  if(sig==0x1000000ul){sig>>=1;++exponent;} \
+  if(exponent>127)return sign|0x7f800000u; \
+  return sign|(uint(exponent+127)<<23)|(uint(sig)&0x7fffffu); \
+}
+#define MX_STRINGIFY_IMPL(...) #__VA_ARGS__
+#define MX_STRINGIFY(...) MX_STRINGIFY_IMPL(__VA_ARGS__)
+#define MX_BINARY32_STRING MX_STRINGIFY(MX_BINARY32_FUNCTIONS)
+#endif
