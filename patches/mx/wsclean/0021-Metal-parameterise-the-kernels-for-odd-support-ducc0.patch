 constant uint kSupport = 6;
 constant int kHalfSupport = 3;
+// Anchor of the kernel window: cells are floor(x) - kLowestOffset ..
+// floor(x) + kHalfSupport, i.e. the support spans (-W/2, W/2] and works
+// for odd W too (W=7: -3..+3, W=6: -2..+3).
+constant int kLowestOffset = 2;
 
 // Hoisted variant: each 1D weight is evaluated once per visibility and kept in
 // a register, instead of being recomputed for every cell of the support (the
@@ -236,7 +240,7 @@ kernel void grid_accumulate_hoisted(device const float* visibilities,  // u,v,re
     float sum_x = 0.0f, sum_y = 0.0f;
 #pragma clang loop unroll(full)
