+BOOST_AUTO_TEST_CASE(excludes_different_cell_shapes) {
+  for (const std::string column : {"CORRECTED_DATA", "FLAG", "WEIGHT", "WEIGHT_SPECTRUM"}) {
+    BOOST_TEST_CONTEXT("excluded shape mismatch, column " << column) {
+      SelectionFixture fixture(FixtureOptions{.undefined_column = column,
+                                              .spectral_weights = column == "WEIGHT_SPECTRUM"});
+      const casacore::IPosition shape(2, 2, 2);
+      if (column == "CORRECTED_DATA") {
+        casacore::ArrayColumn<casacore::Complex>(fixture.ms, column)
+            .put(1, casacore::Array<casacore::Complex>(shape, casacore::Complex(99.0f, 0.0f)));
+      } else if (column == "FLAG") {
+        casacore::ArrayColumn<bool>(fixture.ms, column).put(1, casacore::Array<bool>(shape, true));
+      } else {
+        casacore::ArrayColumn<float>(fixture.ms, column)
+            .put(1, casacore::Array<float>(column == "WEIGHT" ? casacore::IPosition(1, 2) : shape,
+                                           99.0f));
+      }
+      CheckBoth(fixture);
+    }
+  }
+}
+
+BOOST_AUTO_TEST_CASE(direct_variable_shapes_resize_outputs) {
+  for (bool spectral_weights : {false, true}) {
+    for (bool variable_channels : {false, true}) {
+      BOOST_TEST_CONTEXT("variable shapes, spectral " << spectral_weights << ", channels "
+                                                      << variable_channels) {
+        SelectionFixture fixture(FixtureOptions{
+            .undefined_column = "", .excluded_rows = {}, .spectral_weights = spectral_weights});
+        fixture.ms.spectralWindow().addRow();
+        fixture.ms.polarization().addRow();
+        fixture.ms.dataDescription().addRow();
+        casacore::MSColumns columns(fixture.ms);
+        const size_t channels = variable_channels ? 5 : 3;
+        columns.spectralWindow().numChan().put(1, channels);
+        columns.spectralWindow().chanFreq().put(1, casacore::Vector<double>(channels, 110e6));
+        columns.spectralWindow().chanWidth().put(1, casacore::Vector<double>(channels, 1e6));
+        columns.spectralWindow().refFrequency().put(1, 110e6);
+        columns.polarization().numCorr().put(1, 4);
+        columns.polarization().corrType().put(1, casacore::Vector<int>{9, 10, 11, 12});
+        casacore::Matrix<int> products(2, 4);
+        for (size_t pol = 0; pol != 4; ++pol) {
+          products(0, pol) = pol / 2;
+          products(1, pol) = pol % 2;
+        }
+        columns.polarization().corrProduct().put(1, products);
+        columns.dataDescription().spectralWindowId().put(1, 1);
+        columns.dataDescription().polarizationId().put(1, 1);
+        columns.dataDescId().put(1, 1);
+        const casacore::IPosition large(2, 4, channels);
+        casacore::Array<casacore::Complex> large_data(large);
+        casacore::Array<bool> large_flags(large);
+        casacore::Array<float> large_weights(large);
+        for (size_t i = 0; i != large_data.nelements(); ++i) {
+          large_data.data()[i] = DataValue(1, i);
+          large_flags.data()[i] = FlagValue(1, i);
+          large_weights.data()[i] = 3.0f + 0.25f * (spectral_weights ? i : i % 4);
+        }
+        columns.correctedData().put(1, large_data);
+        columns.flag().put(1, large_flags);
+        columns.weight().put(1, casacore::Vector<float>{3.0f, 3.25f, 3.5f, 3.75f});
+        if (spectral_weights) columns.weightSpectrum().put(1, large_weights);
+        BOOST_REQUIRE_EQUAL(ColumnBlockRows(fixture.ms, 3), 1);
+        DirectMSRowProvider provider(fixture.ms, MSSelection{}, aocommon::VectorSet<size_t>{0, 1},
+                                     "CORRECTED_DATA", "MODEL_DATA", false);
+        // Reuse all three arrays while they grow and shrink.
+        MsRowProviderBase::DataArray data;
+        MsRowProviderBase::FlagArray flags;
+        MsRowProviderBase::WeightArray weights;
+        for (size_t row = 0; row != 3; ++row) {
+          BOOST_REQUIRE(!provider.AtEnd());
+          double u, v, w, time;
+          float interval;
+          uint32_t ddid, antenna1, antenna2, field;
+          provider.ReadData(data, flags, weights, u, v, w, ddid, antenna1, antenna2, field, time,
+                            interval);
+          const casacore::IPosition shape = row == 1 ? large : casacore::IPosition(2, 1, 3);
+          BOOST_REQUIRE(data.shape().isEqual(shape));
+          BOOST_REQUIRE(flags.shape().isEqual(shape));
+          BOOST_REQUIRE(weights.shape().isEqual(shape));
+          BOOST_CHECK_EQUAL(ddid, row == 1 ? 1 : 0);
+          BOOST_CHECK_EQUAL(time, 1000.0 + row);
+          for (size_t i = 0; i != data.nelements(); ++i) {
+            BOOST_CHECK_EQUAL(data.data()[i], DataValue(row, i));
+            BOOST_CHECK_EQUAL(flags.data()[i], FlagValue(row, i));
+            BOOST_CHECK_EQUAL(weights.data()[i],
+                              row == 1 ? large_weights.data()[i] : fixture.WeightValue(row, i));
+          }
+          provider.NextRow();
+        }
+        BOOST_CHECK(provider.AtEnd());
+      }
+    }
+  }
+}
