+size_t ContiguousMSReader::blockIndex(size_t row) {
+  if (row < block_start_ || row >= block_end_) {
+    const ContiguousMS& contiguousms = static_cast<const ContiguousMS&>(*ms_provider_);
+    block_start_ = row;
+    block_end_ = std::min(row + block_rows_, contiguousms._endRow);
+    block_uvw_.Load(contiguousms._uvwColumn, block_start_, block_end_ - 1);
+    block_data_.Reset();
+    block_flag_.Reset();
+    block_weight_.Reset();
+  }
+  return row - block_start_;
+}
+
+const double* ContiguousMSReader::uvw(size_t row) { return block_uvw_.Cell(blockIndex(row)); }
