@@ -0,0 +1,48 @@
+"""CPU behavioral gate for the actual vendor transfer/preparation bodies.
+
+The Metal API and nested FFT compiler are deterministic doubles. This does not
+prove GPU behavior; failure_probe.cpp is the corresponding native gate.
+Scratch/build products must be placed in the supplied artifact directory.
+"""
+import argparse
+from pathlib import Path
+import subprocess
+
+p = argparse.ArgumentParser()
+p.add_argument('artifactdir', type=Path)
+p.add_argument('--vendor-source', type=Path, help='Optional pre-fix vendor for RED')
+p.add_argument('--buffer-source', type=Path, help='Optional pre-fix probe for RED')
+a = p.parse_args()
+root = Path(__file__).resolve().parent
+out = a.artifactdir.resolve()
+out.mkdir(parents=True, exist_ok=True)
+vendor = (a.vendor_source or root / 'thirdparty/vkFFT.h').read_text()
+bodies = []
+for name in ('VkFFT_transferDataFromCPU', 'VkFFT_transferDataToCPU',
+             'VkFFTGeneratePhaseVectors', 'VkFFTGenerateRaderFFTKernel'):
+    start = vendor.index('static inline VkFFTResult ' + name + '(')
+    end = vendor.index('\nstatic inline ', start + 1)
+    bodies.append(vendor[start:end])
+# Select the production Metal branches without rewriting their statements.
+subprocess.run(['clang++', '-E', '-P', '-x', 'c++', '-DVKFFT_BACKEND=5',
+                '-', '-o', str(out / 'vendor_bodies.h')],
+               input='\n'.join(bodies), text=True, check=True)
+binary = out / 'vendor-failure-cpu'
+subprocess.run(['clang++', '-std=c++17', '-g', '-fsanitize=address,undefined',
+                '-I', str(out), '-I', str(root),
+                str(root / 'vendor_failure_cpu.cpp'), str(root / 'mxbudget.cpp'),
+                '-o', str(binary)], check=True)
+vendor_result = subprocess.run([str(binary)]).returncode
+probe = (a.buffer_source or root / 'metal_buffer_probe.cpp').read_text()
+(out / 'buffer_probe_body.h').write_text(probe[probe.index('int main(){'):])
+binary = out / 'buffer-contract-cpu'
+subprocess.run(['clang++', '-std=c++17', '-g', '-fsanitize=address,undefined',
+                '-I', str(out), '-I', str(root),
+                str(root / 'metal_buffer_cpu.cpp'), str(root / 'mxbudget.cpp'),
+                '-o', str(binary)], check=True)
+buffer_run = subprocess.run([str(binary)], text=True, stdout=subprocess.PIPE,
+                            stderr=subprocess.STDOUT)
+for line in buffer_run.stdout.splitlines():
+    print('[CPU contract double] ' + line, flush=True)
+buffer_result = buffer_run.returncode
+raise SystemExit(vendor_result or buffer_result)
