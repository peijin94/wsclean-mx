diff --git a/metal/mxcpugrid.cpp b/metal/mxcpugrid.cpp
new file mode 100644
index 00000000..21326b55
--- /dev/null
+++ b/metal/mxcpugrid.cpp
@@ -0,0 +1,197 @@
+#include "mxcpugrid.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+#include "ducc0/math/gridding_kernel.h"
+
+namespace mx::metal {
+namespace {
+
+constexpr std::size_t kTile = 32;
+
+// ducc0's fitted kernel evaluated exactly as the poly shader does: the
+// coefficient table is interval-major over the support window, each entry a
+// polynomial in a local [-1,1] coordinate. (PolynomialKernel::eval expects the
+// normalised coordinate instead, so it is not what the GPU path uses.)
+inline double polySample(double x, const std::vector<double>& co, long degree, long support) {
+  const double hs = 0.5 * static_cast<double>(support);
+  if (x <= -hs || x >= hs) return 0.0;
+  const double xrel = hs * (x / hs + 1.0);
+  long nth = static_cast<long>(xrel);
+  if (nth >= support) nth = support - 1;
+  const double locx = ((xrel - static_cast<double>(nth)) - 0.5) * 2.0;
+  const std::size_t ofs = static_cast<std::size_t>(nth * (degree + 1));
+  double v = co[ofs];
+  for (long i = 1; i <= degree; ++i) v = v * locx + co[ofs + static_cast<std::size_t>(i)];
+  return v;
+}
+
+inline long wrapTap(long c, long n) {
+  long r = c % n;
+  return r < 0 ? r + n : r;
+}
+
+}  // namespace
+
+void cpuGridPlane(const float* vis, std::size_t n_items, std::size_t grid,
+                  const ducc0::PolynomialKernel& kernel, int nthreads, float* out) {
+  if (n_items == 0 || grid == 0) return;
+  const long n = static_cast<long>(grid);
+  const long support = static_cast<long>(kernel.support());
+  if (support > 32) return;  // no ducc0 kernel comes close; guard the stack arrays
+  // Tap window of the poly kernel: j in [jlo, jhi] inclusive, cell = base + j,
+  // weight = K(frac - j). For even support this is base-2..base+3 at W=6. No
+  // normalisation: ducc0's fitted kernel already sums to one (normalising, as
+  // the older hoisted shader did, scales the whole grid by 1/support).
+  const long jlo = -(support / 2) + 1 - (support & 1);
+  const long jhi = support / 2;
+  const std::vector<double>& coeff = kernel.Coeff();
+  const long degree = static_cast<long>(kernel.degree());
+  const long centre = n / 2;
+  const long tiles_per_row = (n + static_cast<long>(kTile) - 1) / static_cast<long>(kTile);
+  const std::size_t ntiles = static_cast<std::size_t>(tiles_per_row * tiles_per_row);
+
+  // Probe: does PolynomialKernel::eval take cell units or the [-1,1] normalised
+  // coordinate? Compare against ducc0's coefficient table evaluated the way the
+  // poly shader does it.
+  if (std::getenv("MX_METAL_DEBUG_KERNEL") != nullptr) {
+    const auto& co = kernel.Coeff();
+    const long deg = static_cast<long>(kernel.degree());
+    const double hs = 0.5 * static_cast<double>(support);
+    for (double x : {-2.5, -1.5, -0.5, 0.0, 0.5, 1.5, 2.5}) {
+      const double xn = x / hs;
+      const double xrel = hs * (xn + 1.0);
+      long nth = static_cast<long>(xrel);
+      nth = std::min<long>(nth, support - 1);
+      const double locx = ((xrel - static_cast<double>(nth)) - 0.5) * 2.0;
+      const long ofs = nth * (deg + 1);
+      double v = co[static_cast<std::size_t>(ofs)];
+      for (long i = 1; i <= deg; ++i)
+        v = v * locx + co[static_cast<std::size_t>(ofs + i)];
+      std::fprintf(stderr, "[kernel] x=%5.2f eval=%.6f horner(cells)=%.6f raw_eval(norm)=%.6f\n",
+                   x, kernel.eval(x), v, kernel.eval(xn));
+    }
+  }
+
+  // ---- Bucket items by the tile(s) their tap window can write into.
+  // The tap window for one item is a contiguous run of `support` cells, shorter
+  // than a tile, so it touches at most two tiles per axis (more only when it
+  // wraps past the grid edge, which the wrapped endpoints already capture).
+  std::vector<std::uint32_t> counts(ntiles + 1, 0);
+  auto tiles_for = [&](const float* v, std::uint32_t* out_tiles) -> int {
+    const long bx = static_cast<long>(v[0]);
+    const long by = static_cast<long>(v[2]);
+    const long x0 = wrapTap(bx + jlo + centre, n);
+    const long x1 = wrapTap(bx + jhi + centre, n);
+    const long y0 = wrapTap(by + jlo + centre, n);
+    const long y1 = wrapTap(by + jhi + centre, n);
+    const long tx0 = x0 / static_cast<long>(kTile), tx1 = x1 / static_cast<long>(kTile);
+    const long ty0 = y0 / static_cast<long>(kTile), ty1 = y1 / static_cast<long>(kTile);
+    int count = 0;
+    for (long ty = ty0;; ty = ty1) {
+      for (long tx = tx0;; tx = tx1) {
+        out_tiles[count++] = static_cast<std::uint32_t>(ty * tiles_per_row + tx);
+        if (tx == tx1) break;
+      }
+      if (ty == ty1) break;
+    }
+    return count;
+  };
+
+  std::vector<std::uint32_t> scratch(4);
+  for (std::size_t item = 0; item < n_items; ++item) {
+    const int k = tiles_for(vis + 6 * item, scratch.data());
+    for (int i = 0; i < k; ++i) ++counts[scratch[static_cast<std::size_t>(i)] + 1];
+  }
+  for (std::size_t t = 1; t <= ntiles; ++t) counts[t] += counts[t - 1];
+  std::vector<std::uint32_t> items(counts[ntiles]);
+  {
+    std::vector<std::uint32_t> cursor(counts.begin(), counts.end() - 1);
+    for (std::size_t item = 0; item < n_items; ++item) {
+      const int k = tiles_for(vis + 6 * item, scratch.data());
+      for (int i = 0; i < k; ++i) {
+        const std::uint32_t t = scratch[static_cast<std::size_t>(i)];
+        items[cursor[t]++] = static_cast<std::uint32_t>(item);
+      }
+    }
+  }
+
+  // ---- Grid: one thread per tile, private accumulation buffer per thread.
+  const int nthreads_eff =
+      std::max(1, std::min<int>(nthreads, static_cast<int>(ntiles)));
+  std::atomic<std::size_t> next_tile{0};
+  auto worker = [&]() {
+    std::vector<float> acc(2 * kTile * kTile);
+    for (;;) {
+      const std::size_t tile = next_tile.fetch_add(1, std::memory_order_relaxed);
+      if (tile >= ntiles) return;
+      std::memset(acc.data(), 0, acc.size() * sizeof(float));
+      const long tx = static_cast<long>(tile % static_cast<std::size_t>(tiles_per_row));
+      const long ty = static_cast<long>(tile / static_cast<std::size_t>(tiles_per_row));
+      const long x0 = tx * static_cast<long>(kTile);
+      const long y0 = ty * static_cast<long>(kTile);
+      const long x1 = std::min(x0 + static_cast<long>(kTile), n);
+      const long y1 = std::min(y0 + static_cast<long>(kTile), n);
+
+      for (std::uint32_t p = counts[tile]; p < counts[tile + 1]; ++p) {
+        const std::uint32_t item = items[p];
+        const float* v = vis + 6 * static_cast<std::size_t>(item);
+        const long i0 = static_cast<long>(v[0]) + centre;
+        const long j0 = static_cast<long>(v[2]) + centre;
+        const double fx = static_cast<double>(v[1]);
+        const double fy = static_cast<double>(v[3]);
+
+        double wx[32], wy[32];
+        for (long j = jlo; j <= jhi; ++j) {
+          const long idx = j - jlo;
+          wx[idx] = polySample(fx - static_cast<double>(j), coeff, degree, support);
+          wy[idx] = polySample(fy - static_cast<double>(j), coeff, degree, support);
+        }
+
+        for (long jy = jlo; jy <= jhi; ++jy) {
+          const long cy = wrapTap(j0 + jy, n);
+          if (cy < y0 || cy >= y1) continue;
+          const double wy_s = wy[jy - jlo];
+          if (wy_s == 0.0) continue;
+          for (long jx = jlo; jx <= jhi; ++jx) {
+            const long cx = wrapTap(i0 + jx, n);
+            if (cx < x0 || cx >= x1) continue;
+            const double weight = wx[jx - jlo] * wy_s;
+            float* cell = acc.data() + 2 * ((cy - y0) * static_cast<long>(kTile) + (cx - x0));
+            cell[0] += static_cast<float>(weight * v[4]);
+            cell[1] += static_cast<float>(weight * v[5]);
+          }
+        }
+      }
+      // Flush this tile's own cells; tiles are disjoint so no atomics needed.
+      // Grid layout is [cx*grid + cy] (u slowest), matching the Metal kernel.
+      for (long cy = y0; cy < y1; ++cy) {
+        for (long cx = x0; cx < x1; ++cx) {
+          const float* src = acc.data() + 2 * ((cy - y0) * static_cast<long>(kTile) + (cx - x0));
+          if (src[0] == 0.0f && src[1] == 0.0f) continue;
+          float* dst = out + 2 * (static_cast<std::size_t>(cx) * grid + static_cast<std::size_t>(cy));
+          dst[0] = src[0];
+          dst[1] = src[1];
+        }
+      }
+    }
+  };
+
+  if (nthreads_eff <= 1) {
+    worker();
+  } else {
+    std::vector<std::thread> pool;
+    pool.reserve(static_cast<std::size_t>(nthreads_eff));
+    for (int t = 0; t < nthreads_eff; ++t) pool.emplace_back(worker);
+    for (auto& th : pool) th.join();
+  }
+}
+
+}  // namespace mx::metal
diff --git a/metal/mxcpugrid.h b/metal/mxcpugrid.h
new file mode 100644
index 00000000..e617c6df
--- /dev/null
+++ b/metal/mxcpugrid.h
@@ -0,0 +1,26 @@
+// CPU version of the Metal gridding kernel: same convolution, same centred
+// frame, same normalisation, so a plane gridded on the CPU is bit-comparable
+// (to float32 rounding) with the one the Metal kernel produces.
+//
+// Parallelisation is by output ownership: a thread owns a 32x32 tile and adds
+// only the taps that land inside it, so no atomics and no races. Items are
+// bucketed by the tiles their tap window touches (at most 4, including the
+// periodic wrap at the grid edge) once per plane.
+#ifndef MX_MXCPUGRID_H
+#define MX_MXCPUGRID_H
+
+#include <cstddef>
+
+#include "ducc0/math/gridding_kernel.h"
+
+namespace mx::metal {
+
+// out: 2*grid*grid floats, interleaved re/im, indexed out[2*(cx*grid + cy)].
+// vis: 6 floats per item (base_x, frac_x, base_y, frac_y, re, im) exactly as
+// GridAccumInput::visibilities.
+void cpuGridPlane(const float* vis, std::size_t n_items, std::size_t grid,
+                  const ducc0::PolynomialKernel& kernel, int nthreads, float* out);
+
+}  // namespace mx::metal
+
+#endif  // MX_MXCPUGRID_H
diff --git a/metal/mxvkfft.cpp b/metal/mxvkfft.cpp
new file mode 100644
index 00000000..fb4ac05a
--- /dev/null
+++ b/metal/mxvkfft.cpp
@@ -0,0 +1,137 @@
+// vkFFT wrapper implementation. Pure C++: metal-cpp + vkFFT live here.
+#define NS_PRIVATE_IMPLEMENTATION
+#define MTL_PRIVATE_IMPLEMENTATION
+#define CA_PRIVATE_IMPLEMENTATION
+#include <iostream>  // vkFFT 1.2.31 uses std::cout in its error path
+
+#include "thirdparty/metal-cpp/Foundation/Foundation.hpp"
+#include "thirdparty/metal-cpp/Metal/Metal.hpp"
+#include "thirdparty/metal-cpp/QuartzCore/QuartzCore.hpp"
+
+#define VKFFT_BACKEND 5
+#include "thirdparty/vkFFT.h"
+
+#include "mxvkfft.h"
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+
+namespace mx::vk {
+
+struct Fft::Impl {
+  std::size_t n = 0;
+  MTL::Device* device = nullptr;
+  MTL::CommandQueue* queue = nullptr;
+  MTL::Buffer* buffer = nullptr;
+  VkFFTApplication app = {};
+  bool planned = false;
+  MTL::CommandBuffer* cb = nullptr;
+  std::string error;
+};
+
+Fft::Fft() : impl_(new Impl) {}
+
+Fft::~Fft() {
+  // vkFFT 1.2.31's deleteVkFFT crashes with this metal-cpp pairing, and the
+  // process is exiting or the plan is abandoned; skip it deliberately.
+  if (impl_ != nullptr) {
+    delete impl_;
+  }
+}
+
+bool Fft::init(std::size_t n) {
+  Impl& s = *impl_;
+  s.n = n;
+  s.device = MTL::CreateSystemDefaultDevice();
+  if (s.device == nullptr) {
+    s.error = "no Metal device";
+    return false;
+  }
+  s.queue = s.device->newCommandQueue();
+  if (s.queue == nullptr) {
+    s.error = "no Metal command queue";
+    return false;
+  }
+  const std::size_t bytes = 2 * n * n * sizeof(float);
+  s.buffer = s.device->newBuffer(bytes, MTL::ResourceStorageModeShared);
+  if (s.buffer == nullptr) {
+    s.error = "no shared buffer";
+    return false;
+  }
+  std::memset(s.buffer->contents(), 0, bytes);
+
+  VkFFTConfiguration config = {};
+  config.device = s.device;
+  config.queue = s.queue;
+  config.FFTdim = 2;
+  config.size[0] = n;
+  config.size[1] = n;
+  uint64_t buffer_size = bytes;
+  MTL::Buffer* buf = s.buffer;
+  config.buffer = &buf;
+  config.bufferSize = &buffer_size;
+  // Normalisation is applied by the caller's extract (ducc0's c2c is
+  // unnormalised too), so keep vkFFT's normalize off.
+  config.normalize = 0;
+
+  const VkFFTResult res = initializeVkFFT(&s.app, config);
+  if (res != VKFFT_SUCCESS) {
+    s.error = std::string("initializeVkFFT failed: ") + std::to_string(static_cast<int>(res));
+    return false;
+  }
+  s.planned = true;
+  return true;
+}
+
+float* Fft::data() { return static_cast<float*>(impl_->buffer->contents()); }
+
+std::size_t Fft::n() const { return impl_->n; }
+
+bool Fft::submit() {
+  Impl& s = *impl_;
+  if (!s.planned) return false;
+  // Metal hands back autoreleased command buffers; retain so the lifetime is
+  // deterministic (released in wait()) instead of at some later pool drain.
+  s.cb = s.queue->commandBuffer();
+  if (s.cb == nullptr) {
+    s.error = "no command buffer";
+    return false;
+  }
+  s.cb->retain();
+  MTL::ComputeCommandEncoder* enc = s.cb->computeCommandEncoder();
+  if (enc == nullptr) {
+    s.error = "no compute encoder";
+    return false;
+  }
+  enc->retain();
+  VkFFTLaunchParams launch = {};
+  launch.commandBuffer = s.cb;
+  launch.commandEncoder = enc;
+  MTL::Buffer* buf = s.buffer;
+  launch.buffer = &buf;
+  const VkFFTResult res = VkFFTAppend(&s.app, +1, &launch);  // +1 = inverse
+  enc->endEncoding();
+  enc->release();
+  if (res != VKFFT_SUCCESS) {
+    s.error = std::string("VkFFTAppend failed: ") + std::to_string(static_cast<int>(res));
+    return false;
+  }
+  s.cb->commit();
+  return true;
+}
+
+bool Fft::wait() {
+  Impl& s = *impl_;
+  if (s.cb == nullptr) return true;
+  s.cb->waitUntilCompleted();
+  const bool ok = s.cb->status() == MTL::CommandBufferStatusCompleted;
+  if (!ok) s.error = "command buffer did not complete";
+  s.cb->release();  // pairs with the retain in submit()
+  s.cb = nullptr;
+  return ok;
+}
+
+const char* Fft::error() const { return impl_->error.c_str(); }
+
+}  // namespace mx::vk
diff --git a/metal/mxvkfft.h b/metal/mxvkfft.h
new file mode 100644
index 00000000..9ca89c8f
--- /dev/null
+++ b/metal/mxvkfft.h
@@ -0,0 +1,46 @@
+// vkFFT-backed 2-D complex FFT for the CPU-gridding / GPU-FFT engine.
+//
+// Pure C++ (no Objective-C types leak out): metal-cpp and vkFFT stay inside the
+// .cpp so the rest of the Metal inversion can keep using ARC ObjC++.
+//
+// Memory: the grid lives in an MTLBuffer with MTLResourceStorageModeShared, so
+// the CPU grids straight into the buffer the GPU will read -- no copy.
+#ifndef MX_MXVKFFT_H
+#define MX_MXVKFFT_H
+
+#include <cstddef>
+
+namespace mx::vk {
+
+// One (n x n) complex64 transform, inverse (exp(+2*pi*i)) and unnormalised,
+// which is exactly ducc0's c2c(BACKWARD) that bandedFFT used.
+class Fft {
+ public:
+  Fft();
+  ~Fft();
+  Fft(const Fft&) = delete;
+  Fft& operator=(const Fft&) = delete;
+
+  bool init(std::size_t n);
+
+  // Shared-memory grid: 2*n*n floats, interleaved re/im, layout
+  // g[cx * n + cy] (same as the Metal kernel's output, so no transpose).
+  float* data();
+  std::size_t n() const;
+
+  // Encode + commit without blocking; pair with wait() before reusing data().
+  bool submit();
+  // Block until the last submit() finished. Returns false if the GPU reported
+  // an error (buffer contents are then undefined).
+  bool wait();
+
+  const char* error() const;
+
+ private:
+  struct Impl;
+  Impl* impl_ = nullptr;
+};
+
+}  // namespace mx::vk
+
+#endif  // MX_MXVKFFT_H
