@@ -0,0 +1,126 @@
+// Behavioral execution of unmodified vendor function bodies with CPU doubles.
+// Never a GPU receipt. The real allocator's reservation helper is exercised.
+#include <cassert>
+#include <cmath>
+#include <cstdint>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <set>
+#include <vector>
+#include "mxbudget.h"
+static std::set<void*> host;
+static void* trackedMalloc(size_t n){auto* p=std::malloc(n);if(p)host.insert(p);return p;}
+static void trackedFree(void* p){if(p){assert(host.erase(p)==1);std::free(p);}}
+static int commandAt, encoderAt, errorAt, commands, encoders, commits, waits, active;
+static int initResult, appendResult, liveApps, deletes;
+static std::set<void*> buffers;
+namespace MTL {
+using ResourceOptions=unsigned long;
+constexpr ResourceOptions ResourceStorageModeShared=0,ResourceStorageModePrivate=32;
+enum CommandBufferStatus{CommandBufferStatusCompleted,CommandBufferStatusError};
+struct Buffer {
+ std::vector<unsigned char> data;size_t charge=0;
+ explicit Buffer(size_t n):data(n){buffers.insert(this);}
+ void* contents(){return data.data();}
+ void release(){assert(buffers.erase(this)==1);mx::metal::releaseBytes(charge);delete this;}
+};
+struct Device{Buffer* newBuffer(size_t n,ResourceOptions){return new Buffer(n);}};
+struct BlitCommandEncoder{
+ void copyFromBuffer(Buffer* a,size_t x,Buffer* b,size_t y,size_t n){std::memcpy(b->data.data()+y,a->data.data()+x,n);}
+ void endEncoding(){--active;}
+};
+struct ComputeCommandEncoder{void endEncoding(){--active;}};
+struct CommandBuffer{
+ int id;bool committed=false,waited=false;BlitCommandEncoder blit;ComputeCommandEncoder compute;
+ BlitCommandEncoder* blitCommandEncoder(){if(++encoders==encoderAt)return nullptr;++active;return &blit;}
+ ComputeCommandEncoder* computeCommandEncoder(){if(++encoders==encoderAt)return nullptr;++active;return &compute;}
+ void commit(){assert(!active);committed=true;++commits;}
+ void waitUntilCompleted(){assert(committed);waited=true;++waits;}
+ CommandBufferStatus status(){assert(waited);return id==errorAt?CommandBufferStatusError:CommandBufferStatusCompleted;}
+};
+struct CommandQueue{
+ std::vector<CommandBuffer*> owned;
+ CommandBuffer* commandBuffer(){if(++commands==commandAt)return nullptr;auto* c=new CommandBuffer{};c->id=commands;owned.push_back(c);return c;}
+ void drain(){for(auto* c:owned)delete c;owned.clear();}
+};
+}
+namespace NS{using UInteger=size_t;}
+extern "C" bool mx_metal_track_buffer(void* b,size_t n) noexcept{static_cast<MTL::Buffer*>(b)->charge=n;return true;}
+#include "mxmetalbuffer.h"
+enum VkFFTResult{VKFFT_SUCCESS,VKFFT_ERROR_FAILED_TO_ALLOCATE,VKFFT_ERROR_FAILED_TO_CREATE_COMMAND_LIST,
+ VKFFT_ERROR_FAILED_TO_SYNCHRONIZE,VKFFT_ERROR_MALLOC_FAILED,VKFFT_ERROR_FAILED_TO_COPY};
+struct VkFFTConfiguration{
+ MTL::Device* device{};MTL::CommandQueue* queue{};MTL::Buffer** tempBuffer{};
+ uint64_t *tempBufferSize{},*bufferSize{},*inputBufferSize{};
+ uint64_t size[3]{},FFTdim{},doublePrecision{},doublePrecisionFloatMemory{},useLUT{},registerBoost{},
+ disableReorderFourStep{},fixMinRaderPrimeFFT{},fixMinRaderPrimeMult{},fixMaxRaderPrimeFFT{},fixMaxRaderPrimeMult{},
+ saveApplicationToString{},loadApplicationFromString{},performBandwidthBoost{},considerAllAxesStrided{},userTempBuffer{},
+ tempBufferNum{},isInputFormatted{},makeForwardPlanOnly{},makeInversePlanOnly{},performDCT{};
+ void* loadApplicationString{};
+};
+struct VkFFTApplication{
+ VkFFTConfiguration configuration{};MTL::Buffer *bufferBluestein[3]{},*bufferBluesteinFFT[3]{},*bufferBluesteinIFFT[3]{};
+ uint64_t bufferBluesteinSize[3]{},currentApplicationStringPos{},applicationStringSize{},applicationBluesteinStringSize[3]{},
+ numRaderFFTPrimes{},rader_primes[32]{},rader_buffer_size[32]{},applicationStringOffsetRader{};
+ void *applicationBluesteinString[3]{},*saveApplicationString{},*raderFFTkernel[32]{};
+ MTL::Buffer* local{};
+};
+struct VkFFTPlan{uint64_t actualFFTSizePerAxis[3][3]{},numAxisUploads[3]{},multiUploadR2C{};};
+struct Rader{uint64_t type{},prime{},generator{};void* raderFFTkernel{};};
+struct VkFFTAxis{struct{uint64_t useRader{},numRaderPrimes{};Rader raderContainer[32]{};}specializationConstants;};
+struct VkFFTLaunchParams{MTL::CommandBuffer* commandBuffer{};MTL::ComputeCommandEncoder* commandEncoder{};MTL::Buffer **buffer{},**inputBuffer{};};
+static void deleteVkFFT(VkFFTApplication* a){
+ if(a->local){a->local->release();a->local=nullptr;--liveApps;}
+ ++deletes;
+ for(auto** bs:{a->bufferBluestein,a->bufferBluesteinFFT,a->bufferBluesteinIFFT})for(int i=0;i<3;++i)if(bs[i]){bs[i]->release();bs[i]=nullptr;}
+ for(auto*& p:a->raderFFTkernel)if(p){trackedFree(p);p=nullptr;}
+}
+static VkFFTResult initializeVkFFT(VkFFTApplication* a,VkFFTConfiguration c){
+ a->configuration=c;a->local=mx::metal::newBuffer(c.device,16384,MTL::ResourceStorageModePrivate);++liveApps;
+ if(initResult){deleteVkFFT(a);return VKFFT_ERROR_FAILED_TO_ALLOCATE;}return VKFFT_SUCCESS;
+}
+static VkFFTResult VkFFTAppend(VkFFTApplication*,int,VkFFTLaunchParams*){return appendResult?VKFFT_ERROR_FAILED_TO_ALLOCATE:VKFFT_SUCCESS;}
+#define malloc trackedMalloc
+#define free trackedFree
+#include "vendor_bodies.h"
+#undef malloc
+#undef free
+static int failures=0,cases=0;
+#define EXPECT(x) do{if(!(x)){std::printf("FAIL case=%s line=%d: %s\n",label,__LINE__,#x);++failures;}}while(0)
+int main(){
+ MTL::Device d;MTL::CommandQueue q;
+ // Sweep every synchronous command and encoder in both Bluestein layouts,
+ // Rader preparation, and direct LUT transfer/download.
+ int totals[5]{};
+ for(int mode=0;mode<5;++mode)for(int kind=0;kind<(mode<3?6:4);++kind){
+  int count=kind>=1&&kind<=3?totals[mode]:1;
+  for(int at=1;at<=count;++at){
+   char label[80];std::snprintf(label,sizeof(label),"mode%d/kind%d/at%d",mode,kind,at);++cases;
+   commandAt=kind==1?at:0;encoderAt=kind==2?at:0;errorAt=kind==3?at:0;
+   commands=encoders=commits=waits=active=deletes=0;initResult=kind==4;appendResult=kind==5;
+   VkFFTApplication app{};app.configuration.device=&d;app.configuration.queue=&q;app.configuration.size[0]=17;
+   VkFFTResult result;unsigned char output[128];std::memset(output,0x5a,sizeof(output));
+   if(mode<2){VkFFTPlan plan{};plan.actualFFTSizePerAxis[0][0]=32;plan.numAxisUploads[0]=mode+1;result=VkFFTGeneratePhaseVectors(&app,&plan,0);}
+   else if(mode==2){VkFFTAxis axis{};axis.specializationConstants.useRader=1;axis.specializationConstants.numRaderPrimes=1;axis.specializationConstants.raderContainer[0].prime=17;axis.specializationConstants.raderContainer[0].generator=3;result=VkFFTGenerateRaderFFTKernel(&app,&axis);}
+   else{auto* b=mx::metal::newBuffer(&d,128,MTL::ResourceStorageModePrivate);
+    result=mode==3?VkFFT_transferDataFromCPU(&app,output,&b,128):VkFFT_transferDataToCPU(&app,output,&b,128);b->release();}
+   if(kind==0){totals[mode]=commands;EXPECT(result==VKFFT_SUCCESS);}
+   else if((kind<=3)||(mode<3)){
+    EXPECT(result==(kind==3?VKFFT_ERROR_FAILED_TO_SYNCHRONIZE:kind<=2?VKFFT_ERROR_FAILED_TO_CREATE_COMMAND_LIST:VKFFT_ERROR_FAILED_TO_ALLOCATE));
+    if(kind<=3){EXPECT(commands==at);EXPECT(waits==(kind==3?at:at-1));}
+    if(kind==3&&mode==4)for(auto v:output)EXPECT(v==0x5a);
+   }
+   EXPECT(active==0);EXPECT(commits==waits);EXPECT(liveApps==0);
+   // initialize owns cleanup on failure; successful local apps delete once.
+   if(mode<3)EXPECT(deletes==1);
+   deleteVkFFT(&app);q.drain();EXPECT(mx::metal::budgetStats().used==0);EXPECT(host.empty());
+   std::printf("case=%s result=%d commands=%d waits=%d live_apps=%d host_allocs=%zu reserved=%zu\n",label,int(result),commands,waits,liveApps,host.size(),mx::metal::budgetStats().used);
+   // Keep failures independent in RED runs, after recording leaked ownership.
+   while(!buffers.empty())static_cast<MTL::Buffer*>(*buffers.begin())->release();
+   while(!host.empty())trackedFree(*host.begin());liveApps=0;
+  }
+ }
+ std::printf("%s CPU vendor behavioral cases=%d failures=%d (Metal/compiler doubles; no GPU)\n",failures?"FAIL":"PASS",cases,failures);
+ return failures?1:0;
+}
