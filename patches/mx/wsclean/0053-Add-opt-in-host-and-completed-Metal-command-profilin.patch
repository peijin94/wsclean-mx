 extern "C" int mx_convolve_c2r(float* image,const std::complex<float>* product,size_t w,size_t h){
   if(disabled())return 0;
   if(!image||!product||!w||!h||w%2)return refuse("unsupported single C2R input");
   // Opt-in compatibility adapter; multiscale uses the single shared batch above.
+  mx::profile::Context profile;
+  profile.id=mx::profile::nextId();profile.w=w;profile.h=h;profile.batch=1;
+  mx::profile::Span total("convolution.total",profile);total.ok=false;
   thread_local std::unique_ptr<mx::vk::Fft> plan;
   if(!plan||plan->width()!=w||plan->height()!=h){
+    mx::profile::Span miss("convolution.plan_miss",profile);miss.ok=false;
     plan=std::make_unique<mx::vk::Fft>();
+    plan->profileOwner(profile.id);
     if(!plan->initReal(w,h)){int r=refuse(plan->error());plan.reset();return r;}
+    miss.ok=true;
   }
   const size_t pitch=plan->rowFloats();
+  plan->profileOwner(profile.id);
+  auto copy_context=profile;copy_context.bytes=pitch*h*sizeof(float);
+  mx::profile::Span input_copy("convolution.copy_inputs",copy_context);
   std::memcpy(plan->data(),product,pitch*h*sizeof(float));
+  input_copy.finish();
   if(!plan->submit()||!plan->wait())return refuse(plan->error());
+  copy_context.bytes=w*h*sizeof(float);
+  mx::profile::Span output_copy("convolution.copy_output",copy_context);
   for(size_t y=0;y<h;++y)std::memcpy(image+y*w,plan->data()+y*pitch,w*sizeof(float));
+  output_copy.finish();
   ++singles;
+  total.ok=true;
   return 1;
 }
