 #include "algorithms/deconvolution_algorithm.h"
 
 using aocommon::Image;
 
 namespace radler::algorithms {
+namespace {
+struct alignas(64) ChunkPeak {
+  size_t index;
+  float value;
+};
+
+void SubtractPsf(float* image, const float* psf, float psf_factor,
+                 const std::pair<uint32_t, uint32_t>* positions, size_t start,
+                 size_t end, size_t x, size_t y, size_t width, size_t height) {
+#pragma GCC unroll 8
+  for (size_t px = start; px != end; ++px) {
+    const int psf_x = positions[px].first - x + width / 2;
+    const int psf_y = positions[px].second - y + height / 2;
+    if (psf_x >= 0 && psf_x < static_cast<int>(width) && psf_y >= 0 &&
+        psf_y < static_cast<int>(height)) {
+      image[px] -= psf[psf_x + psf_y * width] * psf_factor;
+    }
+  }
+}
+
+/**
+ * Updates @p peak to the first pixel in [start, end) with a value larger than
+ * peak.value and larger than or equal to all other values, like a sequential
+ * scan with a strict comparison would. The maximum is found over independent
+ * lanes first, because a single running maximum is a serial dependency chain.
+ */
+template <bool AllowNegatives, bool HasRmsFactor>
+void FindChunkPeak(const float* image, const float* rms_factor, size_t start,
+                   size_t end, ChunkPeak& peak) {
+  const auto value = [&](size_t px) {
+    const float v = HasRmsFactor ? image[px] * rms_factor[px] : image[px];
+    return AllowNegatives ? std::fabs(v) : v;
+  };
+  constexpr size_t kLanes = 16;
+  float lanes[kLanes];
+  std::fill_n(lanes, kLanes, peak.value);
+  size_t px = start;
+  for (; px + kLanes <= end; px += kLanes) {
+    for (size_t lane = 0; lane != kLanes; ++lane) {
+      const float v = value(px + lane);
+      lanes[lane] = v > lanes[lane] ? v : lanes[lane];
+    }
+  }
+  float best = peak.value;
+  for (size_t lane = 0; lane != kLanes; ++lane) {
+    best = lanes[lane] > best ? lanes[lane] : best;
+  }
+  for (; px != end; ++px) {
+    const float v = value(px);
+    best = v > best ? v : best;
+  }
+  if (best > peak.value) {
+    px = start;
+    while (value(px) != best) ++px;
+    peak.index = px;
+    peak.value = best;
+  }
+}
+}  // namespace
 
