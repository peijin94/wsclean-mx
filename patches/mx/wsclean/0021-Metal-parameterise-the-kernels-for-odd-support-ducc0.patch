Date: Mon, 19 Oct 2026 15:19:19 -0400
Subject: [PATCH 21/33] Metal: parameterise the kernels for odd support (ducc0
 selects W=7)

The cost-model fix moved the geometry to supp 7 / nu 378 / nplanes 125, which
exposed two hardcoded assumptions: gridAccumulate validated support%2==0, and
the MSL kernels baked in kSupport=6 / kHalfSupport=3. Now the constants are
substituted per call (mslSource(support)) and the window anchor is
kLowestOffset=(W-1)/2, correct for both parities: W=6 -> -2..+3, W=7 -> -3..+3.

diff --git a/metal/metaldevice.mm b/metal/metaldevice.mm
index 582215e9..a1feba73 100644
--- a/metal/metaldevice.mm
+++ b/metal/metaldevice.mm
@@ -23,6 +23,30 @@
   throw std::runtime_error("mx::metal: " + message);
 }
 
+std::string replaceAll(std::string text, const std::string& from, const std::string& to) {
+  std::size_t pos = 0;
+  while ((pos = text.find(from, pos)) != std::string::npos) {
+    text.replace(pos, from.size(), to);
+    pos += to.size();
+  }
+  return text;
+}
+
+// The MSL kernels are compiled from a source string, so the support constants
+// are substituted per call. ducc0's cost model selects odd supports too (W=7 for
+// a small field with w-gridding), and a W=6-hardcoded kernel silently produced a
+// decorrelated image.
+std::string mslSource(std::size_t support) {
+  std::string source = kGridAccumulateMSL;
+  source = replaceAll(source, "constant uint kSupport = 6;",
+                      "constant uint kSupport = " + std::to_string(support) + ";");
+  source = replaceAll(source, "constant int kHalfSupport = 3;",
+                      "constant int kHalfSupport = " + std::to_string(support / 2) + ";");
+  source = replaceAll(source, "constant int kLowestOffset = 2;",
+                      "constant int kLowestOffset = " + std::to_string((support - 1) / 2) + ";");
+  return source;
+}
+
 std::string nsString(NSString* string) {
   if (string == nil) return {};
   const char* utf8 = [string UTF8String];
@@ -51,8 +75,12 @@ TileBuckets bucketVisibilities(const GridAccumInput& input, std::size_t tile) {
   if (input.grid_size == 0 || input.grid_size % tile != 0) {
     fail("grid size must be a positive multiple of the tile size");
   }
-  if (input.support == 0 || input.support % 2 != 0) {
-    fail("support must be a positive even number");
+  // ducc0's cost model sometimes selects an ODD support (e.g. W=7 for a small
+  // field with w-gridding), so odd counts must be allowed: the window is
+  // (-W/2, W/2] with floor anchoring, which is well defined for odd W, and the
+  // shader evaluates poly_sample at continuous arguments.
+  if (input.support < 2) {
+    fail("support must be at least 2");
   }
   if (input.visibilities.size() % 4 != 0) {
     fail("visibility array must hold four floats per visibility");
@@ -174,8 +202,9 @@ GridAccumResult gridAccumulate(const GridAccumInput& input) {
     const std::size_t tiles = tiles_per_row * tiles_per_row;
 
     NSError* error = nil;
+    const std::string metal_source = mslSource(input.support);
     id<MTLLibrary> library =
-        [device newLibraryWithSource:[NSString stringWithUTF8String:kGridAccumulateMSL]
+        [device newLibraryWithSource:[NSString stringWithUTF8String:metal_source.c_str()]
                              options:nil
                                error:&error];
     if (library == nil) fail("kernel compilation failed: " + nsString([error localizedDescription]));
@@ -349,8 +378,9 @@ DegridResult gridDegrid(const std::vector<float>& u_v, const std::vector<float>&
 
     const std::size_t count = u_v.size() / 4;
     NSError* error = nil;
+    const std::string metal_source = mslSource(support);
     id<MTLLibrary> library =
-        [device newLibraryWithSource:[NSString stringWithUTF8String:kGridAccumulateMSL]
+        [device newLibraryWithSource:[NSString stringWithUTF8String:metal_source.c_str()]
                              options:nil
                                error:&error];
     if (library == nil) fail("kernel compilation failed: " + nsString([error localizedDescription]));
@@ -424,8 +454,9 @@ KernelProbeResult evalEsKernel(const std::vector<float>& arguments, float suppor
     if (arguments.empty()) return {};
 
     NSError* error = nil;
+    const std::string metal_source = mslSource(static_cast<std::size_t>(support));
     id<MTLLibrary> library =
-        [device newLibraryWithSource:[NSString stringWithUTF8String:kGridAccumulateMSL]
+        [device newLibraryWithSource:[NSString stringWithUTF8String:metal_source.c_str()]
                              options:nil
                                error:&error];
     if (library == nil) fail("kernel compilation failed: " + nsString([error localizedDescription]));
diff --git a/metal/mxshaders.h b/metal/mxshaders.h
