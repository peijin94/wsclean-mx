index 51300d6c..d8de9d83 100644
--- a/metal/CMakeLists.txt
+++ b/metal/CMakeLists.txt
@@ -19,7 +19,8 @@ set_source_files_properties(metaldevice.mm metalinversion.mm PROPERTIES COMPILE_
 
 find_library(MX_METAL_FRAMEWORK Metal REQUIRED)
 find_library(MX_FOUNDATION_FRAMEWORK Foundation REQUIRED)
-target_link_libraries(mx-metal PUBLIC ${MX_METAL_FRAMEWORK} ${MX_FOUNDATION_FRAMEWORK})
+find_library(MX_ACCELERATE_FRAMEWORK Accelerate REQUIRED)
+target_link_libraries(mx-metal PUBLIC ${MX_METAL_FRAMEWORK} ${MX_FOUNDATION_FRAMEWORK} ${MX_ACCELERATE_FRAMEWORK})
 
