   bool init(std::size_t n);
 
+  // Batched variant: B independent (n x n) transforms in one plan/call.
+  // Buffer holds B planes back-to-back (plane b at data() + b*2*n*n).
+  // Used for the 8-scale multiscale batch: one GPU call for all scales.
+  bool initBatched(std::size_t n, std::size_t batch);
+
   // Shared-memory grid: 2*n*n floats, interleaved re/im, layout
