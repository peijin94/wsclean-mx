diff --git a/cpp/math/rms_image.cc b/cpp/math/rms_image.cc
index dcd9381..3a19b2f 100644
--- a/cpp/math/rms_image.cc
+++ b/cpp/math/rms_image.cc
@@ -33,20 +33,29 @@ void Make(Image& rms_output, const Image& input_image, double window_size,
 }
 
 void SlidingMinimum(Image& output, const Image& input, size_t window_size) {
+  const size_t radius = window_size / 2;
+  if (radius == 0 || input.Empty()) {
+    output = Image(input);
+    return;
+  }
   const size_t width = input.Width();
-  output = Image(width, input.Height());
-  Image temp(output);
+  Image result(width, input.Height());
+  Image temp(width, input.Height());
 
   schaapcommon::StaticFor<size_t> loop;
+  // Order NaNs after all numbers, so a window is NaN only if all values are.
+  const auto less = [](float lhs, float rhs) {
+    return lhs < rhs || (std::isnan(rhs) && !std::isnan(lhs));
+  };
 
   loop.Run(0, input.Height(), [&](size_t yStart, size_t yEnd) {
     for (size_t y = yStart; y != yEnd; ++y) {
       float* outRowptr = &temp[y * width];
       const float* inRowptr = &input[y * width];
       for (size_t x = 0; x != width; ++x) {
-        size_t left = std::max(x, window_size / 2) - window_size / 2;
-        size_t right = std::min(x, width - window_size / 2) + window_size / 2;
-        outRowptr[x] = *std::min_element(inRowptr + left, inRowptr + right);
+        const size_t left = x - std::min(x, radius);
+        const size_t right = x + std::min(width - x, radius);
+        outRowptr[x] = *std::min_element(inRowptr + left, inRowptr + right, less);
       }
     }
   });
@@ -55,17 +64,17 @@ void SlidingMinimum(Image& output, const Image& input, size_t window_size) {
     aocommon::UVector<float> vals;
     for (size_t x = xStart; x != xEnd; ++x) {
       for (size_t y = 0; y != input.Height(); ++y) {
-        size_t top = std::max(y, window_size / 2) - window_size / 2;
-        size_t bottom =
-            std::min(y, input.Height() - window_size / 2) + window_size / 2;
+        const size_t top = y - std::min(y, radius);
+        const size_t bottom = y + std::min(input.Height() - y, radius);
         vals.clear();
         for (size_t winY = top; winY != bottom; ++winY) {
           vals.push_back(temp[winY * width + x]);
         }
-        output[y * width + x] = *std::min_element(vals.begin(), vals.end());
+        result[y * width + x] = *std::min_element(vals.begin(), vals.end(), less);
       }
     }
   });
+  output = std::move(result);
 }
 
 void SlidingMaximum(Image& output, const Image& input, size_t window_size) {
diff --git a/cpp/math/rms_image.h b/cpp/math/rms_image.h
index 2d5e254..451123b 100644
--- a/cpp/math/rms_image.h
+++ b/cpp/math/rms_image.h
@@ -12,9 +12,20 @@ void Make(aocommon::Image& rms_output, const aocommon::Image& input_image,
           long double beam_pa, long double pixel_scale_l,
           long double pixel_scale_m);
 
+/**
+ * Compute local minima over clipped half-open rectangles
+ * [x-r, x+r) x [y-r, y+r), where r = floor(window_size / 2).
+ * Thus odd sizes have the same footprint as the preceding even size. Sizes
+ * zero and one copy the input unchanged. Oversized windows are clipped without
+ * wrapping; empty images retain their dimensions. NaNs are ignored in each
+ * nondegenerate window unless every value is NaN. Infinities participate
+ * normally, and equal values retain the first row-major value (including its
+ * zero sign). Output may alias input, including through an image view.
+ */
 void SlidingMinimum(aocommon::Image& output, const aocommon::Image& input,
                     size_t window_size);
 
+/** Compute local maxima with the same window, NaN and aliasing rules. */
 void SlidingMaximum(aocommon::Image& output, const aocommon::Image& input,
                     size_t window_size);
 
