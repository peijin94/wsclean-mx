@@ -0,0 +1,31 @@
+"""Source-only checks for native cleanup/scope when no device is available.
+These are NOT GPU validation; failure_probe and fusion probes are native gates.
+"""
+from pathlib import Path
+import re
+root = Path(__file__).resolve().parent
+vk = (root / 'thirdparty/vkFFT.h').read_text()
+phase = vk[vk.index('static inline VkFFTResult VkFFTGeneratePhaseVectors('):]
+phase = phase[:phase.index('#ifdef VkFFT_use_FP128_Bluestein_RaderFFT')]
+checks = []
+for name in ('bufferBluestein', 'bufferBluesteinFFT', 'bufferBluesteinIFFT'):
+    checks.append((f'immediate {name} refusal', bool(re.search(
+        rf'app->{name}\[axis_id\] = mx::metal::newBuffer[^;]+;\s*if \(!app->{name}\[axis_id\]\) return VKFFT_ERROR_FAILED_TO_ALLOCATE;', phase))))
+for start in ['VkFFTGeneratePhaseVectors(', 'VkFFTGenerateRaderFFTKernel(']:
+    # Inspect only Metal planning blocks that create a compute encoder.
+    section = vk[vk.index('static inline VkFFTResult '+start):]
+    end = section.find('\nstatic inline ', 1)
+    if end != -1:
+        section = section[:end]
+    encoders = list(re.finditer(r'MTL::ComputeCommandEncoder\* commandEncoder = mx::metal::preparationEncoder\([^;]+;', section))
+    checks.append((f'preparation encoder sites {start}', len(encoders) == (3 if start == 'VkFFTGeneratePhaseVectors(' else 1)))
+    for i, match in enumerate(encoders):
+        tail = section[match.end():]
+        tail = tail[:tail.index('commandBuffer->commit();')]
+        checks.append((f'encoder guard {start} #{i}', 'EncoderScope' in tail and bool(re.search(r'if \(resFFT != VKFFT_SUCCESS\) \{\s*encoder_scope.end\(\);', tail))))
+cc = (root / '../../radler/cpp/algorithms/multiscale/multiscale_transforms.cc').resolve().read_text()
+setter = cc[cc.index('void MultiScaleTransforms::SetFusedTransformHook'):cc.index('bool MultiScaleTransforms::HasFusedTransformHook')]
+checks.append(('ARM scalar-only hook registration', '#if defined(__aarch64__) && !defined(__AVX__) && !defined(__SSE__)' in setter))
+for name, ok in checks:
+    print(('PASS ' if ok else 'FAIL ') + name)
+raise SystemExit(0 if all(ok for _, ok in checks) else 1)
