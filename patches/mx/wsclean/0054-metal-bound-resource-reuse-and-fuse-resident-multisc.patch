+// Execute the real probe's main body against a strict CPU Metal-contract double.
+// This enforces blit alignment and models retain/release; native receipts remain
+// necessary for actual driver lifetime behavior and allocatedSize observations.
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <stdexcept>
+#include <vector>
+#include "mxbudget.h"
+namespace NS{
+using UInteger=size_t;
+struct Range{size_t location,length;Range(size_t x,size_t n):location(x),length(n){}};
+struct AutoreleasePool{
+ static inline AutoreleasePool* current=nullptr;
+ std::vector<void*> commands;
+ static AutoreleasePool* alloc(){return new AutoreleasePool;}
+ AutoreleasePool* init(){assert(!current);current=this;return this;}
+ void release();
+};
+}
+namespace MTL{
+using ResourceOptions=unsigned long;
+constexpr ResourceOptions ResourceStorageModeShared=0,ResourceStorageModePrivate=32;
+enum CommandBufferStatus{CommandBufferStatusCompleted};
+struct Buffer{
+ size_t n,charge=0;int refs=1;explicit Buffer(size_t bytes):n(bytes){}
+ size_t allocatedSize(){return n;}
+ void* contents(){return nullptr;}
+ void retain(){++refs;}
+ void release(){if(!--refs){mx::metal::releaseBytes(charge);delete this;}}
+};
+struct SharedEvent{
+ uint64_t value=0;
+ void setSignaledValue(uint64_t v){value=v;}
+ void release(){delete this;}
+};
+struct CommandBuffer;
+struct BlitCommandEncoder{
+ CommandBuffer* command;
+ void fillBuffer(Buffer* b,NS::Range r,unsigned char);
+ void endEncoding();
+};
+struct ComputeCommandEncoder{void endEncoding(){}};
+struct CommandBuffer{
+ int refs=1;bool encoding=false,committed=false,waited=false;
+ SharedEvent* event=nullptr;uint64_t eventValue=0;
+ std::vector<Buffer*> retained;BlitCommandEncoder blit{this};
+ void retain(){++refs;}
+ void release(){if(!--refs){for(auto* b:retained)b->release();delete this;}}
+ void encodeWait(SharedEvent* e,uint64_t v){event=e;eventValue=v;}
+ BlitCommandEncoder* blitCommandEncoder(){assert(!encoding);encoding=true;return &blit;}
+ ComputeCommandEncoder* computeCommandEncoder(){return nullptr;}
