+// SPDX-License-Identifier: GPL-3.0-or-later
+#include "mxbudget.h"
+#import <Foundation/Foundation.h>
+#import <objc/runtime.h>
+@interface MXMetalBudgetToken : NSObject
+@property(nonatomic) std::size_t bytes;
+@end
+@implementation MXMetalBudgetToken
+- (void)dealloc { mx::metal::releaseBytes(_bytes); }
+@end
+extern "C" bool mx_metal_track_buffer(void* buffer, std::size_t bytes) noexcept {
+  @try {
+    MXMetalBudgetToken* token=[MXMetalBudgetToken new];
+    if(!token)return false;
+    static char key;
+    objc_setAssociatedObject((__bridge id)buffer,&key,token,OBJC_ASSOCIATION_RETAIN_NONATOMIC);
+    token.bytes=bytes;
+    return true;
+  } @catch(NSException*) { return false; }
+}
