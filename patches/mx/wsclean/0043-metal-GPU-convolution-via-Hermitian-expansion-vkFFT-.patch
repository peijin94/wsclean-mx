diff --git a/metal/dbg_r2c.cpp b/metal/dbg_r2c.cpp
new file mode 100644
index 00000000..829343f3
--- /dev/null
+++ b/metal/dbg_r2c.cpp
@@ -0,0 +1,66 @@
+#define NS_PRIVATE_IMPLEMENTATION
+#define MTL_PRIVATE_IMPLEMENTATION
+#define CA_PRIVATE_IMPLEMENTATION
+#include <iostream>
+#include "thirdparty/metal-cpp/Foundation/Foundation.hpp"
+#include "thirdparty/metal-cpp/Metal/Metal.hpp"
+#include "thirdparty/metal-cpp/QuartzCore/QuartzCore.hpp"
+#define VKFFT_BACKEND 5
+#include "thirdparty/vkFFT.h"
+#include <complex>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+#include "ducc0/fft/fft.h"
+#include "ducc0/fft/fftnd_impl.h"
+#include "ducc0/infra/mav.h"
+int main() {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  const size_t w=8,h=8,cw=w/2+1;
+  MTL::Device* device = MTL::CreateSystemDefaultDevice();
+  MTL::CommandQueue* queue = device->newCommandQueue();
+  MTL::Buffer* cbuf = device->newBuffer(h*cw*sizeof(std::complex<float>), MTL::ResourceStorageModeShared);
+  MTL::Buffer* rbuf = device->newBuffer(h*w*sizeof(float), MTL::ResourceStorageModeShared);
+  std::vector<std::complex<float>> host(h*cw, {0,0});
+  host[0] = {1.0f, 0.0f};
+  std::memcpy(cbuf->contents(), host.data(), h*cw*sizeof(std::complex<float>));
+  std::memset(rbuf->contents(), 0, h*w*sizeof(float));
+  std::vector<std::complex<float>> hm = host;
+  std::vector<float> ref(h*w, 0);
+  { ducc0::vfmav<std::complex<float>> in(hm.data(), {h, cw});
+    ducc0::vfmav<float> out(ref.data(), {h, w});
+    ducc0::c2r_mut(in, out, {0,1}, false, 1.0f, 1); }
+  printf("CPU ref[0..7]:");
+  for (int i=0;i<8;i++) printf(" %.4g", ref[i]);
+  printf("\nCPU ref row1[0..3]: %.4g %.4g %.4g %.4g\n", ref[w], ref[w+1], ref[w+2], ref[w+3]);
+  VkFFTApplication app = {};
+  VkFFTConfiguration config = {};
+  config.device = device; config.queue = queue;
+  config.FFTdim = 2; config.size[0]=w; config.size[1]=h;
+  config.performR2C=1; config.normalize=0;
+  config.isInputFormatted=1;
+  MTL::Buffer* bp=rbuf; MTL::Buffer* ip=cbuf;
+  uint64_t bs=h*w*sizeof(float), is=h*cw*sizeof(std::complex<float>);
+  config.buffer=&bp; config.bufferSize=&bs;
+  config.inputBuffer=&ip; config.inputBufferSize=&is;
+  VkFFTResult res = initializeVkFFT(&app, config);
+  printf("init=%d\n", (int)res);
+  if (res!=VKFFT_SUCCESS) return 1;
+  MTL::CommandBuffer* cb = queue->commandBuffer(); cb->retain();
+  MTL::ComputeCommandEncoder* enc = cb->computeCommandEncoder(); enc->retain();
+  VkFFTLaunchParams lp={};
+  lp.commandBuffer=cb; lp.commandEncoder=enc;
+  MTL::Buffer* b=rbuf; MTL::Buffer* ib=cbuf;
+  lp.buffer=&b; lp.inputBuffer=&ib;
+  res = VkFFTAppend(&app, +1, &lp);
+  enc->endEncoding(); enc->release();
+  printf("append=%d\n",(int)res);
+  cb->commit(); cb->waitUntilCompleted();
+  printf("status=%d\n",(int)cb->status());
+  cb->release();
+  const float* gpu=(const float*)rbuf->contents();
+  printf("GPU [0..7]:");
+  for(int i=0;i<8;i++) printf(" %.4g", gpu[i]);
+  printf("\nGPU row1[0..3]: %.4g %.4g %.4g %.4g\n", gpu[w], gpu[w+1], gpu[w+2], gpu[w+3]);
+  return 0;
+}
diff --git a/metal/expand_gpu_test.cpp b/metal/expand_gpu_test.cpp
new file mode 100644
index 00000000..1fc234b6
--- /dev/null
+++ b/metal/expand_gpu_test.cpp
@@ -0,0 +1,49 @@
+// GPU chain for deconv convolution: half -> full (CPU) + vkFFT c2c inverse,
+// must equal ducc0 c2r_mut. Reuses the proven mx::vk::Fft wrapper.
+#include <complex>
+#include <cstdio>
+#include <cmath>
+#include <cstring>
+#include <vector>
+#include <random>
+#include "ducc0/fft/fft.h"
+#include "ducc0/fft/fftnd_impl.h"
+#include "ducc0/infra/mav.h"
+#include "metal/mxvkfft.h"
+int main(int argc, char** argv) {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  const size_t n = argc>1 ? std::stoul(argv[1]) : 1024;
+  const size_t w=n,h=n,cw=w/2+1;
+  const int nthreads = argc>2 ? std::stoi(argv[2]) : 8;
+  std::mt19937 rng(7);
+  std::vector<std::complex<float>> half(h*cw);
+  for (auto& v: half) v={float(rng()%1000)/1000-0.5f, float(rng()%1000)/1000-0.5f};
+  std::vector<std::complex<float>> hm=half;
+  std::vector<float> ref(h*w,0);
+  { ducc0::vfmav<std::complex<float>> in(hm.data(),{h,cw});
+    ducc0::vfmav<float> out(ref.data(),{h,w});
+    ducc0::c2r_mut(in,out,{0,1},false,1.0f,nthreads); }
+  // expand
+  std::vector<std::complex<float>> full(h*w);
+  for(size_t i=0;i<h;i++) for(size_t j=0;j<w;j++) {
+    if(j<cw) full[i*w+j]=half[i*cw+j];
+    else { size_t si=(h-i)%h, sj=w-j; full[i*w+j]=std::conj(half[si*cw+sj]); }
+  }
+  mx::vk::Fft fft;
+  if(!fft.init(n)) { printf("fft init failed: %s\n", fft.error()); return 1; }
+  std::memcpy(fft.data(), full.data(), 2*h*w*sizeof(float));
+  auto t0 = std::chrono::steady_clock::now();
+  if(!fft.submit()||!fft.wait()) { printf("fft failed: %s\n", fft.error()); return 1; }
+  auto t1 = std::chrono::steady_clock::now();
+  const float* gpu = fft.data();
+  double num=0,den=0,md=0,ma=0;
+  for(size_t i=0;i<h*w;i++){
+    double a=gpu[2*i], b=ref[i];
+    num+=(a-b)*(a-b); den+=b*b; md=std::max(md,std::fabs(a-b)); ma=std::max(ma,std::fabs(b));
+  }
+  double rel=sqrt(num/(den+1e-30));
+  double ms=std::chrono::duration<double,std::milli>(t1-t0).count();
+  printf("n=%zu rel_rms=%.3e max_abs=%.4g max_diff=%.4g gpu_ms=%.1f %s\n",
+         n, rel, ma, md, ms, rel<5e-6?"PASS":"FAIL");
+  return rel<5e-6?0:1;
+}
diff --git a/metal/expand_test.cpp b/metal/expand_test.cpp
new file mode 100644
index 00000000..133f5ffe
--- /dev/null
+++ b/metal/expand_test.cpp
@@ -0,0 +1,50 @@
+// CPU-only: half-spectrum -> full via Hermitian symmetry, then c2c inverse,
+// must equal ducc0 c2r. Validates the expansion before any GPU is involved.
+#include <complex>
+#include <cstdio>
+#include <cmath>
+#include <vector>
+#include <random>
+#include "ducc0/fft/fft.h"
+#include "ducc0/fft/fftnd_impl.h"
+#include "ducc0/infra/mav.h"
+int main() {
+  const size_t w=32,h=32,cw=w/2+1;
+  std::mt19937 rng(7);
+  std::vector<std::complex<float>> half(h*cw);
+  for (auto& v: half) v={float(rng()%1000)/1000-0.5f, float(rng()%1000)/1000-0.5f};
+  // enforce Hermitian consistency as a true r2c output would have?
+  // (skip - use as-is; c2r of inconsistent half is still well-defined)
+  std::vector<std::complex<float>> hm=half;
+  std::vector<float> ref(h*w,0);
+  { ducc0::vfmav<std::complex<float>> in(hm.data(),{h,cw});
+    ducc0::vfmav<float> out(ref.data(),{h,w});
+    ducc0::c2r_mut(in,out,{0,1},false,1.0f,1); }
+  // expand to full
+  std::vector<std::complex<float>> full(h*w);
+  for(size_t i=0;i<h;i++) for(size_t j=0;j<w;j++) {
+    if(j<cw) full[i*w+j]=half[i*cw+j];
+    else {
+      size_t si=(h-i)%h, sj=w-j;
+      full[i*w+j]=std::conj(half[si*cw+sj]);
+    }
+  }
+  std::vector<std::complex<float>> fm=full;
+  { ducc0::vfmav<std::complex<float>> io(fm.data(),{h,w});
+    ducc0::detail_fft::c2c(io,io,{0},false,1.0f,1);
+    ducc0::detail_fft::c2c(io,io,{1},false,1.0f,1); }
+  // c2c inverse of full should give real=ref*w? or ref? check scale
+  double num=0,den=0;
+  // try both scales: /1 and /w? Actually c2c unnormalized vs c2r unnormalized may differ by factor
+  // first compare shapes: imag should be ~0
+  double imax=0;
+  for(auto& v: fm) imax=std::max(imax,(double)std::abs(v.imag()));
+  printf("max imag after c2c: %.4g\n", imax);
+  // find best scale
+  for(float s : {1.0f, 1.0f/(w*h)}) {
+    num=0;den=0;
+    for(size_t i=0;i<h*w;i++){ double a=fm[i].real()*s, b=ref[i]; num+=(a-b)*(a-b); den+=b*b; }
+    printf("scale %.4g rel=%.4e\n", s, sqrt(num/(den+1e-30)));
+  }
+  return 0;
+}
diff --git a/metal/mxconvolve.cpp b/metal/mxconvolve.cpp
new file mode 100644
index 00000000..a49ecc29
--- /dev/null
+++ b/metal/mxconvolve.cpp
@@ -0,0 +1,62 @@
+// GPU c2r for the multiscale convolution: Hermitian expansion + vkFFT c2c.
+#include "metal/mxconvolve.h"
+
+#include <complex>
+#include <cstddef>
+#include <cstdlib>
+#include <memory>
+
+#include "metal/mxvkfft.h"
+
+extern "C" int mx_convolve_c2r(float* image, const std::complex<float>* product,
+                                std::size_t width, std::size_t height) {
+  if (std::getenv("MX_METAL_NO_CONVOLVE") != nullptr) return 0;
+  if (width != height || width == 0 || (width % 2) != 0) return 0;
+  const std::size_t n = width;
+  const std::size_t cw = n / 2 + 1;
+
+  // One plan per thread; FindMultiScalePeak calls per scale in parallel.
+  // A run uses a single image size, so one cached plan suffices (re-init
+  // if the size ever changes).
+  thread_local std::unique_ptr<mx::vk::Fft> plan;
+  thread_local std::size_t planned_n = 0;
+  if (plan == nullptr || planned_n != n) {
+    plan = std::make_unique<mx::vk::Fft>();
+    if (!plan->init(n)) {
+      plan.reset();
+      planned_n = 0;
+      return 0;
+    }
+    planned_n = n;
+  }
+  mx::vk::Fft& fft = *plan;
+
+  // Expand half -> full straight into the shared GPU buffer (no extra copy).
+  // Full[i][j] = half[i][j] for j <= n/2, else conj(half[(n-i)%n][n-j]).
+  // Validated CPU-only to 8.2e-08 against ducc0 c2r_mut at 32^2, and the
+  // GPU chain to 3.0e-07 at 1024 / 5.1e-07 at 3072.
+  float* buf = fft.data();
+  if (buf == nullptr) return 0;
+  for (std::size_t i = 0; i < n; ++i) {
+    const std::complex<float>* hrow = product + i * cw;
+    float* brow = buf + 2 * i * n;
+    for (std::size_t j = 0; j <= n / 2; ++j) {
+      brow[2 * j] = hrow[j].real();
+      brow[2 * j + 1] = hrow[j].imag();
+    }
+    const std::size_t si = (n - i) % n;
+    const std::complex<float>* srow = product + si * cw;
+    for (std::size_t j = n / 2 + 1; j < n; ++j) {
+      const std::complex<float> v = srow[n - j];
+      brow[2 * j] = v.real();
+      brow[2 * j + 1] = -v.imag();
+    }
+  }
+
+  if (!fft.submit() || !fft.wait()) return 0;
+
+  // Extract the real part; imag is ~0 for Hermitian-consistent input.
+  const float* out = fft.data();
+  for (std::size_t k = 0; k < n * n; ++k) image[k] = out[2 * k];
+  return 1;
+}
diff --git a/metal/mxconvolve.h b/metal/mxconvolve.h
new file mode 100644
index 00000000..41de50a7
--- /dev/null
+++ b/metal/mxconvolve.h
@@ -0,0 +1,27 @@
+// GPU inverse half-spectrum transform for schaapcommon's convolution.
+//
+// schaapcommon::math::ConvolveTransformed does a frequency-domain multiply
+// then ducc0::c2r_mut (half-spectrum -> real image). This hook replaces the
+// c2r with: Hermitian expansion half -> full on the CPU (validated to 8e-08
+// against ducc0) + the proven vkFFT c2c inverse (3.0e-07 at 1024, 5.1e-07
+// at 3072). Square images only; anything else returns 0 for CPU fallback.
+//
+// Thread safety: FindMultiScalePeak calls per scale in parallel, so plans
+// are thread_local (one vkFFT plan + buffers per thread per size).
+#ifndef MX_MXCONVOLVE_H
+#define MX_MXCONVOLVE_H
+
+#include <complex>
+#include <cstddef>
+
+extern "C" {
+
+// Replaces ducc0::c2r_mut(product -> image). Product is the already-scaled
+// half-spectrum (fact * kernel folded in), read-only. Returns 1 when the
+// GPU path ran, 0 to fall back to the CPU.
+int mx_convolve_c2r(float* image, const std::complex<float>* product, std::size_t width,
+                     std::size_t height);
+
+}  // extern "C"
+
+#endif  // MX_MXCONVOLVE_H
diff --git a/metal/time_c2r.cpp b/metal/time_c2r.cpp
new file mode 100644
index 00000000..bf53015b
--- /dev/null
+++ b/metal/time_c2r.cpp
@@ -0,0 +1,48 @@
+#include <complex>
+#include <cstdio>
+#include <vector>
+#include <random>
+#include <chrono>
+#include "ducc0/fft/fft.h"
+#include "ducc0/fft/fftnd_impl.h"
+#include "ducc0/infra/mav.h"
+int main() {
+  const size_t w=3072,h=3072,cw=w/2+1;
+  std::mt19937 rng(7);
+  std::vector<std::complex<float>> half(h*cw);
+  for(auto& v: half) v={float(rng()%1000)/1000-0.5f,float(rng()%1000)/1000-0.5f};
+  std::vector<std::complex<float>> kern(h*cw);
+  for(auto& v: kern) v={float(rng()%1000)/1000-0.5f,float(rng()%1000)/1000-0.5f};
+  const float fact=1.0/(w*h);
+  // multiply + c2r, single-threaded equivalent of one scale
+  auto t0=std::chrono::steady_clock::now();
+  std::vector<std::complex<float>> prod=half;
+  for(size_t i=0;i<h*cw;i++) prod[i]*=fact*kern[i];
+  auto t1=std::chrono::steady_clock::now();
+  std::vector<float> out(h*w);
+  { ducc0::vfmav<std::complex<float>> in(prod.data(),{h,cw});
+    ducc0::vfmav<float> o(out.data(),{h,w});
+    ducc0::c2r_mut(in,o,{0,1},false,1.0f,1); }
+  auto t2=std::chrono::steady_clock::now();
+  // 8-thread c2r
+  std::vector<std::complex<float>> prod2=half;
+  for(size_t i=0;i<h*cw;i++) prod2[i]*=fact*kern[i];
+  std::vector<float> out2(h*w);
+  auto t3=std::chrono::steady_clock::now();
+  { ducc0::vfmav<std::complex<float>> in(prod2.data(),{h,cw});
+    ducc0::vfmav<float> o(out2.data(),{h,w});
+    ducc0::c2r_mut(in,o,{0,1},false,1.0f,8); }
+  auto t4=std::chrono::steady_clock::now();
+  // expansion timing
+  auto t5=std::chrono::steady_clock::now();
+  std::vector<std::complex<float>> full(h*w);
+  for(size_t i=0;i<h;i++) for(size_t j=0;j<w;j++) {
+    if(j<cw) full[i*w+j]=prod[i*cw+j];
+    else { size_t si=(h-i)%h, sj=w-j; full[i*w+j]=std::conj(prod[si*cw+sj]); }
+  }
+  auto t6=std::chrono::steady_clock::now();
+  using ms=std::chrono::duration<double,std::milli>;
+  printf("multiply(1thr)=%.1fms c2r(1thr)=%.1fms c2r(8thr)=%.1fms expand(1thr)=%.1fms\n",
+    ms(t1-t0).count(), ms(t2-t1).count(), ms(t4-t3).count(), ms(t6-t5).count());
+  return 0;
+}
