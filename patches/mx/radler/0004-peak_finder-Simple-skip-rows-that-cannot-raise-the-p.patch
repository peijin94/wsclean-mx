+/**
+ * Maximum of row[0..n) (of |row| if @p use_abs), ignoring NaNs, starting from
+ * @p start. Independent lanes let the compiler vectorize the reduction without
+ * reassociating comparisons.
+ */
+template <typename T>
+T RowMax(const T* row, size_t n, bool use_abs, T start) {
+  constexpr size_t kLanes = 32 / sizeof(T);
+  T lanes[kLanes];
+  std::fill_n(lanes, kLanes, start);
+  size_t i = 0;
+  if (use_abs) {
+    for (; i + kLanes <= n; i += kLanes)
+      for (size_t l = 0; l != kLanes; ++l) {
+        const T value = std::fabs(row[i + l]);
+        lanes[l] = value > lanes[l] ? value : lanes[l];
+      }
+  } else {
+    for (; i + kLanes <= n; i += kLanes)
+      for (size_t l = 0; l != kLanes; ++l) {
+        const T value = row[i + l];
+        lanes[l] = value > lanes[l] ? value : lanes[l];
+      }
+  }
+  T result = start;
+  for (; i != n; ++i) {
+    const T value = use_abs ? std::fabs(row[i]) : row[i];
+    result = value > result ? value : result;
+  }
+  for (size_t l = 0; l != kLanes; ++l)
+    result = lanes[l] > result ? lanes[l] : result;
+  return result;
+}
