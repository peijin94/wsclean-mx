+
+namespace wsclean {
+namespace {
+using schaapcommon::reordering::ChannelRange;
+using schaapcommon::reordering::MSSelection;
+using schaapcommon::reordering::StorageManagerType;
+
+enum class SelectionMask { kField, kAutocorrelation, kBaselineLength, kDataDescription };
+
+struct FixtureOptions {
+  size_t rows = 3;
+  std::string undefined_column = "CORRECTED_DATA";
+  std::vector<size_t> undefined_rows{1};
+  std::vector<size_t> excluded_rows{1};
+  bool spectral_weights = false;
+  size_t channels = 3;
+  size_t correlations = 1;
+  SelectionMask mask = SelectionMask::kField;
+};
+
+bool Contains(const std::vector<size_t>& rows, size_t row) {
+  return std::find(rows.begin(), rows.end(), row) != rows.end();
+}
+
+casacore::Complex DataValue(size_t row, size_t element) {
+  return {10.0f + row + 0.125f * element, -1.0f - element};
+}
+
+bool FlagValue(size_t row, size_t element) { return (row + element) % 5 == 3; }
+
+struct TemporaryDirectory {
+  TemporaryDirectory()
+      : path(boost::filesystem::current_path() /
+             boost::filesystem::unique_path("wsclean-selection-%%%%-%%%%")) {
+    boost::filesystem::create_directory(path);
+  }
+  ~TemporaryDirectory() { boost::filesystem::remove_all(path); }
+  boost::filesystem::path path;
+};
+
+// A real, isolated disk MS: all required tables are created, with metadata for
+// two fields and configurable channel/correlation shapes.
+class SelectionFixture {
+ private:
+  TemporaryDirectory directory_;
+
+ public:
+  explicit SelectionFixture(FixtureOptions fixture_options = {})
+      : options(std::move(fixture_options)),
+        path((directory_.path / "selection.ms").string()),
+        ms(Create(path, options)) {
+    ms.createDefaultSubtables(casacore::Table::New);
+    ms.addRow(options.rows);
+    ms.antenna().addRow(2);
+    ms.field().addRow(2);
+    ms.spectralWindow().addRow();
+    ms.polarization().addRow();
+    ms.dataDescription().addRow(options.mask == SelectionMask::kDataDescription ? 2 : 1);
+    casacore::MSColumns columns(ms);
+    columns.spectralWindow().numChan().put(0, options.channels);
+    casacore::Vector<double> frequencies(options.channels);
+    for (size_t ch = 0; ch != options.channels; ++ch) frequencies[ch] = 100e6 + ch * 1e6;
+    columns.spectralWindow().chanFreq().put(0, frequencies);
+    columns.spectralWindow().chanWidth().put(0, casacore::Vector<double>(options.channels, 1e6));
+    columns.spectralWindow().refFrequency().put(0, 101e6);
+    columns.polarization().numCorr().put(0, options.correlations);
+    casacore::Vector<int> correlations(options.correlations);
+    for (size_t pol = 0; pol != options.correlations; ++pol) correlations[pol] = 9 + pol;
+    columns.polarization().corrType().put(0, correlations);  // XX, XY, YX, YY
+    casacore::Matrix<int> products(2, options.correlations);
+    for (size_t pol = 0; pol != options.correlations; ++pol) {
+      products(0, pol) = pol / 2;
+      products(1, pol) = pol % 2;
+    }
+    columns.polarization().corrProduct().put(0, products);
+    for (size_t ddid = 0; ddid != ms.dataDescription().nrow(); ++ddid) {
+      columns.dataDescription().spectralWindowId().put(ddid, 0);
+      columns.dataDescription().polarizationId().put(ddid, 0);
+    }
+    for (size_t row = 0; row != options.rows; ++row) {
+      const bool excluded = Contains(options.excluded_rows, row);
+      const casacore::IPosition shape(2, options.correlations, options.channels);
+      columns.antenna1().put(row, 0);
+      columns.antenna2().put(row,
+                             excluded && options.mask == SelectionMask::kAutocorrelation ? 0 : 1);
+      columns.fieldId().put(row, excluded && options.mask == SelectionMask::kField ? 1 : 0);
+      columns.dataDescId().put(row,
+                               excluded && options.mask == SelectionMask::kDataDescription ? 1 : 0);
+      columns.time().put(row, 1000.0 + row);
+      columns.interval().put(row, 1.0);
+      if (!Undefined("UVW", row))
+        columns.uvw().put(row, excluded && options.mask == SelectionMask::kBaselineLength
+                                   ? casacore::Vector<double>(3, 0.0)
+                                   : casacore::Vector<double>{10.0 + row, 20.0, 30.0});
+      casacore::Array<casacore::Complex> data(shape);
+      casacore::Array<bool> flags(shape);
+      casacore::Array<float> weights(shape);
+      for (size_t i = 0; i != data.nelements(); ++i) {
+        data.data()[i] = DataValue(row, i);
+        flags.data()[i] = FlagValue(row, i);
+        weights.data()[i] = WeightValue(row, i);
+      }
+      if (!Undefined("CORRECTED_DATA", row)) columns.correctedData().put(row, data);
+      if (!Undefined("FLAG", row)) columns.flag().put(row, flags);
+      casacore::Vector<float> scalar_weights(options.correlations);
+      for (size_t pol = 0; pol != options.correlations; ++pol)
+        scalar_weights[pol] = WeightValue(row, pol);
+      if (!Undefined("WEIGHT", row)) columns.weight().put(row, scalar_weights);
+      if (options.spectral_weights && !Undefined("WEIGHT_SPECTRUM", row))
+        columns.weightSpectrum().put(row, weights);
+    }
+    ms.flush();
+  }
+
+  float WeightValue(size_t row, size_t element) const {
+    return 2.0f + row +
+           0.25f * (options.spectral_weights ? element : element % options.correlations);
+  }
+
+  bool Undefined(const std::string& column, size_t row) const {
+    return options.undefined_column == column && Contains(options.undefined_rows, row);
+  }
+
+  MSSelection Selection() const {
+    MSSelection selection;
+    if (options.mask == SelectionMask::kBaselineLength) selection.SetMinUVWInM(1.0);
+    return selection;
+  }
+
+  const FixtureOptions options;
+  const std::string path;
+  casacore::MeasurementSet ms;
+
+ private:
+  static casacore::MeasurementSet Create(const std::string& path, const FixtureOptions& options) {
+    casacore::TableDesc description = casacore::MS::requiredTableDesc();
+    description.addColumn(casacore::ArrayColumnDesc<casacore::Complex>("CORRECTED_DATA", 2));
+    if (options.spectral_weights)
+      description.addColumn(casacore::ArrayColumnDesc<float>("WEIGHT_SPECTRUM", 2));
+    if (options.undefined_column == "UVW") description.rwColumnDesc("UVW").setOptions(0);
+    casacore::SetupNewTable setup(path, description, casacore::Table::New);
+    return casacore::MeasurementSet(setup);
+  }
+};
+
+aocommon::VectorMap<ChannelRange> Channels(size_t channels) {
+  aocommon::VectorMap<ChannelRange> result;
+  result.AlwaysEmplace(0, ChannelRange{0, 0, channels});
+  return result;
+}
+void CheckContiguous(SelectionFixture& fixture) {
+  ContiguousMS provider(fixture.path, "CORRECTED_DATA", "MODEL_DATA", StorageManagerType::Default,
+                        fixture.Selection(), Channels(fixture.options.channels),
+                        aocommon::PolarizationEnum::XX, false, false);
+  std::unique_ptr<MSReader> reader = provider.MakeReader();
+  for (size_t row = 0; row != fixture.options.rows; ++row) {
+    if (Contains(fixture.options.excluded_rows, row)) continue;
+    BOOST_TEST_CONTEXT("contiguous row " << row) {
+      BOOST_REQUIRE(reader->CurrentRowAvailable());
+      BOOST_REQUIRE(reader->CurrentRowAvailable());
+      MSProvider::MetaData metadata;
+      reader->ReadMeta(metadata);
+      BOOST_CHECK_EQUAL(metadata.time, 1000.0 + row);
+      BOOST_CHECK_EQUAL(metadata.u_in_m, 10.0 + row);
+      BOOST_CHECK_EQUAL(metadata.v_in_m, 20.0);
+      BOOST_CHECK_EQUAL(metadata.w_in_m, 30.0);
+      BOOST_CHECK_EQUAL(metadata.data_desc_id, 0);
+      BOOST_CHECK_EQUAL(metadata.field_id, 0);
+      BOOST_CHECK_EQUAL(metadata.antenna1, 0);
+      BOOST_CHECK_EQUAL(metadata.antenna2, 1);
+      BOOST_CHECK_EQUAL(metadata.interval, 1.0);
+      std::vector<std::complex<float>> values(fixture.options.channels);
+      std::vector<float> weights(fixture.options.channels);
+      // Alternate the read order and repeat reads to exercise the current-row cache.
+      if (row % 2 == 0) reader->ReadWeights(weights.data());
+      reader->ReadData(values.data());
+      reader->ReadWeights(weights.data());
+      reader->ReadData(values.data());
+      for (size_t ch = 0; ch != values.size(); ++ch) {
+        const size_t i = ch * fixture.options.correlations;
+        BOOST_CHECK_EQUAL(values[ch], DataValue(row, i));
+        BOOST_CHECK_EQUAL(weights[ch], FlagValue(row, i) ? 0.0f : fixture.WeightValue(row, i));
+      }
+      reader->NextInputRow();
+    }
+  }
+  BOOST_CHECK(!reader->CurrentRowAvailable());
+}
+
+void CheckDirect(SelectionFixture& fixture) {
+  DirectMSRowProvider provider(fixture.ms, fixture.Selection(), aocommon::VectorSet<size_t>{0},
+                               "CORRECTED_DATA", "MODEL_DATA", false);
+  for (size_t row = 0; row != fixture.options.rows; ++row) {
+    if (Contains(fixture.options.excluded_rows, row)) continue;
+    BOOST_TEST_CONTEXT("direct row " << row) {
+      BOOST_REQUIRE(!provider.AtEnd());
+      MsRowProviderBase::DataArray data;
+      MsRowProviderBase::FlagArray flags;
+      MsRowProviderBase::WeightArray weights;
+      double u, v, w, time;
+      float interval;
+      uint32_t ddid, antenna1, antenna2, field;
+      provider.ReadData(data, flags, weights, u, v, w, ddid, antenna1, antenna2, field, time,
+                        interval);
+      BOOST_CHECK_EQUAL(time, 1000.0 + row);
+      BOOST_CHECK_EQUAL(u, 10.0 + row);
+      BOOST_CHECK_EQUAL(v, 20.0);
+      BOOST_CHECK_EQUAL(w, 30.0);
+      BOOST_CHECK_EQUAL(ddid, 0);
+      BOOST_CHECK_EQUAL(field, 0);
+      BOOST_CHECK_EQUAL(antenna1, 0);
+      BOOST_CHECK_EQUAL(antenna2, 1);
+      BOOST_CHECK_EQUAL(interval, 1.0f);
+      const casacore::IPosition shape(2, fixture.options.correlations, fixture.options.channels);
+      BOOST_REQUIRE(data.shape().isEqual(shape));
+      BOOST_REQUIRE(flags.shape().isEqual(shape));
+      BOOST_REQUIRE(weights.shape().isEqual(shape));
+      BOOST_CHECK_EQUAL(provider.GetWriteInfo().row_index, row);
+      for (size_t i = 0; i != data.nelements(); ++i) {
+        BOOST_CHECK_EQUAL(data.data()[i], DataValue(row, i));
+        BOOST_CHECK_EQUAL(flags.data()[i], FlagValue(row, i));
+        BOOST_CHECK_EQUAL(weights.data()[i], fixture.WeightValue(row, i));
+      }
+      provider.NextRow();
+    }
+  }
+  BOOST_CHECK(provider.AtEnd());
+}
+
+void CheckBoth(SelectionFixture& fixture) {
+  CheckContiguous(fixture);
+  CheckDirect(fixture);
+}
+
+void SetCellShape(SelectionFixture& fixture, const std::string& column, size_t row,
+                  const casacore::IPosition& shape) {
+  if (column == "CORRECTED_DATA") {
+    casacore::ArrayColumn<casacore::Complex>(fixture.ms, column)
+        .put(row, casacore::Array<casacore::Complex>(shape, casacore::Complex(99.0f, 0.0f)));
+  } else if (column == "FLAG") {
+    casacore::ArrayColumn<bool>(fixture.ms, column).put(row, casacore::Array<bool>(shape, false));
+  } else {
+    casacore::ArrayColumn<float>(fixture.ms, column).put(row, casacore::Array<float>(shape, 99.0f));
+  }
+}
+
+void CheckSelectedCellThrows(SelectionFixture& fixture, size_t malformed_row,
+                             bool check_contiguous = true) {
+  if (check_contiguous) {
+    ContiguousMS provider(fixture.path, "CORRECTED_DATA", "MODEL_DATA",
+                          StorageManagerType::Default, fixture.Selection(),
+                          Channels(fixture.options.channels), aocommon::PolarizationEnum::XX,
+                          false, false);
+    std::unique_ptr<MSReader> reader = provider.MakeReader();
+    std::vector<std::complex<float>> data(fixture.options.channels);
+    std::vector<float> weights(fixture.options.channels);
+    for (size_t row = 0; row != malformed_row; ++row) {
+      if (Contains(fixture.options.excluded_rows, row)) continue;
+      BOOST_REQUIRE(reader->CurrentRowAvailable());
+      reader->ReadData(data.data());
+      BOOST_CHECK_EQUAL(data[0], DataValue(row, 0));
+      reader->NextInputRow();
+    }
+    BOOST_REQUIRE(reader->CurrentRowAvailable());
+    BOOST_CHECK_THROW(reader->ReadData(data.data()), std::runtime_error);
+    BOOST_CHECK_THROW(reader->ReadWeights(weights.data()), std::runtime_error);
+  }
+  DirectMSRowProvider provider(fixture.ms, fixture.Selection(), aocommon::VectorSet<size_t>{0},
+                               "CORRECTED_DATA", "MODEL_DATA", false);
+  MsRowProviderBase::DataArray data;
+  MsRowProviderBase::FlagArray flags;
+  MsRowProviderBase::WeightArray weights;
+  double u, v, w, time;
+  float interval;
+  uint32_t ddid, antenna1, antenna2, field;
+  for (size_t row = 0; row != malformed_row; ++row) {
+    if (Contains(fixture.options.excluded_rows, row)) continue;
+    BOOST_REQUIRE(!provider.AtEnd());
+    provider.ReadData(data, flags, weights, u, v, w, ddid, antenna1, antenna2, field, time,
+                      interval);
+    BOOST_CHECK_EQUAL(data.data()[0], DataValue(row, 0));
+    provider.NextRow();
+  }
+  BOOST_REQUIRE(!provider.AtEnd());
+  // Never pass potentially malformed arrays to downstream extraction.
+  for (size_t repeat = 0; repeat != 2; ++repeat)
+    BOOST_CHECK_THROW(provider.ReadData(data, flags, weights, u, v, w, ddid, antenna1, antenna2,
+                                        field, time, interval),
+                      std::runtime_error);
+}
