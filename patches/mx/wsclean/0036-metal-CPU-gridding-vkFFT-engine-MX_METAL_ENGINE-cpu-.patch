+	for (uint64_t i = app->configuration.fixMinRaderPrimeMult; i < limit; i++) {
+		if (tempSequence[0] % i == 0) {
+			if (i < app->configuration.fixMinRaderPrimeFFT) {
+				tempSequence_temp *= i;
+				tempSequence[0] /= i;
+				i--;
+				continue;
+			}
+			//Sophie Germain safe prime check
