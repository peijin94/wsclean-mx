+namespace mx::metal {
+namespace {
+struct State {
+  std::recursive_mutex mutex;
+  std::mutex accounting;
+  BudgetStats stats{0,0,size_t(1)<<30,0,0,0};
+  std::array<bool(*)(),8> reclaimers{};
+  State() {
+    // Default only when absent. Explicit invalid input disables allocations.
+    const char* p=std::getenv("MX_METAL_MEMORY_MB");
+    if(!p)return;
+    size_t value=0;bool valid=*p;
+    for(const char* c=p;*c;++c) {
+      if(*c<'0'||*c>'9'||value>65536/10){valid=false;break;}
+      value=value*10+size_t(*c-'0');
+    }
+    if(valid && value>=1 && value<=65536 && value<=std::numeric_limits<size_t>::max()/(size_t(1)<<20))
+      stats.limit=value<<20;
+    else {
+      stats.limit=0;
+      std::fprintf(stderr,"[mx-metal] invalid MX_METAL_MEMORY_MB: expected integer MiB in 1..65536; GPU buffer allocations disabled\n");
