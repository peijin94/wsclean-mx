+DegridResult gridDegrid(const std::vector<float>& u_v, const std::vector<float>& grid,
+                        std::size_t grid_size, std::size_t support,
+                        const std::vector<float>& kernel_coefficients,
+                        std::size_t kernel_degree) {
+  @autoreleasepool {
+    id<MTLDevice> device = MTLCreateSystemDefaultDevice();
+    if (device == nil) fail("no Metal device is available");
+    if (u_v.size() % 4 != 0) fail("u/v array must hold four floats per visibility");
+    if (grid.size() != 2 * grid_size * grid_size) fail("grid buffer has the wrong size");
+    if (kernel_coefficients.empty()) fail("degridding needs kernel coefficients");
+
+    const std::size_t count = u_v.size() / 4;
+    NSError* error = nil;
+    id<MTLLibrary> library =
+        [device newLibraryWithSource:[NSString stringWithUTF8String:kGridAccumulateMSL]
+                             options:nil
+                               error:&error];
+    if (library == nil) fail("kernel compilation failed: " + nsString([error localizedDescription]));
+    id<MTLFunction> function = [library newFunctionWithName:@"grid_degrid_poly"];
+    if (function == nil) fail("kernel function 'grid_degrid_poly' is missing");
+    id<MTLComputePipelineState> pipeline =
+        [device newComputePipelineStateWithFunction:function error:&error];
+    if (pipeline == nil) fail("pipeline creation failed: " + nsString([error localizedDescription]));
+
+    id<MTLBuffer> input_buffer = nil;
+    if (!u_v.empty()) {
+      input_buffer = [device newBufferWithBytes:u_v.data()
+                                        length:u_v.size() * sizeof(float)
+                                       options:MTLResourceStorageModeShared];
+    }
+    id<MTLBuffer> output_buffer =
+        [device newBufferWithLength:2 * count * sizeof(float)
+                            options:MTLResourceStorageModeShared];
+    id<MTLBuffer> grid_buffer = [device newBufferWithBytes:grid.data()
+                                                    length:grid.size() * sizeof(float)
+                                                   options:MTLResourceStorageModeShared];
+
+    id<MTLCommandQueue> queue = [device newCommandQueue];
+    id<MTLCommandBuffer> command_buffer = [queue commandBuffer];
+    id<MTLComputeCommandEncoder> encoder = [command_buffer computeCommandEncoder];
+    [encoder setComputePipelineState:pipeline];
+    [encoder setBuffer:input_buffer offset:0 atIndex:0];
+    [encoder setBuffer:output_buffer offset:0 atIndex:1];
+    [encoder setBuffer:grid_buffer offset:0 atIndex:2];
+    const unsigned degree = static_cast<unsigned>(kernel_degree);
+    const unsigned size = static_cast<unsigned>(grid_size);
+    const int centre = static_cast<int>(grid_size) / 2;
+    const unsigned support_unsigned = static_cast<unsigned>(support);
+    const unsigned count_unsigned = static_cast<unsigned>(count);
+    [encoder setBytes:kernel_coefficients.data()
+               length:kernel_coefficients.size() * sizeof(float)
+              atIndex:3];
+    [encoder setBytes:&degree length:sizeof(degree) atIndex:4];
+    [encoder setBytes:&size length:sizeof(size) atIndex:5];
+    [encoder setBytes:&centre length:sizeof(centre) atIndex:6];
+    [encoder setBytes:&support_unsigned length:sizeof(support_unsigned) atIndex:7];
+    [encoder setBytes:&count_unsigned length:sizeof(count_unsigned) atIndex:8];
+    if (count > 0) {
+      [encoder dispatchThreads:MTLSizeMake(count, 1, 1)
+          threadsPerThreadgroup:MTLSizeMake(std::min<std::size_t>(count, 256), 1, 1)];
+    }
+    [encoder endEncoding];
+    const auto begin = std::chrono::steady_clock::now();
+    [command_buffer commit];
+    [command_buffer waitUntilCompleted];
+    const auto end = std::chrono::steady_clock::now();
+    if ([command_buffer status] != MTLCommandBufferStatusCompleted) {
+      fail("degridding failed: " + nsString([[command_buffer error] localizedDescription]));
+    }
+
+    DegridResult result;
+    result.values.resize(2 * count);
+    if (count > 0) {
+      std::memcpy(result.values.data(), [output_buffer contents], 2 * count * sizeof(float));
+    }
+    result.gpu_seconds = [command_buffer GPUEndTime] - [command_buffer GPUStartTime];
+    result.wall_seconds = std::chrono::duration<double>(end - begin).count();
+    return result;
+  }
+}
