 #include <aocommon/logger.h>
 
 #include "math/rms_image.h"
@@ -11,6 +14,58 @@ namespace radler::math {
 
 BOOST_AUTO_TEST_SUITE(rms_image)
 
+BOOST_AUTO_TEST_CASE(sliding_half_open_rectangular_windows) {
+  const aocommon::Image input(3, 2, {6, -3, 4, 9, 2, -7});
+  const aocommon::Image minimum(3, 2, {6, -3, -3, 6, -3, -7});
+  const aocommon::Image maximum(3, 2, {6, 6, 4, 9, 9, 4});
+  for (size_t window : {2, 3}) {
+    aocommon::Image output;
+    SlidingMinimum(output, input, window);
+    BOOST_CHECK_EQUAL_COLLECTIONS(output.begin(), output.end(), minimum.begin(),
+                                 minimum.end());
+    SlidingMaximum(output, input, window);
+    BOOST_CHECK_EQUAL_COLLECTIONS(output.begin(), output.end(), maximum.begin(),
+                                 maximum.end());
+  }
+}
+
+BOOST_AUTO_TEST_CASE(sliding_degenerate_and_oversized_windows) {
+  const aocommon::Image input(1, 3, {4, -2, 7});
+  for (size_t window : {0, 1}) {
+    aocommon::Image output(input);
+    SlidingMinimum(output, output, window);
+    BOOST_CHECK_EQUAL_COLLECTIONS(output.begin(), output.end(), input.begin(),
+                                 input.end());
+    SlidingMaximum(output, output, window);
+    BOOST_CHECK_EQUAL_COLLECTIONS(output.begin(), output.end(), input.begin(),
+                                 input.end());
+  }
+  aocommon::Image output;
+  SlidingMinimum(output, input, std::numeric_limits<size_t>::max());
+  for (float value : output) BOOST_CHECK_EQUAL(value, -2);
+  SlidingMaximum(output, input, std::numeric_limits<size_t>::max());
+  for (float value : output) BOOST_CHECK_EQUAL(value, 7);
+  const aocommon::Image empty(nullptr, 0, 3);
+  SlidingMinimum(output, empty, 2);
+  BOOST_CHECK_EQUAL(output.Width(), 0);
+  BOOST_CHECK_EQUAL(output.Height(), 3);
+}
+
+BOOST_AUTO_TEST_CASE(sliding_nan_and_aliasing) {
+  const float nan = std::numeric_limits<float>::quiet_NaN();
+  aocommon::Image image(3, 2, {nan, 3, -2, nan, nan, nan});
+  SlidingMinimum(image, image, 6);
+  for (float value : image) BOOST_CHECK_EQUAL(value, -2);
+  image = aocommon::Image(3, 2, {nan, 3, -2, nan, nan, nan});
+  SlidingMaximum(image, image, 6);
+  for (float value : image) BOOST_CHECK_EQUAL(value, 3);
+  image = nan;
+  SlidingMinimum(image, image, 4);
+  for (float value : image) BOOST_CHECK(std::isnan(value));
+  SlidingMaximum(image, image, 4);
+  for (float value : image) BOOST_CHECK(std::isnan(value));
+}
+
