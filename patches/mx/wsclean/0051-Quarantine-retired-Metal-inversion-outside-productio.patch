Subject: [PATCH 51/52] Quarantine retired Metal inversion outside production


diff --git a/main/commandline.cpp b/main/commandline.cpp
index 47d183c2..4858ed93 100644
--- a/main/commandline.cpp
+++ b/main/commandline.cpp
@@ -18,6 +18,7 @@
 #include <boost/algorithm/string.hpp>
 
 #include <algorithm>
+#include <cstdlib>
 #include <iostream>
 #include <optional>
 #include <string>
@@ -301,6 +302,7 @@ Options can be:
    Enable the experimental Apple Metal prediction FFT pipeline (mx/macOS build).
    Inversion and gridding/degridding stay on ducc0; unsupported cases use CPU.
    Optional deconvolution experiments: MX_METAL_CONVOLVE=1 and MX_METAL_PEAK=1.
+   MX_METAL_ENGINE is retired; unset it when using -mgpu.
    Runtime evidence: MX_METAL_DEBUG_TIMING=1. CPU-only builds reject this flag.
 
 -wstack-nwlayers <nwlayers>
@@ -763,6 +765,13 @@ bool CommandLine::ParseWithoutValidation(WSClean& wsclean, int argc, const char*
 #ifndef WSCLEAN_MX_METAL
       throw std::runtime_error("-mgpu requires a build with WSCLEAN_MX_METAL=ON");
 #endif
+      const char* engine = std::getenv("MX_METAL_ENGINE");
+      if (engine != nullptr && engine[0] != '\0') {
+        throw std::runtime_error(
+            "MX_METAL_ENGINE is retired: unset it when using -mgpu; "
+            "production inversion always uses ducc0. "
+            "Archived experiments use scripts/test_archived_metal.sh.");
+      }
       settings.useGpu = true;
     }
     else if (param == "nwlayers" || param == "wstack-nwlayers") {
diff --git a/metal/CMakeLists.txt b/metal/CMakeLists.txt
index 79f3b746..497722a4 100644
--- a/metal/CMakeLists.txt
+++ b/metal/CMakeLists.txt
@@ -6,19 +6,19 @@
 # The kernels are compiled from source at runtime, so no metallib toolchain is
 # required; only the Metal and Foundation frameworks are linked.
 
-add_library(mx-metal STATIC metaldevice.mm metalinversion.mm mxvkfft.cpp mxcpugrid.cpp
-                            mxpeak.mm mxconvolve.cpp mxpredict.cpp)
+# Production prediction FFT, peak finding and convolution only.
+add_library(mx-metal STATIC mxvkfft.cpp mxpeak.mm mxconvolve.cpp mxpredict.cpp)
+option(WSCLEAN_MX_METAL_ARCHIVE "Build retired GPU inversion/gridding experiments" OFF)
 target_include_directories(mx-metal PUBLIC ${CMAKE_CURRENT_SOURCE_DIR}/..)
 # metal-cpp's headers are rooted at its own directory ("Foundation/...").
 target_include_directories(mx-metal PRIVATE ${CMAKE_CURRENT_SOURCE_DIR}/thirdparty/metal-cpp)
-# ducc0 is vendored inside schaapcommon; the inversion chain needs its headers
-# (complex2hartley, hartley2_2D, PolynomialKernel).
+# ducc0 headers supply FFT references and the optional archive's kernels.
 if(SCHAAPCOMMON_SOURCE_DIR AND EXISTS "${SCHAAPCOMMON_SOURCE_DIR}/external/ducc0")
   # ducc0's headers are rooted at external/ (as "ducc0/fft/...", not
   # "fft/..."), matching the include the wgridder target uses.
   target_include_directories(mx-metal PUBLIC "${SCHAAPCOMMON_SOURCE_DIR}/external")
 endif()
-set_source_files_properties(metaldevice.mm metalinversion.mm mxpeak.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
+set_source_files_properties(mxpeak.mm PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
 # vkFFT + Apple's metal-cpp are plain C++ and use manual retain/release, so this
 # translation unit must NOT be compiled with ARC.
 set_source_files_properties(mxvkfft.cpp mxconvolve.cpp mxpredict.cpp PROPERTIES COMPILE_OPTIONS "-fno-objc-arc")
@@ -32,12 +32,18 @@ target_link_libraries(
   PUBLIC ${MX_METAL_FRAMEWORK} ${MX_FOUNDATION_FRAMEWORK}
          ${MX_ACCELERATE_FRAMEWORK} ${MX_QUARTZCORE_FRAMEWORK})
 
-# Differential self-test: the Metal gridding accumulator against a float64 CPU
-# twin of the same arithmetic. Run it from the build directory:
-#   ./mx-metal-probe            full size (1024² grid, 200k visibilities)
-#   ./mx-metal-probe --quiet    one machine-readable summary line
-add_executable(mx-metal-probe probe_main.cpp)
-target_link_libraries(mx-metal-probe PRIVATE mx-metal)
+# Retired, scientifically failing experiments. The archive depends on the
+# active FFT library; production targets never depend on the archive.
+if(WSCLEAN_MX_METAL_ARCHIVE)
+  add_library(mx-metal-archive STATIC metaldevice.mm metalinversion.mm mxcpugrid.cpp)
+  target_include_directories(mx-metal-archive PRIVATE
+    ${CMAKE_CURRENT_SOURCE_DIR}/thirdparty/metal-cpp)
+  target_link_libraries(mx-metal-archive PUBLIC mx-metal)
+  set_source_files_properties(metaldevice.mm metalinversion.mm
+    PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
+  add_executable(mx-metal-probe probe_main.cpp)
+  target_link_libraries(mx-metal-probe PRIVATE mx-metal-archive)
+endif()
 
 # Differential self-test for the vkFFT wrapper: CPU gridding + GPU FFT against a
 # float64 CPU reference, so the GPU FFT is gated the same way the gridding is.
