-// ducc0's getNuNv() cost model, restricted to the 2-D kernel family.
+// ducc0's getNuNv() cost model, ported exactly. The w-gridding terms matter:
+// ducc0 multiplies fftcost by nplanes and gridcost by supp when w-gridding, and
+// divides fftcost by a thread sigmoid. Leaving them out (as this did) selects a
+// different kernel AND a different grid - supp 8 / nu 350 instead of supp 7 /
+// nu 392 - which makes the w-plane spacing dw 12% wrong and the w-interpolation
+// collapse as w grows. It also explained the residual 0.8% in the 2-D images:
+// two different grids, not two different kernels.
+double sigmoidScaling(double x, double m, double s) {
+  const double x2 = x - 1.0, m2 = m - 1.0;
+  return 1.0 + x2 / std::pow(1.0 + std::pow(x2 / m2, s), 1.0 / s);
+}
+
 std::size_t chooseKernel(const std::vector<std::size_t>& candidates, std::size_t image_size,
-                         std::size_t rows, double& ofactor_out) {
+                         std::size_t rows, std::size_t nthreads, bool w_gridding, double nm1min,
+                         double nm1max, double w_range, double& ofactor_out, std::size_t& nu_out) {
   constexpr double kNrefFft = 2048.0, kCostRefFft = 0.0693;
-  constexpr std::size_t kSimdWidth = 4;  // float, NEON
-  constexpr double kNthreads = 8.0;      // ducc0's reference thread count
+  constexpr std::size_t kSimdWidth = 4;  // mysimd<float>::size() on NEON
   const double log_term_ref = std::log(kNrefFft * kNrefFft);
+  const double nshift = -0.5 * (nm1max + nm1min);
   std::size_t best = candidates.front();
   double best_cost = 1e300, best_ofactor = 0.0;
+  std::size_t best_nu = 0;
   for (const std::size_t index : candidates) {
     const ducc0::KernelParams& params = ducc0::getKernel(index);
     if (params.ofactor <= 0.0) continue;
     const std::size_t supp = params.W;
     const std::size_t nvec = (supp + kSimdWidth - 1) / kSimdWidth;
-    const std::size_t nu = 2 * ducc0::good_size_complex(
-                                   static_cast<std::size_t>(image_size * params.ofactor * 0.5) + 1);
-    double fft_cost = static_cast<double>(nu) / kNrefFft * static_cast<double>(nu) / kNrefFft *
-                      (std::log(static_cast<double>(nu * nu)) / log_term_ref) * kCostRefFft;
+    std::size_t nu = 2 * ducc0::good_size_complex(
+                             static_cast<std::size_t>(image_size * params.ofactor * 0.5) + 1);
+    nu = std::max<std::size_t>(nu, 16);
+    const std::size_t nv = nu;
+    const double log_term = std::log(static_cast<double>(nu * nv)) / log_term_ref;
+    double fft_cost = static_cast<double>(nu) / kNrefFft * static_cast<double>(nv) / kNrefFft *
+                      log_term * kCostRefFft;
     double grid_cost = 2.2e-10 * static_cast<double>(rows) *
                        static_cast<double>(supp * nvec * kSimdWidth +
                                            (2 * nvec + 1) * (supp + 3) * kSimdWidth);
-    grid_cost /= kNthreads;
+    if (w_gridding) {
+      const double amplitude =
+          std::max(std::fabs(nm1max + nshift), std::fabs(nm1min + nshift));
+      const double dw = 0.5 / params.ofactor / std::max(amplitude, 1e-30);
+      const double nplanes = w_range / dw + static_cast<double>(supp);
+      fft_cost *= nplanes;
+      grid_cost *= static_cast<double>(supp);
+    }
+    grid_cost /= static_cast<double>(nthreads);
+    fft_cost /= sigmoidScaling(static_cast<double>(nthreads), 6.0, 2.0);
     const double cost = fft_cost + grid_cost;
     if (cost < best_cost) {
       best_cost = cost;
       best = index;
       best_ofactor = params.ofactor;
+      best_nu = nu;
     }
   }
   ofactor_out = best_ofactor;
+  nu_out = best_nu;
   return best;
 }
 
