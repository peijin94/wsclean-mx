diff --git a/msproviders/msreaders/contiguousmsreader.h b/msproviders/msreaders/contiguousmsreader.h
index 5ef0a343..3d6e65aa 100644
--- a/msproviders/msreaders/contiguousmsreader.h
+++ b/msproviders/msreaders/contiguousmsreader.h
@@ -3,10 +3,40 @@
 
 #include "msreader.h"
 
+#include <casacore/casa/Arrays/Array.h>
+#include <casacore/tables/Tables/ArrayColumn.h>
+#include <casacore/tables/Tables/RefRows.h>
+
 namespace wsclean {
 
 class ContiguousMS;
 
+/**
+ * The cells of rows [first, last] of an array column, read with one
+ * getColumnCells() call. Reading the cells of a block of rows per column is
+ * much faster than reading row by row and switching columns, when the columns
+ * are indirect arrays in one file (as in a StandardStMan): every column switch
+ * then refills the storage manager's file buffer.
+ */
+template <typename T>
+class ColumnBlock {
+ public:
+  void Load(const casacore::ArrayColumn<T>& column, size_t first, size_t last) {
+    column.getColumnCells(casacore::RefRows(first, last), cells_, true);
+    cell_size_ = cells_.nelements() / (last - first + 1);
+    loaded_ = true;
+  }
+  void Reset() { loaded_ = false; }
+  bool Loaded() const { return loaded_; }
+  const T* Cell(size_t index) const { return cells_.data() + index * cell_size_; }
+  size_t CellSize() const { return cell_size_; }
+
+ private:
+  casacore::Array<T> cells_;
+  size_t cell_size_ = 0;
+  bool loaded_ = false;
+};
+
 class ContiguousMSReader final : public MSReader {
  public:
   explicit ContiguousMSReader(ContiguousMS* contiguousMS);
@@ -39,6 +69,19 @@ class ContiguousMSReader final : public MSReader {
   bool _isDataRead, _isModelRead, _isWeightRead;
   std::unique_ptr<casacore::ArrayColumn<float>> _imagingWeightsColumn;
 
+  // Rows [block_start_, block_end_) of the input columns.
+  size_t block_rows_;
+  size_t block_start_ = 0;
+  size_t block_end_ = 0;
+  ColumnBlock<double> block_uvw_;
+  ColumnBlock<std::complex<float>> block_data_;
+  ColumnBlock<bool> block_flag_;
+  ColumnBlock<float> block_weight_;
+
+  /** Makes the block hold @p row and returns its index in the block. */
+  size_t blockIndex(size_t row);
+  const double* uvw(size_t row);
+
   void readData();
 
   void readWeights();
