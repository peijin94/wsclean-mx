@@ -116,6 +157,9 @@ InMemoryMs ReadMsInMemory(const std::string& measurement_set, const std::string&
                           const schaapcommon::reordering::MSSelection& selection,
                           bool sort_in_time) {
   casacore::MeasurementSet ms(measurement_set);
+  // ReadObservationInfo() requires TIME(0).
+  // No observation epoch exists for an empty MS; return the empty defaults.
+  if (ms.nrow() == 0) return {};
   if (sort_in_time) {
     aocommon::Logger::Debug << "Sorting measurement set...\n";
     ms = ms.sort(casacore::MS::columnName(casacore::MSMainEnums::TIME));
diff --git a/io/readinmemory.h b/io/readinmemory.h
index 11beddff..d6f6b980 100644
--- a/io/readinmemory.h
+++ b/io/readinmemory.h
@@ -13,6 +13,13 @@ class MSSelection;
 
 namespace wsclean {
 
+/**
+ * Loads selected rows, retaining all channels and correlations. Channel range
+ * selection is deferred to reordering. Uses compatible, defined per-row
+ * WEIGHT_SPECTRUM cells, otherwise expands the per-correlation WEIGHT values.
+ * Malformed selected DATA, FLAG or fallback WEIGHT dimensions are rejected.
+ * An empty measurement set returns a default InMemoryMs, including metadata.
+ */
 InMemoryMs ReadMsInMemory(const std::string& measurement_set, const std::string& data_column_name,
                           const schaapcommon::reordering::MSSelection& selection,
                           bool sort_in_time);
