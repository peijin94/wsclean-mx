+// Production public path, unchanged CPU fallback and optional image/RMS consumers.
+#include "mxconvolve.h"
+#include "mxbudget.h"
+#include "algorithms/threaded_deconvolution_tools.h"
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+using Tools=radler::algorithms::ThreadedDeconvolutionTools;
+using Transforms=radler::algorithms::multiscale::MultiScaleTransforms;
+using Cache=radler::algorithms::multiscale::KernelFftCache;
+#define CHECK(x) do{if(!(x)){std::fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x);return 1;}}while(0)
+int main(int argc,char** argv){
+ const bool cpu=argc>1 && std::string(argv[1])=="--cpu";
+ if(cpu)setenv("MX_METAL_NO_FUSE","1",1);else unsetenv("MX_METAL_NO_FUSE");
+ for(auto shape:{std::pair<size_t,size_t>{128,128},{128,96}})for(bool calculate_rms:{false,true})for(bool keep:{false,true})for(bool weighted:{false,true})for(int mask_mode:{0,1,2}){
+  auto [w,h]=shape;const size_t n=w*h;
+  auto cache=std::make_shared<Cache>();Transforms transforms(w,h,radler::MultiscaleShape::kGaussianShape,cache);Tools tools;
+  aocommon::Image input(w,h),weights;
+  for(size_t i=0;i<n;++i)input[i]=float(std::sin(i*0.17)*0.03);
+  input[19*w+31]=10;input[51*w+61]=-8;
+  if(weighted){weights=aocommon::Image(w,h);for(size_t i=0;i<n;++i)weights[i]=0.75f+float(i%19)*0.03125f;}
+  aocommon::UVector<float> scales{0,3,6};
+  aocommon::UVector<bool> mask(n,true);mask[19*w+31]=false;
+  std::vector<aocommon::UVector<bool>> scale_masks;
+  if(mask_mode==2){for(size_t s=0;s<scales.size();++s){scale_masks.emplace_back(n,true);scale_masks.back()[19*w+31+s]=false;}}
+  auto saved=input;
+  std::vector<Tools::PeakData> reference,result;std::vector<aocommon::Image> ref_images,images;
+  Transforms::SetFusedTransformHook(nullptr);Transforms::SetOwnedBatchTransformHook(nullptr);Transforms::SetBatchTransformHook(nullptr);
+  tools.FindMultiScalePeak(&transforms,input,scales,reference,true,mask_mode==1?mask.data():nullptr,scale_masks,0.02f,weights,calculate_rms,keep?&ref_images:nullptr);
+  MxConvolveStats before{};mx_convolve_get_stats(&before);auto budget_before=mx::metal::budgetStats();
+  Transforms::SetFusedTransformHook(&mx_convolve_peak_many);
+  tools.FindMultiScalePeak(&transforms,input,scales,result,true,mask_mode==1?mask.data():nullptr,scale_masks,0.02f,weights,calculate_rms,keep?&images:nullptr);
+  MxConvolveStats after{};mx_convolve_get_stats(&after);
+  CHECK(result.size()==reference.size());
+  if(cpu){CHECK(after.fused_calls==before.fused_calls && after.refusals>before.refusals);CHECK(mx::metal::budgetStats().used==budget_before.used);}
+  else CHECK(after.fused_calls==before.fused_calls+1);
+  CHECK(std::memcmp(saved.Data(),input.Data(),n*sizeof(float))==0);
+  for(size_t s=0;s<scales.size();++s){
+    const auto& a=result[s];const auto& b=reference[s];
+    CHECK(bool(a.normalized_value)==bool(b.normalized_value));CHECK(bool(a.unnormalized_value)==bool(b.unnormalized_value));
+    CHECK(a.x==b.x && a.y==b.y);
+    if(a.normalized_value){const float limit=cpu?0.0f:1e-4f*std::abs(*b.normalized_value);CHECK(std::abs(*a.normalized_value-*b.normalized_value)<=limit);}
+    if(a.unnormalized_value){const float limit=cpu?0.0f:1e-4f*std::abs(*b.unnormalized_value);CHECK(std::abs(*a.unnormalized_value-*b.unnormalized_value)<=limit);}
+    if(!calculate_rms)CHECK(a.rms==-1);
+    else if(cpu)CHECK(a.rms==b.rms);
+    else CHECK(std::abs(a.rms-b.rms)<=5e-6f*b.rms);
+    if(keep){
+      double num=0,den=0,mx=0,md=0;
+      for(size_t i=0;i<n;++i){double r=ref_images[s][i],d=images[s][i]-r;num+=d*d;den+=r*r;mx=std::max(mx,std::abs(r));md=std::max(md,std::abs(d));}
+      CHECK(cpu ? num==0 : std::sqrt(num/den)<5e-6 && md/mx<1e-4);
+      // RMS is EXACTLY sequential over the available unweighted readback.
+      if(calculate_rms)CHECK(a.rms==Tools::RMS(images[s],n));
+    }
+  }
+  const size_t expected_bytes=(!cpu && (calculate_rms||keep))?n*scales.size()*sizeof(float):0;
+  CHECK(after.output_copy_bytes-before.output_copy_bytes==expected_bytes);
+ }
+ Transforms::SetFusedTransformHook(nullptr);mx_convolve_clear_cache();
+ std::printf("PASS public %s: square/rectangle, masks, weights, CPU images, report_rms, output copy counters\n",cpu?"CPU refusal/fallback":"GPU fusion");
+}
