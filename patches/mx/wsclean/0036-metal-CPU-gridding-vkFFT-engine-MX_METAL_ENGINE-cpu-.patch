+			uint64_t test = r;
+			for (uint64_t iter = 0; iter < raderContainer[i].prime - 2; iter++) {
+				if (test == 1) {
+					test = 0;
+					iter = raderContainer[i].prime;
+				}
+				test = ((test * r) % raderContainer[i].prime);
+			}
+			if (test == 1) {
