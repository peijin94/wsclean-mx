 void MSRowProvider::Initialize() {
   assert(!HasTimeBda(Ms()));
 
+  _startTimestep = Selection().HasInterval() ? Selection().IntervalStart() : 0;
+  _endTimestep = _startTimestep;
+  _currentRow = BeginRow();
+  _currentTimestep = _startTimestep;
