+// Return the half-open row range for the selected timestep interval. Empty
+// intervals (including starts beyond the final timestep) return an empty range.
+// An interval requires nondecreasing TIME up to its exclusive end.
 void GetRowRange(casacore::MeasurementSet& ms,
                  const schaapcommon::reordering::MSSelection& selection, size_t& start_row,
                  size_t& end_row);
