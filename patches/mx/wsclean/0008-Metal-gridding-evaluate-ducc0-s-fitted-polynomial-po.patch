+// Loads ducc0's fitted kernel coefficients written by ducc0_kernel_tool.
+bool loadKernelCoefficients(const std::string& path, std::size_t expected_support,
+                            std::vector<float>& coefficients, std::size_t& degree,
+                            double& beta_norm, double& e0) {
+  FILE* file = std::fopen(path.c_str(), "r");
+  if (file == nullptr) {
+    std::fprintf(stderr, "mx-metal-probe: cannot read %s\n", path.c_str());
+    return false;
+  }
+  char line[4096];
+  std::size_t expected = 0;
+  while (std::fgets(line, sizeof(line), file) != nullptr) {
+    char keyword[64];
+    if (std::sscanf(line, "%63s", keyword) != 1) continue;
+    if (keyword[0] == '#') continue;
+    if (std::strcmp(keyword, "support") == 0) {
+      std::size_t support = 0;
+      std::sscanf(line, "%*s %zu", &support);
+      if (support != expected_support) {
+        std::fprintf(stderr, "mx-metal-probe: kernel file support %zu != --support %zu\n",
+                     support, expected_support);
+        std::fclose(file);
+        return false;
+      }
+    } else if (std::strcmp(keyword, "degree") == 0) {
+      std::sscanf(line, "%*s %zu", &degree);
+    } else if (std::strcmp(keyword, "beta_norm") == 0) {
+      std::sscanf(line, "%*s %lf", &beta_norm);
+    } else if (std::strcmp(keyword, "e0") == 0) {
+      std::sscanf(line, "%*s %lf", &e0);
+    } else if (std::strcmp(keyword, "coefficients") == 0) {
+      std::sscanf(line, "%*s %zu", &expected);
+      coefficients.clear();
+      coefficients.reserve(expected);
+    } else if (std::strcmp(keyword, "interval") == 0) {
+      // "interval <n> <c0> <c1> ...": consume the interval index first, or it
+      // would be pushed as a coefficient and shift every later value.
+      char* cursor = line + std::strlen("interval");
+      char* index_end = nullptr;
+      (void)std::strtol(cursor, &index_end, 10);
+      char* number = index_end;
+      while (number != nullptr && *number != '\0' && coefficients.size() < expected) {
+        char* end = nullptr;
+        const double value = std::strtod(number, &end);
+        if (end == number) break;
+        coefficients.push_back(static_cast<float>(value));
+        number = end;
+      }
+    }
+  }
+  std::fclose(file);
+  if (coefficients.size() != expected || expected == 0) {
+    std::fprintf(stderr, "mx-metal-probe: coefficient count %zu != declared %zu\n",
+                 coefficients.size(), expected);
+    return false;
+  }
+  return true;
+}
+
+// ducc0's fitted polynomial, in double, using the float32 coefficients the GPU
+// carries: the reference for the poly variant (ducc0's convention, no
+// per-visibility normalisation).
+double polySample(const std::vector<float>& coefficients, std::size_t support,
+                  std::size_t degree, double x) {
+  const double half = 0.5 * static_cast<double>(support);
+  if (x <= -half || x >= half) return 0.0;
+  const double xnorm = x / half;
+  const double xrel = half * (xnorm + 1.0);
+  long nth = static_cast<long>(xrel);
+  if (nth > static_cast<long>(support) - 1) nth = static_cast<long>(support) - 1;
+  const double locx = ((xrel - static_cast<double>(nth)) - 0.5) * 2.0;
+  const std::size_t ofs = static_cast<std::size_t>(nth) * (degree + 1);
+  double value = coefficients[ofs];
+  for (std::size_t i = 1; i <= degree; ++i) value = value * locx + coefficients[ofs + i];
+  return value;
+}
+
