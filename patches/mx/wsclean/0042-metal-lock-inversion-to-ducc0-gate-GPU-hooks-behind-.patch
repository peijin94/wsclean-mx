diff --git a/tools/mscutout.cpp b/tools/mscutout.cpp
new file mode 100644
index 00000000..c4c17b57
--- /dev/null
+++ b/tools/mscutout.cpp
@@ -0,0 +1,39 @@
+// Materialise a time-range cutout of a Measurement Set.
+//
+// taql can only make *reference* tables for this MS (its storage manager
+// supports neither DELETE nor INSERT), and a reference table re-reads the
+// parent on every pass - a 108 s imaging run became 17 minutes. Table::copy()
+// on a selection is the supported way to get a standalone copy, and it is what
+// python-casacore's table.copy() uses underneath.
+//
+// usage: mscutout <in.ms> <out.ms> "<taql where clause>"
+#include <casacore/casa/Arrays/Vector.h>
+#include <casacore/casa/Exceptions/Error.h>
+#include <casacore/tables/Tables/Table.h>
+#include <casacore/tables/TaQL/TableParse.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+int main(int argc, char** argv) {
+  if (argc < 4) {
+    std::fprintf(stderr, "usage: %s <in.ms> <out.ms> \"<where clause>\"\n", argv[0]);
+    return 2;
+  }
+  try {
+    const std::string cmd = "select from " + std::string(argv[1]) + " where " + argv[3];
+    std::fprintf(stderr, "[mscutout] %s\n", cmd.c_str());
+    casacore::Table selected = casacore::tableCommand(casacore::String(cmd)).table();
+    std::fprintf(stderr, "[mscutout] selected %lld rows; copying...\n",
+                 static_cast<long long>(selected.nrow()));
+    selected.copy(casacore::String(argv[2]), casacore::Table::New);
+    casacore::Table out(casacore::String(argv[2]), casacore::Table::Old);
+    std::fprintf(stderr, "[mscutout] wrote %lld rows to %s\n",
+                 static_cast<long long>(out.nrow()), argv[2]);
+    return 0;
+  } catch (const casacore::AipsError& e) {
+    std::fprintf(stderr, "[mscutout] casacore error: %s\n", e.getMesg().c_str());
+    return 1;
+  }
+}
diff --git a/tools/mscutout_rows.cpp b/tools/mscutout_rows.cpp
new file mode 100644
index 00000000..ac706132
--- /dev/null
+++ b/tools/mscutout_rows.cpp
@@ -0,0 +1,46 @@
+// Materialise a time-range cutout of a Measurement Set.
+//
+// Neither DELETE nor INSERT works on this MS ("storage managers do not support
+// it"), and both `taql ... GIVING` and `Table::copy()` on a TaQL selection yield
+// a *reference* table that re-reads the 16 GB parent on every pass (a 108 s
+// imaging run became 17 minutes). Physically writing the rows with
+// TableCopy::copyRows is the only route that produces a standalone MS.
+//
+// usage: mscutout <in.ms> <out.ms> "<taql where clause>"
+#include <casacore/casa/Exceptions/Error.h>
+#include <casacore/tables/TaQL/TableParse.h>
+#include <casacore/tables/Tables/SetupNewTab.h>
+#include <casacore/tables/Tables/Table.h>
+#include <casacore/tables/Tables/TableCopy.h>
+#include <casacore/tables/Tables/TableDesc.h>
+
+#include <cstdio>
+#include <cstdlib>
+#include <string>
+
+int main(int argc, char** argv) {
+  if (argc < 4) {
+    std::fprintf(stderr, "usage: %s <in.ms> <out.ms> \"<where clause>\"\n", argv[0]);
+    return 2;
+  }
+  try {
+    const std::string cmd = "select from " + std::string(argv[1]) + " where " + argv[3];
+    std::fprintf(stderr, "[mscutout] %s\n", cmd.c_str());
+    casacore::Table selected = casacore::tableCommand(casacore::String(cmd)).table();
+    const casacore::uInt n = selected.nrow();
+    std::fprintf(stderr, "[mscutout] selected %u rows; writing...\n", n);
+
+    casacore::SetupNewTable setup(casacore::String(argv[2]), selected.tableDesc(),
+                                  casacore::Table::New);
+    casacore::Table out(setup, n);
+    casacore::TableCopy::copyInfo(out, selected);
+    casacore::TableCopy::copySubTables(out, selected);
+    casacore::TableCopy::copyRows(out, selected, 0, 0, n);
+    out.flush();
+    std::fprintf(stderr, "[mscutout] wrote %u rows to %s\n", n, argv[2]);
+    return 0;
+  } catch (const casacore::AipsError& e) {
+    std::fprintf(stderr, "[mscutout] casacore error: %s\n", e.getMesg().c_str());
+    return 1;
+  }
+}
