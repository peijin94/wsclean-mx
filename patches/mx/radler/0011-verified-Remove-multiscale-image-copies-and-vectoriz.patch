diff --git a/cpp/math/peak_finder.cc b/cpp/math/peak_finder.cc
index b219ecd..af1f51c 100644
--- a/cpp/math/peak_finder.cc
+++ b/cpp/math/peak_finder.cc
@@ -53,8 +53,8 @@ T RowMax(const T* row, size_t n, bool use_abs, T start) {
   return result;
 }
 
-template <bool Negative, bool Masked>
-aocommon::OptionalNumber<float> WeightedImpl(
+template <bool Negative, bool Masked, bool Weighted>
+aocommon::OptionalNumber<float> FindPeakImpl(
     const float* image, const float* weights, size_t width, size_t height,
     size_t& x, size_t& y, size_t start_y, size_t end_y, const bool* mask,
     size_t horizontal_border, size_t vertical_border) {
@@ -66,6 +66,12 @@ aocommon::OptionalNumber<float> WeightedImpl(
   const size_t y_end = std::min(end_y, height - vertical_border);
   if (x_begin >= x_end || y_begin >= y_end) return {};
 
+  const auto pixel_value = [image, weights](size_t index) {
+    if constexpr (Weighted)
+      return image[index] * weights[index];
+    else
+      return image[index];
+  };
   float peak = std::numeric_limits<float>::min();
   constexpr size_t kLanes = 8;
   for (size_t row = y_begin; row != y_end; ++row) {
@@ -78,8 +84,8 @@ aocommon::OptionalNumber<float> WeightedImpl(
     for (; x_end - col >= kLanes; col += kLanes) {
       for (size_t lane = 0; lane != kLanes; ++lane) {
         const size_t index = offset + col + lane;
-        const float product = image[index] * weights[index];
-        float value = Negative ? std::fabs(product) : product;
+        const float pixel = pixel_value(index);
+        float value = Negative ? std::fabs(pixel) : pixel;
         if constexpr (Masked) value = mask[index] ? value : peak;
         lanes[lane] = value > lanes[lane] ? value : lanes[lane];
       }
@@ -87,8 +93,8 @@ aocommon::OptionalNumber<float> WeightedImpl(
     float row_peak = peak;
     for (; col != x_end; ++col) {
       const size_t index = offset + col;
-      const float product = image[index] * weights[index];
-      float value = Negative ? std::fabs(product) : product;
+      const float pixel = pixel_value(index);
+      float value = Negative ? std::fabs(pixel) : pixel;
       if constexpr (Masked) value = mask[index] ? value : peak;
       row_peak = value > row_peak ? value : row_peak;
     }
@@ -99,8 +105,8 @@ aocommon::OptionalNumber<float> WeightedImpl(
     // the original first-pixel tie, NaN/infinity and signed-value semantics.
     for (size_t column = x_begin; column != x_end; ++column) {
       const size_t index = offset + column;
-      const float product = image[index] * weights[index];
-      const float value = Negative ? std::fabs(product) : product;
+      const float pixel = pixel_value(index);
+      const float value = Negative ? std::fabs(pixel) : pixel;
       if constexpr (Masked) {
         if (!mask[index]) continue;
       }
@@ -108,11 +114,13 @@ aocommon::OptionalNumber<float> WeightedImpl(
         peak = std::fabs(value);
         x = column;
         y = row;
+        // Unweighted recovery can stop at the first known row maximum.
+        if (!Weighted && peak == row_peak) break;
       }
     }
   }
   if (y == height) return {};
-  return aocommon::OptionalNumber<float>(image[y * width + x] * weights[y * width + x]);
+  return aocommon::OptionalNumber<float>(pixel_value(y * width + x));
 }
 
 template <typename T>
@@ -188,52 +196,34 @@ aocommon::OptionalNumber<float> SimpleWeighted(
     size_t vertical_border) {
   if (allow_negative_components) {
     if (clean_mask)
-      return WeightedImpl<true, true>(image, weights, width, height, x, y,
-          start_y, end_y, clean_mask, horizontal_border, vertical_border);
-    return WeightedImpl<true, false>(image, weights, width, height, x, y,
-        start_y, end_y, nullptr, horizontal_border, vertical_border);
+      return FindPeakImpl<true, true, true>(image, weights, width, height, x, y,
+                                            start_y, end_y, clean_mask,
+                                            horizontal_border, vertical_border);
+    return FindPeakImpl<true, false, true>(image, weights, width, height, x, y,
+                                           start_y, end_y, nullptr,
+                                           horizontal_border, vertical_border);
   }
   if (clean_mask)
-    return WeightedImpl<false, true>(image, weights, width, height, x, y,
-        start_y, end_y, clean_mask, horizontal_border, vertical_border);
-  return WeightedImpl<false, false>(image, weights, width, height, x, y,
-      start_y, end_y, nullptr, horizontal_border, vertical_border);
+    return FindPeakImpl<false, true, true>(image, weights, width, height, x, y,
+                                           start_y, end_y, clean_mask,
+                                           horizontal_border, vertical_border);
+  return FindPeakImpl<false, false, true>(image, weights, width, height, x, y,
+                                          start_y, end_y, nullptr,
+                                          horizontal_border, vertical_border);
 }
 
 aocommon::OptionalNumber<float> FindWithMask(
     const float* image, size_t width, size_t height, size_t& x, size_t& y,
     bool allow_negative_components, size_t start_y, size_t end_y,
     const bool* clean_mask, size_t horizontal_border, size_t vertical_border) {
-  float peakMax = std::numeric_limits<float>::min();
-  x = width;
-  y = height;
-
-  size_t xiStart = horizontal_border, xiEnd = width - horizontal_border;
-  size_t yiStart = std::max(start_y, vertical_border),
-         yiEnd = std::min(end_y, height - vertical_border);
-  if (xiEnd < xiStart) xiEnd = xiStart;
-  if (yiEnd < yiStart) yiEnd = yiStart;
-
-  for (size_t yi = yiStart; yi != yiEnd; ++yi) {
-    const float* imgIter = &image[yi * width + xiStart];
-    const bool* cleanMaskPtr = &clean_mask[yi * width + xiStart];
-    for (size_t xi = xiStart; xi != xiEnd; ++xi) {
-      float value = *imgIter;
-      if (allow_negative_components) value = std::fabs(value);
-      if (value > peakMax && *cleanMaskPtr) {
-        x = xi;
-        y = yi;
-        peakMax = std::fabs(value);
-      }
-      ++imgIter;
-      ++cleanMaskPtr;
-    }
-  }
-  if (y == height) {
-    return {};
-  } else {
-    return aocommon::OptionalNumber<float>(image[x + y * width]);
+  if (allow_negative_components) {
+    return FindPeakImpl<true, true, false>(image, nullptr, width, height, x, y,
+                                           start_y, end_y, clean_mask,
+                                           horizontal_border, vertical_border);
   }
+  return FindPeakImpl<false, true, false>(image, nullptr, width, height, x, y,
+                                          start_y, end_y, clean_mask,
+                                          horizontal_border, vertical_border);
 }
 
