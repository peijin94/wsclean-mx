+    }
     data_file_.read(reinterpret_cast<char*>(data_buffer_.data()),
                     n_visibilities * sizeof(std::complex<float>));
+    data_value_position_ = current_value_position_ + n_visibilities;
     has_data_ = true;
   }
   std::copy_n(data_buffer_.data(), n_visibilities, buffer);
@@ -118,8 +125,12 @@ void ReorderedMsReader::ReadModel(std::complex<float>* buffer) {
 void ReorderedMsReader::ReadWeights(float* buffer) {
   const int64_t n_visibilities = NVisibilitiesPerRow(metadata_.data_desc_id);
   if (!has_weights_) {
+    if (weight_value_position_ != current_value_position_) {
+      weight_file_.seekg(current_value_position_ * sizeof(float), std::ios::beg);
+    }
     weight_file_.read(reinterpret_cast<char*>(weight_buffer_.data()),
                       n_visibilities * sizeof(float));
+    weight_value_position_ = current_value_position_ + n_visibilities;
     has_weights_ = true;
   }
   std::copy_n(weight_buffer_.data(), n_visibilities, buffer);
@@ -137,14 +148,14 @@ void ReorderedMsReader::WriteImagingWeights(const float* buffer) {
   }
   const size_t n_vis = NVisibilitiesPerRow(metadata_.data_desc_id);
   imaging_weight_buffer_.resize(n_vis);
-  const size_t chunkSize = n_vis * sizeof(float);
-  imaging_weights_file_->seekg(chunkSize * current_input_row_, std::ios::beg);
+  const size_t byte_position = current_value_position_ * sizeof(float);
+  imaging_weights_file_->seekg(byte_position, std::ios::beg);
   imaging_weights_file_->read(reinterpret_cast<char*>(imaging_weight_buffer_.data()),
                               n_vis * sizeof(float));
   for (size_t i = 0; i != n_vis; ++i) {
     if (std::isfinite(buffer[i])) imaging_weight_buffer_[i] = buffer[i];
   }
-  imaging_weights_file_->seekp(chunkSize * current_input_row_, std::ios::beg);
+  imaging_weights_file_->seekp(byte_position, std::ios::beg);
   imaging_weights_file_->write(reinterpret_cast<const char*>(imaging_weight_buffer_.data()),
                                n_vis * sizeof(float));
 }
diff --git a/msproviders/msreaders/reorderedmsreader.h b/msproviders/msreaders/reorderedmsreader.h
