   float* data();
   std::size_t n() const;
+  std::size_t batch() const;
 
   // Encode + commit without blocking; pair with wait() before reusing data().
   // submit() runs the inverse (adjoint, +1); submitForward() the forward (-1).
diff --git a/metal/vkfft_batch_probe.cpp b/metal/vkfft_batch_probe.cpp
new file mode 100644
index 00000000..8bbc60bb
--- /dev/null
+++ b/metal/vkfft_batch_probe.cpp
@@ -0,0 +1,62 @@
+// Gate for batched vkFFT c2c inverse: B planes, one plan, one submit.
+// Must match ducc0 c2c BACKWARD per plane. Also reports wall time to judge
+// whether one batched call beats B serialized singles.
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <complex>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+#include "ducc0/fft/fft.h"
+#include "ducc0/fft/fftnd_impl.h"
+#include "ducc0/infra/mav.h"
+
+#include "metal/mxvkfft.h"
+
+int main(int argc, char** argv) {
+  setvbuf(stdout, nullptr, _IONBF, 0);
+  const std::size_t n = argc > 1 ? std::stoul(argv[1]) : 1024;
+  const std::size_t B = argc > 2 ? std::stoul(argv[2]) : 8;
+  const int nthreads = 8;
+  mx::vk::Fft fft;
+  if (!fft.initBatched(n, B)) {
+    std::printf("fft init failed: %s\n", fft.error());
+    return 1;
+  }
+  float* gpu = fft.data();
+  std::vector<std::complex<float>> host(B * n * n), ref;
+  std::mt19937 rng(7);
+  for (auto& v : host)
+    v = {static_cast<float>(rng() % 1000) / 1000.0f - 0.5f,
+         static_cast<float>(rng() % 1000) / 1000.0f - 0.5f};
+  std::memcpy(gpu, host.data(), 2 * B * n * n * sizeof(float));
+  ref = host;
+  for (std::size_t b = 0; b < B; ++b) {
+    ducc0::vfmav<std::complex<float>> io(ref.data() + b * n * n, {n, n});
+    ducc0::detail_fft::c2c(io, io, {0}, false, 1.0f, nthreads);
+    ducc0::detail_fft::c2c(io, io, {1}, false, 1.0f, nthreads);
+  }
+  auto t0 = std::chrono::steady_clock::now();
+  if (!fft.submit() || !fft.wait()) {
+    std::printf("batched transform failed: %s\n", fft.error());
+    return 1;
+  }
+  auto t1 = std::chrono::steady_clock::now();
+  double num = 0, den = 0, md = 0, ma = 0;
+  for (std::size_t i = 0; i < B * n * n; ++i) {
+    const std::complex<float> a(gpu[2 * i], gpu[2 * i + 1]);
+    const std::complex<float> b = ref[i];
+    num += std::norm(a - b);
+    den += std::norm(b);
+    md = std::max<double>(md, std::abs(a - b));
+    ma = std::max<double>(ma, std::abs(b));
+  }
+  const double rel = std::sqrt(num / (den + 1e-30));
+  const double ms = std::chrono::duration<double, std::milli>(t1 - t0).count();
+  std::printf("batch n=%zu B=%zu rel_rms=%.3e max_abs=%.4g max_diff=%.4g gpu_ms=%.1f (%.1f ms/plane) %s\n",
+              n, B, rel, ma, md, ms, ms / B, rel < 5e-6 ? "PASS" : "FAIL");
+  return rel < 5e-6 ? 0 : 1;
+}
