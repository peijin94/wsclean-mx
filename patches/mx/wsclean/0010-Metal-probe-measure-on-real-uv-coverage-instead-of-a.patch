diff --git a/metal/uvw_file.h b/metal/uvw_file.h
new file mode 100644
index 00000000..e3aa43f3
--- /dev/null
+++ b/metal/uvw_file.h
@@ -0,0 +1,103 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Copyright (C) 2026 Peijin Zhang
+//
+// Reader for the case-I visibility dump that both the Metal probe and the
+// ducc0 CPU baseline use, so that the two are compared on the same data - real
+// LOFAR uv coverage rather than a synthetic uniform spread. The dump is
+// produced with casacore's taql:
+//
+//   taql "select UVW[0] as u, UVW[1] as v, UVW[2] as w, \
+//         real(DATA[0,0]) as xr, imag(DATA[0,0]) as xi, FLAG[0,0] as f0, \
+//         real(DATA[1,0]) as yr, imag(DATA[1,0]) as yi from <ms>" > dump.txt
+//
+// taql prints a short prose header and tab-separated rows; NaN-valued rows are
+// common in LOFAR data (they carry the flagging), so both are handled here and
+// the counts are reported.
+//
+// UVW is in metres: every consumer must scale by frequency/c to get
+// wavelengths, and by its own lambda-per-cell to get grid cells.
+#ifndef MX_UVW_FILE_H
+#define MX_UVW_FILE_H
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <fstream>
+#include <sstream>
+#include <string>
+#include <vector>
+
+namespace mxbench {
+
+struct RealVisibility {
+  double u_m, v_m, w_m;
+  float re, im;
+  bool flagged;
+};
+
+struct RealVisibilitySet {
+  std::vector<RealVisibility> rows;
+  std::size_t total = 0;      // rows in the file
+  std::size_t flagged = 0;    // dropped because the flag was set
+  std::size_t nonfinite = 0;  // dropped because a value was NaN or inf
+};
+
+inline RealVisibilitySet LoadUvwFile(const std::string& path) {
+  std::ifstream in(path);
+  if (!in) {
+    std::fprintf(stderr, "cannot open %s\n", path.c_str());
+    std::exit(2);
+  }
+  RealVisibilitySet set;
+  std::string line;
+  while (std::getline(in, line)) {
+    // A data row starts with a number; the header lines do not.
+    const char* begin = line.c_str();
+    char* end = nullptr;
+    const double u = std::strtod(begin, &end);
+    if (end == begin) continue;
+    std::istringstream fields(line);
+    RealVisibility row{};
+    std::string token;
+    int index = 0;
+    bool ok = true;
+    while (fields >> token) {
+      if (index < 3) {
+        char* stop = nullptr;
+        const double value = std::strtod(token.c_str(), &stop);
+        if (stop == token.c_str()) { ok = false; break; }
+        (&row.u_m)[index] = value;
+      } else if (index == 3 || index == 4) {
+        const double value = std::strtod(token.c_str(), nullptr);
+        (index == 3 ? row.re : row.im) = static_cast<float>(value);
+      } else if (index == 5) {
+        row.flagged = (token == "true" || token == "1");
+      }
+      ++index;
+    }
+    ++set.total;
+    const bool finite = std::isfinite(row.u_m) && std::isfinite(row.v_m) && std::isfinite(row.w_m) &&
+                        std::isfinite(row.re) && std::isfinite(row.im);
+    if (row.flagged) {
+      ++set.flagged;
+      continue;
+    }
+    if (!finite) {
+      ++set.nonfinite;
+      continue;
+    }
+    if (!ok) continue;
+    set.rows.push_back(row);
+  }
+  std::fprintf(stderr,
+               "[uvw] %s: %zu rows, %zu usable (%zu flagged, %zu non-finite dropped)\n",
+               path.c_str(), set.total, set.rows.size(), set.flagged, set.nonfinite);
+  return set;
+}
+
+// Wavelengths from metres: lambda = metres * frequency / c.
+inline constexpr double kSpeedOfLight = 299792458.0;
+
+}  // namespace mxbench
+
+#endif
