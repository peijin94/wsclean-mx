From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Peijin Zhang <peijin@ustc.edu>
Date: Sat, 17 Oct 2026 17:33:25 -0400
Subject: [PATCH 03/32] MSRowProvider: read MS columns in row blocks during
 reordering

Same storage manager buffer thrash as in ContiguousMSReader: reordering
read UVW, DATA, FLAG and WEIGHT row by row (plus a per-row shape lookup).
Move ColumnBlock to msproviders/columnblock.h and use it in MSRowProvider
for UVW, data, flags and weights. Blocks fall back to one row when spectral
windows or polarizations differ in size, since casacore takes the cell shape
of a block from its first row. Reordering 2.3x faster; bitwise identical
results at -j 1.

diff --git a/msproviders/columnblock.h b/msproviders/columnblock.h
new file mode 100644
index 00000000..755352d5
--- /dev/null
+++ b/msproviders/columnblock.h
@@ -0,0 +1,67 @@
+#ifndef MSPROVIDERS_COLUMN_BLOCK_H_
+#define MSPROVIDERS_COLUMN_BLOCK_H_
+
+#include <algorithm>
+#include <cstddef>
+
+#include <casacore/casa/Arrays/Array.h>
+#include <casacore/ms/MeasurementSets/MeasurementSet.h>
+#include <casacore/tables/Tables/ArrayColumn.h>
+#include <casacore/tables/Tables/RefRows.h>
+#include <casacore/tables/Tables/ScalarColumn.h>
+
+namespace wsclean {
+
+/**
+ * The cells of rows [first, last] of an array column, read with one
+ * getColumnCells() call. Reading the cells of a block of rows per column is
+ * much faster than reading row by row and switching columns, when the columns
+ * are indirect arrays in one file (as in a StandardStMan): every column switch
+ * then refills the storage manager's file buffer.
+ *
+ * All rows of a block must have the same shape: casacore takes the cell shape
+ * from the first row.
+ */
+template <typename T>
+class ColumnBlock {
+ public:
+  void Load(const casacore::ArrayColumn<T>& column, size_t first, size_t last) {
+    column.getColumnCells(casacore::RefRows(first, last), cells_, true);
+    cell_size_ = cells_.nelements() / (last - first + 1);
+    loaded_ = true;
+  }
+  void Reset() { loaded_ = false; }
+  bool Loaded() const { return loaded_; }
+  const T* Cell(size_t index) const { return cells_.data() + index * cell_size_; }
+  size_t CellSize() const { return cell_size_; }
+  casacore::IPosition CellShape() const { return cells_.shape().getFirst(cells_.ndim() - 1); }
+
+ private:
+  casacore::Array<T> cells_;
+  size_t cell_size_ = 0;
+  bool loaded_ = false;
+};
+
+/**
+ * Number of rows per ColumnBlock: about 16 MiB of visibilities, flags and
+ * weights, at most 1024 rows. When rows can have different shapes (several
+ * spectral windows or polarization setups of different size), returns 1.
+ */
+inline size_t ColumnBlockRows(const casacore::MeasurementSet& ms, size_t values_per_row) {
+  constexpr size_t kBlockBytes = 16 * 1024 * 1024;
+  constexpr size_t kMaxBlockRows = 1024;
+  const casacore::ScalarColumn<int> num_chan(ms.spectralWindow(), "NUM_CHAN");
+  const casacore::ScalarColumn<int> num_corr(ms.polarization(), "NUM_CORR");
+  for (casacore::rownr_t row = 1; row < num_chan.nrow(); ++row)
+    if (num_chan(row) != num_chan(0)) return 1;
+  for (casacore::rownr_t row = 1; row < num_corr.nrow(); ++row)
+    if (num_corr(row) != num_corr(0)) return 1;
+  const size_t row_bytes =
+      values_per_row * (sizeof(casacore::Complex) + sizeof(bool) + sizeof(float)) +
+      3 * sizeof(double);
+  return std::clamp<size_t>(kBlockBytes / row_bytes, 1, kMaxBlockRows);
+}
+
+}  // namespace wsclean
+
+#endif
