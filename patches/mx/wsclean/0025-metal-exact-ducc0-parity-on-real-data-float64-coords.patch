+// Wrap a centred cell coordinate exactly as ducc0's getpix does:
+// ducc0 maps u to frac(u_lambda * pixsize) * nu, so out-of-grid visibilities
+// alias back into the grid instead of being culled. In our centred convention
+// with grid cells covering the same uv extent, that is frac(cell/grid)*grid
+// re-centred to [-grid/2, grid/2), which is the identity for in-grid cells.
+// All arithmetic stays in double precision; the caller splits the result
+// into integer base + [0, 1) fraction for the GPU.
+double wrapCell(double cell, std::size_t grid) {
+  const double g = static_cast<double>(grid);
+  const double q = cell / g;
+  const double cornered = (q - std::floor(q)) * g;
+  return cornered >= 0.5 * g ? cornered - g : cornered;
+}
