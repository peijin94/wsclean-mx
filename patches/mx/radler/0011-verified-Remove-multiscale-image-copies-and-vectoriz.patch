@@ -91,11 +91,11 @@ class MultiScaleTransforms {
   void PrepareTransform(float* kernel, float scale);
   void FinishTransform(float* image, const float* kernel);
 
-  void Transform(aocommon::Image& image, aocommon::Image& scratch,
+  // Transform in place without replacing Image storage. If a transform throws,
+  // owning Images remain valid, but processed pixels are not rolled back.
+  void Transform(aocommon::Image& image, aocommon::Image& /*scratch*/,
                  float scale) {
-    std::vector<aocommon::Image> images(1, std::move(image));
-    Transform(images, scratch, scale);
-    image = std::move(images[0]);
+    Transform(&image, 1, scale);
   }
 
   void Transform(std::vector<aocommon::Image>& images, aocommon::Image& scratch,
@@ -204,6 +204,9 @@ class MultiScaleTransforms {
   }
 
  private:
+  // Borrow the owning Images so they remain valid even if a transform throws.
+  void Transform(aocommon::Image* images, size_t image_count, float scale);
+
   std::shared_ptr<const KernelFftCache::Fft> kernelFft(float scale);
 
   size_t _width, _height;
