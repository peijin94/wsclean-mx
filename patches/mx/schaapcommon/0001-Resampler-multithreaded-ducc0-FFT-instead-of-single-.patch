 namespace schaapcommon::math {
 
+namespace {
+
+// Unnormalized 2D real-to-complex forward FFT, same layout and sign convention
+// as fftwf_plan_dft_r2c_2d(height, width, ...).
+void ForwardR2C(const float* input, std::complex<float>* output, size_t width, size_t height,
+                size_t n_threads) {
+  const ducc0::cfmav<float> in(input, {height, width});
+  const ducc0::vfmav<std::complex<float>> out(output, {height, width / 2 + 1});
+  ducc0::r2c(in, out, {0, 1}, true, 1.0f, n_threads);
+}
+
+// Unnormalized 2D complex-to-real backward FFT, same layout and sign convention
+// as fftwf_plan_dft_c2r_2d(height, width, ...). Like FFTW, destroys the input.
+void BackwardC2R(std::complex<float>* input, float* output, size_t width, size_t height,
+                 size_t n_threads) {
+  const ducc0::vfmav<std::complex<float>> in(input, {height, width / 2 + 1});
+  const ducc0::vfmav<float> out(output, {height, width});
+  ducc0::c2r_mut(in, out, {0, 1}, false, 1.0f, n_threads);
+}
+
+}  // namespace
