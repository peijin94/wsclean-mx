+size_t MSRowProvider::blockIndex(size_t row) {
+  if (row < block_start_ || row >= block_end_) {
+    block_start_ = row;
+    block_end_ = std::min(row + block_rows_, EndRow());
+    block_uvw_.Load(Columns().uvw, block_start_, block_end_ - 1);
+    block_data_.Reset();
+    block_flag_.Reset();
+    block_weight_.Reset();
+  }
+  return row - block_start_;
+}
+
+void MSRowProvider::readCurrentUvw() {
+  std::copy_n(block_uvw_.Cell(blockIndex(_currentRow)), 3, _currentUVWArray.data());
+}
+
+void MSRowProvider::readCurrentData(DataArray& data, FlagArray& flags) {
+  const size_t index = blockIndex(_currentRow);
+  MsColumns& columns = Columns();
+  if (!block_data_.Loaded()) block_data_.Load(columns.data, block_start_, block_end_ - 1);
+  data.resize(block_data_.CellShape());
+  std::copy_n(block_data_.Cell(index), block_data_.CellSize(), data.data());
+  if (!block_flag_.Loaded()) block_flag_.Load(columns.flag, block_start_, block_end_ - 1);
+  flags.resize(block_flag_.CellShape());
+  std::copy_n(block_flag_.Cell(index), block_flag_.CellSize(), flags.data());
+}
+
 void MSRowProvider::getCurrentWeights(WeightArray& weights, const casacore::IPosition& shape) {
-  if (_msHasWeights)
-    _weightSpectrumColumn->get(_currentRow, weights, true);
-  else {
-    _weightScalarColumn->get(_currentRow, _scratchWeightScalarArray, true);
+  const size_t index = blockIndex(_currentRow);
+  if (!block_weight_.Loaded())
+    block_weight_.Load(_msHasWeights ? *_weightSpectrumColumn : *_weightScalarColumn,
+                       block_start_, block_end_ - 1);
+  WeightArray& cell = _msHasWeights ? weights : _scratchWeightScalarArray;
+  cell.resize(block_weight_.CellShape());
+  std::copy_n(block_weight_.Cell(index), block_weight_.CellSize(), cell.data());
+  if (!_msHasWeights) {
     weights.resize(shape);
     ExpandScalarWeights(_scratchWeightScalarArray, weights);
   }
