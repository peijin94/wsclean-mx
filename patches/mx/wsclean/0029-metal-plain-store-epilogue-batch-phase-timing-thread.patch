@@ -725,6 +749,8 @@ kernel void grid_accumulate_poly_hoisted_split(device const float* visibilities,
     if (re == 0.0f && im == 0.0f) continue;
     const uint cx = tile_x0 + i % kTile;
     const uint cy = tile_y0 + i / kTile;
+    // Split dispatch: several threadgroups can flush slices of the SAME tile,
+    // so the flush must stay atomic here (unlike the per-tile kernels above).
     atomic_add_float(&grid[2 * (cx * grid_size + cy)], re);
     atomic_add_float(&grid[2 * (cx * grid_size + cy) + 1], im);
   }
