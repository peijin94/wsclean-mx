diff --git a/metal/mxshaders.h b/metal/mxshaders.h
index 0bb45530..1e0fd680 100644
--- a/metal/mxshaders.h
+++ b/metal/mxshaders.h
@@ -425,6 +425,183 @@ kernel void grid_accumulate_cost_probe(device const float* visibilities,
   }
 }
 
+// ducc0's fitted gridding kernel: W piecewise polynomials of degree D in the
+// local coordinate. The convention below reproduces ducc0's
+// FunctionApproximator/PolynomialKernel::eval exactly (verified against their
+// code by bench/metal/ducc0_kernel_tool.cpp: 0 difference with the
+// double-precision coefficients, 1.1e-8 with the float32 ones the float
+// kernels store). x is the offset in CELLS; normalising by the support gives
+// ducc0's [-1,1] domain.
+inline float poly_sample(float x, constant float* coefficients, uint degree, uint support) {
+  // NB: `half` is a reserved type name in MSL - hence half_support.
+  const float half_support = 0.5f * float(support);
+  if (x <= -half_support || x >= half_support) return 0.0f;
+  const float xnorm = x / half_support;
+  const float xrel = half_support * (xnorm + 1.0f);
+  int nth = int(xrel);
+  nth = min(nth, int(support) - 1);
+  const float locx = ((xrel - float(nth)) - 0.5f) * 2.0f;
+  const uint ofs = uint(nth) * (degree + 1u);
+  float value = coefficients[ofs];
+  for (uint i = 1u; i <= degree; ++i) value = value * locx + coefficients[ofs + i];
+  return value;
+}
+
+// Same tiled structure as the generic kernel, but the weights come from
+// ducc0's polynomial and there is NO per-visibility normalisation: ducc0
+// divides the kernel out of the image afterwards with a correction function, so
+// its gridding kernel is used raw. This is the variant that can be wired into
+// the w-gridder.
+kernel void grid_accumulate_poly(device const float* visibilities,
+                                 device const uint* bucket_start,
+                                 device const uint* bucket_items,
+                                 device atomic_uint* grid,
+                                 constant float* coefficients,
+                                 constant uint& degree,
+                                 constant uint& grid_size,
+                                 constant int& centre,
+                                 constant uint& tiles_per_row,
+                                 constant uint& support,
+                                 uint2 tid2 [[thread_position_in_threadgroup]],
+                                 uint2 tile_id [[threadgroup_position_in_grid]],
+                                 uint tid [[thread_index_in_threadgroup]]) {
+  threadgroup atomic_uint tile[(kTile * kTile) * 2];
+  for (uint i = tid; i < kTile * kTile; i += kThreads) {
+    atomic_store_explicit(&tile[2 * i], 0u, memory_order_relaxed);
+    atomic_store_explicit(&tile[2 * i + 1], 0u, memory_order_relaxed);
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+
+  const uint tile_index = tile_id.y * tiles_per_row + tile_id.x;
+  const uint begin = bucket_start[tile_index];
+  const uint end = bucket_start[tile_index + 1];
+  const int half_support = int(support) / 2;
+  const int tile_x0 = int(tile_id.x) * int(kTile);
+  const int tile_y0 = int(tile_id.y) * int(kTile);
+
+  for (uint item = begin + tid; item < end; item += kThreads) {
+    const uint visibility = bucket_items[item];
+    const float u = visibilities[4 * visibility + 0];
+    const float v = visibilities[4 * visibility + 1];
+    const float2 value = float2(visibilities[4 * visibility + 2],
+                                visibilities[4 * visibility + 3]);
+    const float rounded_u = round(u);
+    const float rounded_v = round(v);
+    const int i0 = int(rounded_u) + centre;
+    const int j0 = int(rounded_v) + centre;
+    const float fx = u - rounded_u;
+    const float fy = v - rounded_v;
+
+    for (int jy = -half_support; jy < half_support; ++jy) {
+      const int cy = j0 + jy - tile_y0;
+      if (cy < 0 || cy >= int(kTile)) continue;
+      const float wy = poly_sample(fy - float(jy), coefficients, degree, support);
+      if (wy == 0.0f) continue;
+      for (int jx = -half_support; jx < half_support; ++jx) {
+        const int cx = i0 + jx - tile_x0;
+        if (cx < 0 || cx >= int(kTile)) continue;
+        const float weight =
+            poly_sample(fx - float(jx), coefficients, degree, support) * wy;
+        const uint cell = 2 * (cy * int(kTile) + cx);
+        atomic_add_float(&tile[cell], weight * value.x);
+        atomic_add_float(&tile[cell + 1], weight * value.y);
+      }
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+
+  for (uint i = tid; i < kTile * kTile; i += kThreads) {
+    const float re = as_type<float>(atomic_load_explicit(&tile[2 * i], memory_order_relaxed));
+    const float im =
+        as_type<float>(atomic_load_explicit(&tile[2 * i + 1], memory_order_relaxed));
+    if (re == 0.0f && im == 0.0f) continue;
+    const uint cx = tile_x0 + i % kTile;
+    const uint cy = tile_y0 + i / kTile;
+    atomic_add_float(&grid[2 * (cy * grid_size + cx)], re);
+    atomic_add_float(&grid[2 * (cy * grid_size + cx) + 1], im);
+  }
+}
+
+// poly with the 1D samples hoisted into registers: 6+6 polynomial evaluations
+// per visibility instead of 36. No normalisation (ducc0 convention).
+kernel void grid_accumulate_poly_hoisted(device const float* visibilities,
+                                        device const uint* bucket_start,
+                                        device const uint* bucket_items,
+                                        device atomic_uint* grid,
+                                        constant float* coefficients,
+                                        constant uint& degree,
+                                        constant uint& grid_size,
+                                        constant int& centre,
+                                        constant uint& tiles_per_row,
+                                        constant uint& support,
+                                        uint tid [[thread_index_in_threadgroup]],
+                                        uint2 tile_id [[threadgroup_position_in_grid]]) {
+  threadgroup atomic_uint tile[(kTile * kTile) * 2];
+  for (uint i = tid; i < kTile * kTile; i += kThreads) {
+    atomic_store_explicit(&tile[2 * i], 0u, memory_order_relaxed);
+    atomic_store_explicit(&tile[2 * i + 1], 0u, memory_order_relaxed);
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+
+  const uint tile_index = tile_id.y * tiles_per_row + tile_id.x;
+  const uint begin = bucket_start[tile_index];
+  const uint end = bucket_start[tile_index + 1];
+  const int tile_x0 = int(tile_id.x) * int(kTile);
+  const int tile_y0 = int(tile_id.y) * int(kTile);
+
+  for (uint item = begin + tid; item < end; item += kThreads) {
+    const uint visibility = bucket_items[item];
+    const float u = visibilities[4 * visibility + 0];
+    const float v = visibilities[4 * visibility + 1];
+    const float2 value = float2(visibilities[4 * visibility + 2],
+                                visibilities[4 * visibility + 3]);
+    const float rounded_u = round(u);
+    const float rounded_v = round(v);
+    const int i0 = int(rounded_u) + centre;
+    const int j0 = int(rounded_v) + centre;
+    const float fx = u - rounded_u;
+    const float fy = v - rounded_v;
+
+    float wx[kSupport];
+    float wy[kSupport];
+#pragma clang loop unroll(full)
+    for (int j = 0; j < int(kSupport); ++j) {
+      const float offset = float(j - kHalfSupport);
+      wx[j] = poly_sample(fx - offset, coefficients, degree, support);
+      wy[j] = poly_sample(fy - offset, coefficients, degree, support);
+    }
+
+#pragma clang loop unroll(full)
+    for (int jy = 0; jy < int(kSupport); ++jy) {
+      const int cy = j0 + jy - kHalfSupport - tile_y0;
+      if (cy < 0 || cy >= int(kTile)) continue;
+      const float wy_val = wy[jy];
+      if (wy_val == 0.0f) continue;
+#pragma clang loop unroll(full)
+      for (int jx = 0; jx < int(kSupport); ++jx) {
+        const int cx = i0 + jx - kHalfSupport - tile_x0;
+        if (cx < 0 || cx >= int(kTile)) continue;
+        const float weight = wx[jx] * wy_val;
+        const uint cell = 2 * (cy * int(kTile) + cx);
+        atomic_add_float(&tile[cell], weight * value.x);
+        atomic_add_float(&tile[cell + 1], weight * value.y);
+      }
+    }
+  }
+  threadgroup_barrier(mem_flags::mem_threadgroup);
+
+  for (uint i = tid; i < kTile * kTile; i += kThreads) {
+    const float re = as_type<float>(atomic_load_explicit(&tile[2 * i], memory_order_relaxed));
+    const float im =
+        as_type<float>(atomic_load_explicit(&tile[2 * i + 1], memory_order_relaxed));
+    if (re == 0.0f && im == 0.0f) continue;
+    const uint cx = tile_x0 + i % kTile;
+    const uint cy = tile_y0 + i / kTile;
+    atomic_add_float(&grid[2 * (cy * grid_size + cx)], re);
+    atomic_add_float(&grid[2 * (cy * grid_size + cx) + 1], im);
+  }
+}
+
 )MSL";
 
 }  // namespace mx::metal
