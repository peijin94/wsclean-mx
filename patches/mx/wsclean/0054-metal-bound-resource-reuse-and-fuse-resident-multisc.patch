+// Mutable vectors remain compatible; only detached immutable snapshots get IDs.
+#include "algorithms/multiscale/multiscale_transforms.h"
+#include <cstdio>
+#include <new>
+using Cache=radler::algorithms::multiscale::KernelFftCache;
+#define CHECK(x) do{if(!(x)){std::fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x);return 1;}}while(0)
+int main(){
+  using F=Cache::Fft;using B=F::Base;
+  B vector(12,{1,0});F a=vector;F b=B(12,{2,0});
+  a=vector;b=B(12,{3,0});a=b;b=std::move(a);b={{4,0},{5,0}};
+  CHECK(b.Generation()==0);
+  Cache c;float* escaped=nullptr;
+  std::function<B()> make=[&]()->B{B v(12,{1,0});escaped=reinterpret_cast<float*>(v.data());return v;};
+  auto first=c.Get(4,4,radler::MultiscaleShape::kGaussianShape,3,make);
+  auto hit=c.Get(4,4,radler::MultiscaleShape::kGaussianShape,3,make);
+  CHECK(first->Generation()!=0 && first->Generation()==hit->Generation());
+  // A maker can retain pointers into its result; publication must detach bytes.
+  // Compare addresses only: the original allocation may already be freed.
+  CHECK(reinterpret_cast<const float*>(first->data())!=escaped);
+  F copy(*first);CHECK(copy.Generation()==0);copy[0]={9,0};
+  F moved(std::move(copy));CHECK(moved.Generation()==0 && copy.Generation()==0);
+  auto second=c.Get(4,4,radler::MultiscaleShape::kGaussianShape,4,[&](){return moved;});
+  CHECK(second->Generation()!=first->Generation() && (*second)[0]==std::complex<float>(9,0));
+  moved.assign(12,{7,0});CHECK(moved.Generation()==0);
+  CHECK((*second)[0]==std::complex<float>(9,0));
+  alignas(Cache) unsigned char storage[sizeof(Cache)];
+  auto* old=new(storage)Cache;
+  auto old_owner=old->Get(4,4,radler::MultiscaleShape::kGaussianShape,3,make);
+  auto id=old_owner->Generation();old_owner.reset();old->~KernelFftCache();
+  auto* fresh=new(storage)Cache;
+  auto fresh_owner=fresh->Get(4,4,radler::MultiscaleShape::kGaussianShape,3,make);
+  CHECK(fresh_owner->Generation()!=id);fresh->~KernelFftCache();
+  std::puts("PASS vector construction/assignment/makers, mutable zero IDs, detached immutable owners, address reuse");
+}
