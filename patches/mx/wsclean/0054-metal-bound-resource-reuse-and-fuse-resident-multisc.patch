+}
+bool enabled(const char* name){const char* p=std::getenv(name);return p&&*p&&std::strcmp(p,"0")!=0;}
+std::recursive_mutex& resourceMutex(){return state().mutex;}
+BudgetStats budgetStats(){std::lock_guard lock(state().accounting);return state().stats;}
+bool reserveBytes(size_t n){
+  std::lock_guard lock(resourceMutex());auto& s=state();
+  if(n>s.stats.limit){std::lock_guard a(s.accounting);++s.stats.refusals;return false;}
+  for(;;){
+    {
+      std::lock_guard a(s.accounting);
+      if(n<=s.stats.limit-s.stats.used){
+        s.stats.used+=n;++s.stats.reservations;
+        if(s.stats.used>s.stats.peak)s.stats.peak=s.stats.used;
+        return true;
+      }
+    }
+    bool freed=false;
+    for(auto f:s.reclaimers)if(f && f()){freed=true;break;}
+    if(!freed){std::lock_guard a(s.accounting);++s.stats.refusals;return false;}
+  }
+}
+// Buffer deallocation may run on a Metal completion thread while the host
+// waits under resourceMutex(). Never take the resource gate from this path.
+void releaseBytes(size_t n) noexcept {std::lock_guard lock(state().accounting);state().stats.used-=n;}
+void addReclaimer(bool(*f)()){std::lock_guard lock(resourceMutex());for(auto& p:state().reclaimers){if(p==f)return;if(!p){p=f;return;}}std::abort();}
+void recordEviction(){std::lock_guard lock(state().accounting);++state().stats.evictions;}
+void budgetReport(){const auto s=budgetStats();std::fprintf(stderr,"[mx-metal] budget owned_buffer_used=%zu peak=%zu limit=%zu reservations=%llu evictions=%llu refusals=%llu (excludes process RSS/driver pipelines)\n",s.used,s.peak,s.limit,(unsigned long long)s.reservations,(unsigned long long)s.evictions,(unsigned long long)s.refusals);}
+}
