diff --git a/metal/metaldevice.mm b/metal/metaldevice.mm
index ceec385b..6d883097 100644
--- a/metal/metaldevice.mm
+++ b/metal/metaldevice.mm
@@ -278,6 +278,87 @@ GridAccumResult gridAccumulate(const GridAccumInput& input) {
   }
