+  std::size_t support = 6;  // gridding kernel support in cells (even)
+  // Threads per threadgroup for the poly variants. Measured: fewer threads per
+  // tile is WORSE on clustered data (the tile's work is split less), so this is
+  // a throughput knob, not a contention fix.
+  std::size_t threads_per_group = 256;
+  // Split a tile's bucket into slices of about this many visibilities, one
+  // threadgroup per slice (0 = one threadgroup per tile). This is the
+  // parallelism knob for clustered data, where a few tiles hold all the work.
+  // Measured on 440 745 real rows: 0 -> 28.5 ms, 1024 -> 9.5-13.4 ms,
+  // 256 -> 9.2-13.1 ms (gridding time, min of 7 per run, three runs), so 256 is the default.
+  std::size_t split_target = 256;
   float beta = kDucc0BetaNorm * 6.0f;
   float e0 = kDucc0E0;
   Variant variant = Variant::kHoisted;
