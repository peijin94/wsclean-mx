+                       std::shared_ptr<KernelFftCache> kernel_cache = nullptr)
+      : _width(width),
+        _height(height),
+        _shape(shape),
+        _kernelCache(std::move(kernel_cache)) {}
 
   MultiScaleTransforms(const MultiScaleTransforms&) = default;
   MultiScaleTransforms(MultiScaleTransforms&&) = default;
