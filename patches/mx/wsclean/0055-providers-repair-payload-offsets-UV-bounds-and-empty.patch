+        weight_spectrum_column->get(row_index, weight_array, true);
+      } else {
+        if (!weight_column.isDefined(row_index) ||
+            !weight_column.shape(row_index).isEqual(casacore::IPosition(1, correlations)))
+          throw std::runtime_error("WEIGHT column shape does not match NUM_CORR");
+        weight_column.get(row_index, scalar_weight_array, true);
+        weight_array.resize(data_array.shape());
+        ExpandScalarWeights(scalar_weight_array, weight_array);
+      }
       flag_column.get(row_index, flag_array, true);
 
       InMemoryRow& row = in_memory_rows.emplace_back();
@@ -99,7 +140,7 @@ std::vector<InMemoryRow> ReadMsRows(casacore::MeasurementSet& ms,
 
       row.antenna1 = antenna1;
       row.antenna2 = antenna2;
