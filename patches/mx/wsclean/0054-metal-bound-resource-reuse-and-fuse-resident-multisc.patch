+// SPDX-License-Identifier: GPL-3.0-or-later
+#ifndef MX_METAL_BUDGET_H
+#define MX_METAL_BUDGET_H
+#include <cstddef>
+#include <cstdint>
+#include <mutex>
+namespace mx::metal {
+// Serializes resource ownership/idle eviction, not GPU execution. Recursive so
+// VkFFT planning and cache destructors can allocate/release through this gate.
+std::recursive_mutex& resourceMutex();
+struct BudgetStats { std::size_t used, peak, limit; std::uint64_t reservations, evictions, refusals; };
+BudgetStats budgetStats();
+bool reserveBytes(std::size_t bytes);
+void releaseBytes(std::size_t bytes) noexcept;
+// Reclaim exactly one idle entry; never touch pinned resources. Called under
+// resourceMutex(), including during VkFFT initialization.
+void addReclaimer(bool (*reclaim)());
+void recordEviction();
+void budgetReport();
+bool enabled(const char* name);
+class Reservation {
+ public:
+  ~Reservation(){ reset(); }
+  Reservation()=default;
+  Reservation(const Reservation&)=delete;
+  Reservation& operator=(const Reservation&)=delete;
+  bool acquire(std::size_t n) { reset(); if(!reserveBytes(n))return false; bytes_=n;return true; }
+  void reset() noexcept { if(bytes_)releaseBytes(bytes_);bytes_=0; }
+ private: std::size_t bytes_=0;
+};
+} // namespace mx::metal
+#endif
