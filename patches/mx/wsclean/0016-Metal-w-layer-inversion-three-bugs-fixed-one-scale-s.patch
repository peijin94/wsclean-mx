+bool makeGeometry(const InversionInput& input, std::size_t& image_size, Geometry& out) {
+  const std::vector<std::size_t> candidates =
+      ducc0::getAvailableKernels<float>(input.epsilon, 2, 1.1, 2.0);
+  if (candidates.empty()) return false;
+  image_size = std::max(input.image_width, input.image_height);
+  double ofactor = 0.0;
+  const std::size_t index = chooseKernel(candidates, image_size, input.n_rows, ofactor);
+  out.kernel = ducc0::selectKernel(index);
+  if (!out.kernel) return false;
+  out.nu = 2 * ducc0::good_size_complex(static_cast<std::size_t>(image_size * ofactor * 0.5) + 1);
+  out.grid = ((out.nu + 31) / 32) * 32;
+  // ducc0's cell is 1/(pixsize*nu) wavelengths; ours covers the same uv extent
+  // with grid cells, so a visibility's cell coordinate is u_lambda*pixsize*grid.
+  out.cell_x = input.pixel_size_x * static_cast<double>(out.grid);
+  out.cell_y = input.pixel_size_y * static_cast<double>(out.grid);
+  out.cfu = out.kernel->corfunc(input.image_width / 2 + 1, 1.0 / static_cast<double>(out.grid), 1);
+  out.cfv = out.kernel->corfunc(input.image_height / 2 + 1, 1.0 / static_cast<double>(out.grid), 1);
