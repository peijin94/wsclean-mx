Subject: [PATCH 29/29] metal: plain-store epilogue, batch phase timing,
 threads env knob


diff --git a/metal/metalinversion.mm b/metal/metalinversion.mm
index da2f40a7..5a496c72 100644
--- a/metal/metalinversion.mm
+++ b/metal/metalinversion.mm
@@ -273,6 +273,8 @@ void fillAccumInput(const InversionInput& input, const Geometry& geometry, GridA
   accumulate.kernel_coefficients.assign(geometry.kernel->Coeff().begin(),
                                         geometry.kernel->Coeff().end());
   accumulate.variant = Variant::kPoly;
+  if (const char* threads = std::getenv("MX_METAL_DEBUG_THREADS"))
+    accumulate.threads_per_group = static_cast<std::size_t>(std::atoi(threads));
 }
 
 // Wrap a centred cell coordinate exactly as ducc0's getpix does:
diff --git a/metal/mxshaders.h b/metal/mxshaders.h
index cf1fbac6..c5a57100 100644
--- a/metal/mxshaders.h
+++ b/metal/mxshaders.h
@@ -190,8 +190,12 @@ kernel void grid_accumulate(device const float* visibilities,  // bx,fx,by,fy,re
     if (re == 0.0f && im == 0.0f) continue;
     const uint cx = tile_x0 + i % kTile;
     const uint cy = tile_y0 + i / kTile;
-    atomic_add_float(&grid[2 * (cx * grid_size + cy)], re);
-    atomic_add_float(&grid[2 * (cx * grid_size + cy) + 1], im);
+    // Plain stores: tiles partition the grid disjointly (32x32 cells each,
+    // one threadgroup per tile) and the grid is zeroed per plane, so no two
+    // threads ever write the same cell. The global CAS loop was pure overhead.
+    device float* gf = (device float*)grid;
+    gf[2 * (cx * grid_size + cy)] = re;
+    gf[2 * (cx * grid_size + cy) + 1] = im;
   }
 }
 // The vectorized path is specialized for the support-6 kernel (the W = 6,
