+  // ducc0's eval2s, exactly: the piece index is the PLANE OFFSET
+  // (nth = p0 - minplane), not something derived from a fractional coordinate,
+  // and the polynomial argument is z = 2*(z_off - nth) + (W-1). Deriving nth
+  // from xrel = distance + W/2 picks the neighbouring piece and the weights come
+  // out wrong by a factor that varies smoothly with w - which is what the
+  // stubborn ~3x was.
+  auto wWeight = [&](double w_visibility, double w_plane, std::size_t plane) {
+    const long minplane = static_cast<long>((w_visibility + layout.wshift) / layout.dw);
+    const long nth = static_cast<long>(plane) - minplane;
+    if (nth < 0 || nth >= static_cast<long>(support)) return 0.0;
+    double z = 2.0 * ((w_plane - w_visibility) / layout.dw - static_cast<double>(nth)) +
+               static_cast<double>(support - 1);
+    long piece = nth;
+    if (piece >= static_cast<long>(support)) {
+      z = -z;
+      piece = static_cast<long>(support) - 1 - piece;
