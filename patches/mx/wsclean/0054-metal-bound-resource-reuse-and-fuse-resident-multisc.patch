+// Exact selection against ACTUAL Radler peak_finder using identical padded input.
+#include "mxvkfft.h"
+#include "mxconvolve.h"
+#include "algorithms/threaded_deconvolution_tools.h"
+#include "math/peak_finder.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <limits>
+#include <vector>
+using Tools=radler::algorithms::ThreadedDeconvolutionTools;
+#define CHECK(x) do{if(!(x)){std::fprintf(stderr,"FAIL line %d: %s\n",__LINE__,#x);return 1;}}while(0)
+template<class F> int resident(){
+ if constexpr(!requires(F& f,const unsigned char* const* m,const size_t* b,const float* w,float* v,size_t* p,unsigned char* found){f.findPeaks(m,b,b,true,w,v,p,p,found);}){
+   std::puts("FAIL: resident weighted peak API missing");return 1;
+ }else{
+ for(auto shape:{std::pair<size_t,size_t>{128,128},{128,96}}){
+  auto [w,h]=shape;const size_t n=w*h,batch=3;
+  F f;if(!f.initReal(w,h,batch)){std::fprintf(stderr,"FAIL: native GPU required: %s\n",f.error());return 1;}
+  for(int mode=0;mode<16;++mode)for(bool negative:{false,true})for(bool weighted:{false,true}){
+   std::vector<float> images(n*batch,0),weights(n,1);
+   std::vector<unsigned char> masks(n*batch,1);std::vector<const unsigned char*> mp(batch);
+   std::vector<size_t> xb{0,1,3},yb{0,2,4},x(batch),y(batch);
+   std::vector<float> values(batch);std::vector<unsigned char> found(batch);
+   for(size_t s=0;s<batch;++s){
+    auto* a=images.data()+s*n;
+    if(mode==0){a[5*w+3]=-9;a[5*w+4]=9;a[60*w+2]=9;}
+    if(mode==1){a[6*w+4]=std::numeric_limits<float>::infinity();a[60*w+5]=-std::numeric_limits<float>::infinity();}
+    if(mode==2)std::fill_n(a,n,std::numeric_limits<float>::quiet_NaN());
+    if(mode==3){std::fill_n(a,n,-0.0f);a[5*w+2]=0.0f;}
+    if(mode==4)std::fill_n(a,n,std::numeric_limits<float>::min());
+    if(mode==5){a[5*w+6]=std::numeric_limits<float>::denorm_min();weights[5*w+6]=std::numeric_limits<float>::max();}
+    if(mode==6){a[5*w+6]=std::numeric_limits<float>::lowest();}
+    if(mode==7){a[0]=500;a[5*w+6]=8;a[70*w+4]=-8;}
+    if(mode==8){a[6*w+4]=7;a[70*w+4]=10;weights[6*w+4]=2;}
+    if(mode==9){a[6*w+4]=7;weights[6*w+4]=std::numeric_limits<float>::quiet_NaN();}
+    if(mode==10){a[6*w+4]=std::numeric_limits<float>::infinity();weights[6*w+4]=0;}
+    if(mode==12){std::fill_n(masks.data()+s*n,n,0);a[5*w+6]=8;}
+    if(mode==13){xb[s]=w/2;a[5*w+6]=8;}
+    if(mode==14){for(size_t i=0;i<n;++i){a[i]=float(int((i*109+17)%509)-254)/31;weights[i]=float(int((i*47+13)%127)-63)/17;}}
+    if(mode==15){std::fill_n(a,n,-3);a[5*w+6]=-8;}
+    if(mode==11){a[6*w+4]=std::nextafter(std::numeric_limits<float>::min(),1.0f);}
+    if(mode!=12)masks[s*n+6*w+4]=s==1?0:1;mp[s]=(s==0)?nullptr:masks.data()+s*n;
+    for(size_t row=0;row<h;++row){std::memcpy(f.data()+(s*h+row)*f.rowFloats(),a+row*w,w*sizeof(float));f.data()[(s*h+row)*f.rowFloats()+w]=1e30f;}
+   }
+   std::vector<float> saved(f.data(),f.data()+f.rowFloats()*h*batch);
+   CHECK(f.findPeaks(mp.data(),xb.data(),yb.data(),negative,weighted?weights.data():nullptr,values.data(),x.data(),y.data(),found.data()));
+   CHECK(std::memcmp(saved.data(),f.data(),saved.size()*sizeof(float))==0);
+   for(size_t s=0;s<batch;++s){
+    std::vector<float> scratch(images.begin()+s*n,images.begin()+(s+1)*n);
+    if(weighted)for(size_t i=0;i<n;++i)scratch[i]*=weights[i];
+    size_t cx=w,cy=h;auto cpu=mp[s]
+      ?radler::math::peak_finder::FindWithMask(scratch.data(),w,h,cx,cy,negative,0,h,reinterpret_cast<const bool*>(mp[s]),xb[s],yb[s])
+      :radler::math::peak_finder::Find(scratch.data(),w,h,cx,cy,negative,0,h,xb[s],yb[s]);
+    CHECK(bool(cpu)==bool(found[s]));CHECK(cx==x[s] && cy==y[s]);
+    if(cpu)CHECK(std::memcmp(&*cpu,&values[s],sizeof(float))==0);
+   }
+  }
+ }
+ std::puts("PASS exact resident weighted/unweighted masks/borders/ties/NaN/inf/zero/subnormal/no-peak");return 0;
+ }
+}
+int main(){return resident<mx::vk::Fft>();}
