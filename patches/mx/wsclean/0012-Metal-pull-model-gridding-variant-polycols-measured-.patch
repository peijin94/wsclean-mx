diff --git a/metal/mxshaders.h b/metal/mxshaders.h
index d5dcc49d..43dcdafe 100644
--- a/metal/mxshaders.h
+++ b/metal/mxshaders.h
@@ -602,6 +602,58 @@ kernel void grid_accumulate_poly_hoisted(device const float* visibilities,
   }
 }
 
+// Pull model: each thread OWNS four cells of its tile (one u column, a run of
+// four v rows) and accumulates them in registers while it scans the tile's
+// bucket list. Every cell is written by exactly one thread, so there are no
+// atomics, no CAS loops and no collisions - the cost that dominated the push
+// variants on clustered real data (gridding measured ~16x its own degridding
+// direction, which needs no atomics). The price is that each thread scans the
+// whole bucket and re-evaluates the weights of the visibilities that touch its
+// column; on 440k real visibilities that scan is ~10^8 cheap iterations, while
+// the atomic serialisation it replaces cost tens of milliseconds.
+kernel void grid_accumulate_poly_columns(device const float* visibilities,
+                                 device const uint* bucket_start,
+                                 device const uint* bucket_items,
+                                 device float* grid,
+                                 constant float* coefficients,
+                                 constant uint& degree,
+                                 constant uint& grid_size,
+                                 constant int& centre,
+                                 constant uint& tiles_per_row,
+                                 constant uint& support,
+                                 uint2 tid2 [[thread_position_in_threadgroup]],
+                                 uint2 tile_id [[threadgroup_position_in_grid]]) {
+  // Pull model, minimal form: one cell per thread, one scalar accumulator, no
+  // local arrays and no dynamic indexing anywhere. Each cell has exactly one
+  // owner, so the writes are plain stores and no atomics are needed.
+  const int cx = int(tile_id.x) * int(kTile) + int(tid2.x);
+  const int cy = int(tile_id.y) * int(kTile) + int(tid2.y);
+  const int half_support = int(support) / 2;
+  const uint tile_index = tile_id.y * tiles_per_row + tile_id.x;
+  const uint begin = bucket_start[tile_index];
+  const uint end = bucket_start[tile_index + 1];
+
+  float2 acc = float2(0.0f);
+  for (uint item = begin; item < end; ++item) {
+    const uint visibility = bucket_items[item];
+    const float u = visibilities[4 * visibility + 0];
+    const float v = visibilities[4 * visibility + 1];
+    const float rounded_u = round(u);
+    const float rounded_v = round(v);
+    const int jx = cx - (int(rounded_u) + centre);
+    if (jx < -half_support || jx >= half_support) continue;
+    const int jy = cy - (int(rounded_v) + centre);
+    if (jy < -half_support || jy >= half_support) continue;
+    const float wx = poly_sample((u - rounded_u) - float(jx), coefficients, degree, support);
+    const float wy = poly_sample((v - rounded_v) - float(jy), coefficients, degree, support);
+    acc += float2(visibilities[4 * visibility + 2], visibilities[4 * visibility + 3]) * (wx * wy);
+  }
+
+  device float* out = grid + 2 * (cy * int(grid_size) + cx);
+  out[0] = acc.x;
+  out[1] = acc.y;
+}
+
 // Degridding: grid -> visibilities, the adjoint of the gridding accumulation.
 // Each thread owns one visibility and sums its 6x6 neighbourhood of the grid,
 // so no atomics are needed and there is no tile structure to pay for. The
