+std::shared_ptr<const KernelFftCache::Fft> KernelFftCache::Get(
+    size_t width, size_t height, MultiscaleShape shape, float scale,
+    const std::function<Fft()>& make) {
+  const Key key(width, height, shape, scale);
+  {
+    std::lock_guard lock(mutex_);
+    const auto iter = ffts_.find(key);
+    if (iter != ffts_.end()) return iter->second;
+  }
+  auto fft = std::make_shared<const Fft>(make());
+  const size_t bytes = fft->size() * sizeof(std::complex<float>);
+  std::lock_guard lock(mutex_);
+  const auto [iter, inserted] = ffts_.try_emplace(key, fft);
+  if (!inserted) return iter->second;
+  if (bytes_ + bytes > kMaxBytes) {
+    ffts_.erase(iter);
+    return fft;
+  }
+  bytes_ += bytes;
+  return fft;
+}
 
-  scratch = 0.0;
+std::shared_ptr<const KernelFftCache::Fft> MultiScaleTransforms::kernelFft(
+    float scale) {
+  const auto make = [&]() {
+    size_t kernel_size;
+    const Image shape = MakeShapeFunction(scale, kernel_size);
+    Image kernel(_width, _height);
+    kernel = 0.0;
+    schaapcommon::math::PrepareSmallConvolutionKernel(
+        kernel.Data(), _width, _height, shape.Data(), kernel_size);
+    KernelFftCache::Fft fft(
+        schaapcommon::math::ConvolutionFftSize(_width, _height));
+    schaapcommon::math::ConvolutionFft(fft.data(), kernel.Data(), _width,
+                                       _height);
+    return fft;
+  };
+  if (_kernelCache)
+    return _kernelCache->Get(_width, _height, _shape, scale, make);
+  return std::make_shared<const KernelFftCache::Fft>(make());
+}
 
-  schaapcommon::math::PrepareSmallConvolutionKernel(
-      scratch.Data(), _width, _height, shape.Data(), kernelSize);
+void MultiScaleTransforms::Transform(std::vector<Image>& images,
+                                     Image& /*scratch*/, float scale) {
+  const std::shared_ptr<const KernelFftCache::Fft> kernel = kernelFft(scale);
+  KernelFftCache::Fft image_fft(
+      schaapcommon::math::ConvolutionFftSize(_width, _height));
   for (Image& image : images) {
-    schaapcommon::math::Convolve(image.Data(), scratch.Data(), _width, _height);
+    schaapcommon::math::ConvolutionFft(image_fft.data(), image.Data(), _width,
+                                       _height);
+    schaapcommon::math::ConvolveTransformed(image.Data(), image_fft.data(),
+                                            kernel->data(), _width, _height);
   }
 }
 
+void MultiScaleTransforms::Transform(const std::complex<float>* image_fft,
+                                     Image& dest, float scale) {
+  const std::shared_ptr<const KernelFftCache::Fft> kernel = kernelFft(scale);
+  schaapcommon::math::ConvolveTransformed(dest.Data(), image_fft,
+                                          kernel->data(), _width, _height);
+}
