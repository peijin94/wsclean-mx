+// Degridding twin: grid -> visibilities in double, same weights and indexing as
+// the Metal kernel (the adjoint of referenceGrid's accumulation).
+std::vector<double> referenceDegrid(const Options& options,
+                                    const std::vector<float>& visibilities,
+                                    const std::vector<float>& grid,
+                                    const std::vector<float>& coefficients,
+                                    std::size_t degree) {
+  const std::size_t g = options.grid;
+  const int half = static_cast<int>(options.support) / 2;
+  const long centre_index = static_cast<long>(g) / 2;
+  const std::size_t count = visibilities.size() / 4;
+  std::vector<double> values(2 * count, 0.0);
+  for (std::size_t v = 0; v < count; ++v) {
+    const long rounded_u = std::lround(static_cast<double>(visibilities[4 * v]));
+    const long rounded_v = std::lround(static_cast<double>(visibilities[4 * v + 1]));
+    const long i0 = rounded_u + centre_index;
+    const long j0 = rounded_v + centre_index;
+    const double fx = static_cast<double>(visibilities[4 * v]) - static_cast<double>(rounded_u);
+    const double fy = static_cast<double>(visibilities[4 * v + 1]) - static_cast<double>(rounded_v);
+    double re = 0.0, im = 0.0;
+    for (int jy = -half; jy < half; ++jy) {
+      const long cy = j0 + jy;
+      if (cy < 0 || cy >= static_cast<long>(g)) continue;
+      const double wy = polySample(coefficients, options.support, degree, fy - jy);
+      if (wy == 0.0) continue;
+      for (int jx = -half; jx < half; ++jx) {
+        const long cx = i0 + jx;
+        if (cx < 0 || cx >= static_cast<long>(g)) continue;
+        const double weight = polySample(coefficients, options.support, degree, fx - jx) * wy;
+        const std::size_t cell = 2 * (static_cast<std::size_t>(cy) * g + static_cast<std::size_t>(cx));
+        re += weight * static_cast<double>(grid[cell]);
+        im += weight * static_cast<double>(grid[cell + 1]);
+      }
+    }
+    values[2 * v] = re;
+    values[2 * v + 1] = im;
+  }
+  return values;
+}
+
+// Round trip: grid -> degrid with the polynomial convention, checked against the
+// double twins and against the adjoint identity <Gx, Y> = <x, D Y>.
+int runRoundTrip(const Options& options, const mx::metal::DeviceInfo& info,
+                 const std::vector<float>& coefficients, std::size_t degree,
+                 mx::metal::GridAccumInput input) {
+  const std::size_t count = input.visibilities.size() / 4;
+  std::printf("roundtrip device=\"%s\" nvis=%zu grid=%zu support=%zu\n", info.name.c_str(),
+              count, options.grid, options.support);
+
+  // Forward: gridding, timed, and its double twin (also timed: the scalar
+  // single-thread baseline - not ducc0's SIMD, multithreaded path).
+  const auto twin_grid_begin = std::chrono::steady_clock::now();
+  const std::vector<double> reference_raw =
+      referenceGrid(options, input.visibilities, ReferenceKernel::kPolynomial, false,
+                    coefficients, degree);
+  const double twin_grid_seconds =
+      std::chrono::duration<double>(std::chrono::steady_clock::now() - twin_grid_begin).count();
+
+  input.variant = mx::metal::Variant::kPolyHoisted;
+  const mx::metal::GridAccumResult gpu_grid = mx::metal::gridAccumulate(input);
+  const CheckResult grid_check = checkGrid(gpu_grid.grid, reference_raw);
+
+  // Backward: degridding of the GPU grid, checked against the twin degridding of
+  // the same grid (isolates the degridding kernel from the gridding error).
+  const auto twin_degrid_begin = std::chrono::steady_clock::now();
+  const std::vector<double> reference_values =
+      referenceDegrid(options, input.visibilities, gpu_grid.grid, coefficients, degree);
+  const double twin_degrid_seconds =
+      std::chrono::duration<double>(std::chrono::steady_clock::now() - twin_degrid_begin).count();
+
+  const mx::metal::DegridResult gpu_values = mx::metal::gridDegrid(
+      input.visibilities, gpu_grid.grid, options.grid, options.support, coefficients, degree);
+  double worst = 0.0, scale = 0.0;
+  for (std::size_t i = 0; i < gpu_values.values.size(); ++i) {
+    worst = std::max(worst, std::fabs(static_cast<double>(gpu_values.values[i]) - reference_values[i]));
+    scale = std::max(scale, std::fabs(reference_values[i]));
+  }
+  const double degrid_relative = worst / std::max(scale, 1e-30);
+
+  // Adjoint identity with an independent random grid Y:
+  //   <G x, Y> must equal <x, D Y>.
+  std::mt19937_64 random(4242);
+  std::normal_distribution<float> noise(0.0f, 1.0f);
+  std::vector<float> random_grid(2 * options.grid * options.grid);
+  for (float& cell : random_grid) cell = noise(random);
+  const mx::metal::DegridResult adjoint_values = mx::metal::gridDegrid(
+      input.visibilities, random_grid, options.grid, options.support, coefficients, degree);
+  double lhs = 0.0, rhs = 0.0;
+  for (std::size_t i = 0; i < random_grid.size(); ++i) {
+    lhs += static_cast<double>(gpu_grid.grid[i]) * random_grid[i];
+  }
+  for (std::size_t v = 0; v < count; ++v) {
+    rhs += static_cast<double>(input.visibilities[4 * v + 2]) * adjoint_values.values[2 * v] +
+           static_cast<double>(input.visibilities[4 * v + 3]) * adjoint_values.values[2 * v + 1];
+  }
+  const double adjoint_relative = std::fabs(lhs - rhs) / std::max({std::fabs(lhs), std::fabs(rhs), 1e-30});
+
+  const double gpu_total_seconds = gpu_grid.gpu_seconds + gpu_values.gpu_seconds;
+  const double twin_total_seconds = twin_grid_seconds + twin_degrid_seconds;
+  std::printf("roundtrip grid: gpu_ms=%.2f twin_ms=%.1f rel_max=%.3g status=%s\n",
+              gpu_grid.gpu_seconds * 1e3, twin_grid_seconds * 1e3, grid_check.relative_max,
+              grid_check.passed ? "PASS" : "FAIL");
+  std::printf("roundtrip degrid: gpu_ms=%.2f twin_ms=%.1f rel_max=%.3g status=%s\n",
+              gpu_values.gpu_seconds * 1e3, twin_degrid_seconds * 1e3, degrid_relative,
+              degrid_relative <= 1.0e-5 ? "PASS" : "FAIL");
+  std::printf("roundtrip adjoint: lhs=%.6g rhs=%.6g rel_diff=%.3g status=%s\n", lhs, rhs,
+              adjoint_relative, adjoint_relative <= 1.0e-5 ? "PASS" : "FAIL");
+  std::printf("roundtrip total: gpu_ms=%.2f twin_ms=%.1f speedup_vs_scalar_double_twin=x%.1f "
+              "throughput_Mvis_s=%.1f\n",
+              gpu_total_seconds * 1e3, twin_total_seconds * 1e3,
+              twin_total_seconds / std::max(gpu_total_seconds, 1e-9),
+              static_cast<double>(count) / std::max(gpu_total_seconds, 1e-9) / 1e6);
+  const bool passed = grid_check.passed && degrid_relative <= 1.0e-5 && adjoint_relative <= 1.0e-5;
+  return passed ? 0 : 1;
+}
