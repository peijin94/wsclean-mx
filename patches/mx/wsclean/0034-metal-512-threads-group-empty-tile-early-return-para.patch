diff --git a/metal/metalinversion.mm b/metal/metalinversion.mm
index 48e75b51..0e3d1fcf 100644
--- a/metal/metalinversion.mm
+++ b/metal/metalinversion.mm
@@ -964,18 +964,22 @@ bool inversion(const InversionInput& input, float* dirty) {
   }  // end row chunk
 
   // ---------------- ducc0's apply_global_corrections ----------------
-  for (std::size_t i = 0; i < input.image_width; ++i) {
+  // Per-row writes are disjoint, so this parallelises bit-identically. At 4k it
+  // is 16.8M nm1Of + corfunc evaluations and was purely serial (~1.5 s).
+  dispatch_apply(input.image_width, dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0),
+                 ^(std::size_t i) {
     const double l = x0 + static_cast<double>(i) * input.pixel_size_x;
     const int icfu = std::abs(static_cast<int>(input.image_width / 2) - static_cast<int>(i));
+    const double cf = geometry.cfu[icfu];
     for (std::size_t j = 0; j < input.image_height; ++j) {
       const double m = y0 + static_cast<double>(j) * input.pixel_size_y;
       const double nm1 = nm1Of(l, m);
       const double correction = geometry.kernel->corfunc((nm1 + layout.nshift) * layout.dw);
       const int icfv = std::abs(static_cast<int>(input.image_height / 2) - static_cast<int>(j));
       dirty[i * input.image_height + j] *=
-          static_cast<float>(correction * geometry.cfu[icfu] * geometry.cfv[icfv]);
+          static_cast<float>(correction * cf * geometry.cfv[icfv]);
     }
-  }
+  });
   const double scale = debugDouble("MX_METAL_DEBUG_SCALE", 1.0);
   if (scale != 1.0) {
     for (std::size_t i = 0; i < image_pixels; ++i) dirty[i] = static_cast<float>(dirty[i] * scale);
