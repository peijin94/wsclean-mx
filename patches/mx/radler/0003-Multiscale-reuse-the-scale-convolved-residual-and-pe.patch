diff --git a/cpp/algorithms/subminor_loop.cc b/cpp/algorithms/subminor_loop.cc
index 3d0133a..0414724 100644
--- a/cpp/algorithms/subminor_loop.cc
+++ b/cpp/algorithms/subminor_loop.cc
@@ -330,20 +330,43 @@ void SubMinorLoop::GetFullIndividualModel(size_t image_index,
 void SubMinorLoop::CorrectResidualDirty(
     float* scratch_a, float* scratch_b, float* scratch_c, size_t image_index,
     float* residual, const float* single_convolved_psf) const {
+  const aocommon::UVector<std::complex<float>> kernel_fft =
+      PsfKernelFft(scratch_a, scratch_b, single_convolved_psf);
+  CorrectResidualDirty(scratch_a, scratch_c, image_index, residual,
+                       kernel_fft.data());
+}
+
+aocommon::UVector<std::complex<float>> SubMinorLoop::PsfKernelFft(
+    float* scratch_a, float* scratch_b,
+    const float* single_convolved_psf) const {
   // Get padded kernel in scratch_b
   Image::Untrim(scratch_a, _paddedWidth, _paddedHeight, single_convolved_psf,
                 _width, _height);
   schaapcommon::math::PrepareConvolutionKernel(scratch_b, scratch_a,
                                                _paddedWidth, _paddedHeight);
+  aocommon::UVector<std::complex<float>> kernel_fft(
+      schaapcommon::math::ConvolutionFftSize(_paddedWidth, _paddedHeight));
+  schaapcommon::math::ConvolutionFft(kernel_fft.data(), scratch_b,
+                                     _paddedWidth, _paddedHeight);
+  return kernel_fft;
+}
 
+void SubMinorLoop::CorrectResidualDirty(
+    float* scratch_a, float* scratch_c, size_t image_index, float* residual,
+    const std::complex<float>* psf_kernel_fft) const {
   // Get padded model image in scratch_a
   GetFullIndividualModel(image_index, scratch_c);
   Image::Untrim(scratch_a, _paddedWidth, _paddedHeight, scratch_c, _width,
                 _height);
 
   // Convolve and store in scratch_a
-  schaapcommon::math::Convolve(scratch_a, scratch_b, _paddedWidth,
-                               _paddedHeight);
+  aocommon::UVector<std::complex<float>> model_fft(
+      schaapcommon::math::ConvolutionFftSize(_paddedWidth, _paddedHeight));
+  schaapcommon::math::ConvolutionFft(model_fft.data(), scratch_a, _paddedWidth,
+                                     _paddedHeight);
+  schaapcommon::math::ConvolveTransformed(scratch_a, model_fft.data(),
+                                          psf_kernel_fft, _paddedWidth,
+                                          _paddedHeight);
 
   // Trim the result into scratch_c
   Image::Trim(scratch_c, _width, _height, scratch_a, _paddedWidth,
