diff --git a/metal/multiscale_batch_probe.cpp b/metal/multiscale_batch_probe.cpp
new file mode 100644
index 00000000..97744dcd
--- /dev/null
+++ b/metal/multiscale_batch_probe.cpp
@@ -0,0 +1,44 @@
+// Test real production scale kernels and one-call batch routing against CPU.
+#include "algorithms/multiscale/multiscale_transforms.h"
+#include <schaapcommon/math/convolution.h>
+#include <cmath>
+#include <cstdio>
+#include <complex>
+#include <vector>
+#include <random>
+extern "C" int mx_convolve_many(float* const*,const std::complex<float>*,const std::complex<float>* const*,size_t,size_t,size_t);
+static size_t calls=0;
+static int counted(float* const* dst,const std::complex<float>* image,const std::complex<float>* const* kernels,size_t w,size_t h,size_t b){++calls;return mx_convolve_many(dst,image,kernels,w,h,b);}
+template<class T> int test(size_t w,size_t h,radler::MultiscaleShape shape){
+  if constexpr(!requires(T& t,const std::complex<float>* p,const aocommon::UVector<float>& s,std::vector<aocommon::Image>& images){t.TryTransformScales(p,s,images);}){
+    std::fprintf(stderr,"FAIL: production multiscale batch routing absent\n");return 1;
+  } else {
+    T transforms(w,h,shape);
+    aocommon::Image image(w,h); std::mt19937 rng(119);
+    for(float& v:image)v=float(int(rng()%2001)-1000)/1000;
+    aocommon::UVector<float> scales{0,3,6,12,24,32,40,48};
+    std::vector<std::complex<float>> spec(schaapcommon::math::ConvolutionFftSize(w,h));
+    schaapcommon::math::ConvolutionFft(spec.data(),image.Data(),w,h);
+    const auto saved=spec;
+    T::SetBatchTransformHook(nullptr);
+    std::vector<aocommon::Image> result;
+    if(transforms.TryTransformScales(spec.data(),scales,result))return 2;
+    std::vector<aocommon::Image> reference;
+    for(float scale:scales){reference.emplace_back(w,h);transforms.Transform(spec.data(),reference.back(),scale);}
+    T::SetBatchTransformHook(&counted);const size_t before=calls;
+    if(!transforms.TryTransformScales(spec.data(),scales,result)||calls!=before+1||result.size()!=scales.size())return 3;
+    for(size_t b=0;b<scales.size();++b){double num=0,den=0,mx=0,md=0;
+      for(size_t i=0;i<w*h;++i){double r=reference[b][i],d=result[b][i]-r;num+=d*d;den+=r*r;mx=std::max(mx,std::abs(r));md=std::max(md,std::abs(d));}
+      double rel=std::sqrt(num/den);std::printf("scale=%g shape=%d %zux%zu rel=%.3g max/peak=%.3g\n",scales[b],int(shape),w,h,rel,md/mx);
+      if(!std::isfinite(rel)||rel>5e-6||md/mx>1e-4)return 4;
+    }
+    T::SetBatchTransformHook(nullptr);
+    if(saved!=spec)return 5;
+    return 0;
+  }
+}
+int main(){using T=radler::algorithms::multiscale::MultiScaleTransforms;int result=0;
+ for(auto shape:{radler::MultiscaleShape::kTaperedQuadraticShape,radler::MultiscaleShape::kGaussianShape}){
+ result|=test<T>(128,128,shape);result|=test<T>(128,96,shape);}
+ std::printf("multiscale batch %s calls=%zu\n",result?"FAIL":"PASS",calls);return result;
+}
