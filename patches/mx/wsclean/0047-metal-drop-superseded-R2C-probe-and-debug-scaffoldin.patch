-// CPU-only: half-spectrum -> full via Hermitian symmetry, then c2c inverse,
-// must equal ducc0 c2r. Validates the expansion before any GPU is involved.
-#include <complex>
-#include <cstdio>
-#include <cmath>
-#include <vector>
-#include <random>
-#include "ducc0/fft/fft.h"
-#include "ducc0/fft/fftnd_impl.h"
-#include "ducc0/infra/mav.h"
-int main() {
-  const size_t w=32,h=32,cw=w/2+1;
-  std::mt19937 rng(7);
-  std::vector<std::complex<float>> half(h*cw);
-  for (auto& v: half) v={float(rng()%1000)/1000-0.5f, float(rng()%1000)/1000-0.5f};
-  // enforce Hermitian consistency as a true r2c output would have?
-  // (skip - use as-is; c2r of inconsistent half is still well-defined)
-  std::vector<std::complex<float>> hm=half;
-  std::vector<float> ref(h*w,0);
-  { ducc0::vfmav<std::complex<float>> in(hm.data(),{h,cw});
-    ducc0::vfmav<float> out(ref.data(),{h,w});
-    ducc0::c2r_mut(in,out,{0,1},false,1.0f,1); }
-  // expand to full
-  std::vector<std::complex<float>> full(h*w);
-  for(size_t i=0;i<h;i++) for(size_t j=0;j<w;j++) {
-    if(j<cw) full[i*w+j]=half[i*cw+j];
-    else {
-      size_t si=(h-i)%h, sj=w-j;
-      full[i*w+j]=std::conj(half[si*cw+sj]);
-    }
-  }
-  std::vector<std::complex<float>> fm=full;
-  { ducc0::vfmav<std::complex<float>> io(fm.data(),{h,w});
-    ducc0::detail_fft::c2c(io,io,{0},false,1.0f,1);
-    ducc0::detail_fft::c2c(io,io,{1},false,1.0f,1); }
-  // c2c inverse of full should give real=ref*w? or ref? check scale
-  double num=0,den=0;
-  // try both scales: /1 and /w? Actually c2c unnormalized vs c2r unnormalized may differ by factor
-  // first compare shapes: imag should be ~0
-  double imax=0;
-  for(auto& v: fm) imax=std::max(imax,(double)std::abs(v.imag()));
-  printf("max imag after c2c: %.4g\n", imax);
-  // find best scale
-  for(float s : {1.0f, 1.0f/(w*h)}) {
-    num=0;den=0;
-    for(size_t i=0;i<h*w;i++){ double a=fm[i].real()*s, b=ref[i]; num+=(a-b)*(a-b); den+=b*b; }
-    printf("scale %.4g rel=%.4e\n", s, sqrt(num/(den+1e-30)));
-  }
-  return 0;
-}
