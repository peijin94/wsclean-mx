+		}
+		case 1: case 111: case 121: case 131: case 141: case 143: case 145:
+		{
+			if (sc->fftDim == sc->fft_dim_full) {
+				sc->tempLen = sprintf(sc->tempStr, "		%s = %s + %" PRIu64 ";\n", sc->inoutID, sc->gl_LocalInvocationID_y, i * sc->localSize[1]);
