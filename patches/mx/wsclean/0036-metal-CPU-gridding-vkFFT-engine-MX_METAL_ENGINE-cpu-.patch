+			for (uint64_t j = 2; j < app->configuration.fixMinRaderPrimeMult; j++) {
+				if (tempSequence2 % j == 0) {
+					tempSequence2 /= j;
+					j--;
+				}
+			}
+			if (tempSequence2 != 1) {
+				tempSequence_temp *= i;
+				tempSequence[0] /= i;
+				i--;
+				continue;
+			}
+			tempSequence[0] /= i;
