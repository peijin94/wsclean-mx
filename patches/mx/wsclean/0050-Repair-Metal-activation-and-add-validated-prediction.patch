diff --git a/metal/vkfft_real_probe.cpp b/metal/vkfft_real_probe.cpp
new file mode 100644
index 00000000..e97bedb0
--- /dev/null
+++ b/metal/vkfft_real_probe.cpp
@@ -0,0 +1,89 @@
+// Regression for native, padded in-place real FFTs (no Hermitian expansion).
+#include "metal/mxvkfft.h"
+#include "ducc0/fft/fft.h"
+#include "ducc0/fft/fftnd_impl.h"
+#include <algorithm>
+#include <chrono>
+#include <cmath>
+#include <complex>
+#include <cstdio>
+#include <cstring>
+#include <random>
+#include <vector>
+
+template<class F> int test(size_t w, size_t h, size_t batch) {
+  if constexpr (!requires(F f, const float* x, const float* const* k) { f.initReal(w,h,batch); f.submitConvolution(x,k); }) {
+    std::fprintf(stderr,"FAIL: native real FFT API missing\n"); return 1;
+  } else {
+    F fft;
+    if (!fft.initReal(w,h,batch)) { std::fprintf(stderr,"FAIL init: %s\n",fft.error()); return 1; }
+    const size_t cw=w/2+1, pitch=2*cw, np=w*h, nc=h*cw;
+    std::vector<float> image(np*batch);
+    std::vector<std::complex<float>> spectrum(nc*batch);
+    std::mt19937 rng(41);
+    for(auto& v:image) v=float(int(rng()%2001)-1000)/1000;
+    for(size_t b=0;b<batch;++b) {
+      ducc0::cfmav<float> in(image.data()+b*np,{h,w});
+      ducc0::vfmav<std::complex<float>> out(spectrum.data()+b*nc,{h,cw});
+      ducc0::r2c(in,out,{0,1},true,1.f,8);
+      for(size_t y=0;y<h;++y) std::memcpy(fft.data()+(b*h+y)*pitch,image.data()+b*np+y*w,w*sizeof(float));
+    }
+    if(!fft.submitForward() || !fft.wait()) return 2;
+    double den=0,num=0;
+    auto* z=reinterpret_cast<std::complex<float>*>(fft.data());
+    for(size_t i=0;i<spectrum.size();++i){num+=std::norm(z[i]-spectrum[i]);den+=std::norm(spectrum[i]);}
+    double fwd=std::sqrt(num/den);
+    std::vector<double> times;
+    double inv=0;
+    for(int rep=0;rep<4;++rep) {
+      std::memcpy(fft.data(),spectrum.data(),spectrum.size()*sizeof(std::complex<float>));
+      const auto t=std::chrono::steady_clock::now();
+      if(!fft.submit() || !fft.wait()) return 2;
+      times.push_back(std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-t).count());
+      den=num=0;
+      for(size_t b=0;b<batch;++b) for(size_t y=0;y<h;++y) for(size_t x=0;x<w;++x){
+        const double r=image[b*np+y*w+x], d=fft.data()[(b*h+y)*pitch+x]/double(np)-r;
+        num+=d*d;den+=r*r;
+      }
+      inv=std::sqrt(num/den);
+    }
+    std::sort(times.begin()+1,times.end());
+    // One image spectrum with independent kernels per scale; compare production
+    // multiply+C2R operation, not only an FFT round trip.
+    std::vector<const float*> kernels;
+    std::vector<float> conv_ref(np*batch);
+    for(size_t b=0;b<batch;++b){
+      kernels.push_back(reinterpret_cast<const float*>(spectrum.data()+b*nc));
+      std::vector<std::complex<float>> product(nc);
+      const float factor=1.0/double(np);
+      for(size_t i=0;i<nc;++i) product[i]=spectrum[i]*(factor*spectrum[b*nc+i]);
+      ducc0::vfmav<std::complex<float>> in(product.data(),{h,cw});
+      ducc0::vfmav<float> out(conv_ref.data()+b*np,{h,w});
+      ducc0::c2r_mut(in,out,{0,1},false,1.f,8);
+    }
+    const auto saved=spectrum;
+    const auto begin=std::chrono::steady_clock::now();
+    if(!fft.submitConvolution(reinterpret_cast<const float*>(spectrum.data()),kernels.data())||!fft.wait()){
+      std::fprintf(stderr,"FAIL convolution: %s\n",fft.error());return 3;
+    }
+    double convolution_ms=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-begin).count();
+    den=num=0;double maxref=0,maxdiff=0;
+    for(size_t b=0;b<batch;++b)for(size_t y=0;y<h;++y)for(size_t x=0;x<w;++x){
+      double r=conv_ref[b*np+y*w+x],d=fft.data()[(b*h+y)*pitch+x]-r;
+      num+=d*d;den+=r*r;maxref=std::max(maxref,std::abs(r));maxdiff=std::max(maxdiff,std::abs(d));
+    }
+    const double conv=std::sqrt(num/den);
+    bool ok=std::isfinite(fwd)&&std::isfinite(inv)&&fwd<5e-6&&inv<5e-6&&conv<5e-6&&maxdiff/maxref<1e-4&&saved==spectrum;
+    std::printf("convolution rel=%.3g peak_norm=%.3g cold_wall_ms=%.3f\n",conv,maxdiff/maxref,convolution_ms);
+    std::printf("real w=%zu h=%zu batch=%zu forward_rel=%.3g inverse_rel=%.3g warm_ms=%.3f %s\n",w,h,batch,fwd,inv,times[2],ok?"PASS":"FAIL");
+    return ok?0:1;
+  }
+}
+int main(int argc,char**argv){
+  setvbuf(stdout,nullptr,_IONBF,0);
+  if(argc>1){size_t w=std::stoul(argv[1]),h=argc>2?std::stoul(argv[2]):w,b=argc>3?std::stoul(argv[3]):1;return test<mx::vk::Fft>(w,h,b);}
+  int rc=0;
+  for(size_t b:{1,2,8}) { rc|=test<mx::vk::Fft>(32,24,b); rc|=test<mx::vk::Fft>(64,64,b); }
+  for(int i=0;i<8;++i) rc|=test<mx::vk::Fft>(128,96,1); // create, execute, destroy repeatedly
+  return rc;
+}
